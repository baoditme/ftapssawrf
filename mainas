-- Áp method lên 1 người (không dùng Blobman)
function ApplyTargetMethods(p, methods)
    if not p or not p.Character then return end
    local char = localPlayer.Character
    local _, hrp, hum = GetHRH(char)
    local head = p.Character:FindFirstChild("Head")
    local tHum = p.Character:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0 and head and tHum and tHum.Health > 0) then return end
    if p:FindFirstChild("InPlot") and p.InPlot.Value then return end

    local origCF = hrp.CFrame
    local startTick, owned = tick(), nil
    while true do
        task.wait()
        Teleport(hrp, head.CFrame, CFrame.new(0, -1.5, 1.5))
        owned = Ownerboat(head)
        if owned or tick() - startTick > 1 or not head.Parent or tHum.Health <= 0 then break end
    end
    if owned then
        if methods.Bring then
            Teleport(head, origCF, CFrame.new(0, 0, 0))
        end
        if methods.Void then
    head.Velocity = Vector3.new(0, -100000000, 0)
    state.session.track_void()
end
if methods.Kill then
    pcall(function() tHum:ChangeState(Enum.HumanoidStateType.Dead) end)
    state.session.track_kill()
end
        UnGrab(head)
    end
    if hrp.Parent then Teleport(hrp, origCF, CFrame.new(0, 0, 0)) end
end

-- Áp method Blobman lên 1 người (cần đang ngồi Blobman)
function ApplyBlobMethod(p, method)
    if not p or not p.Character then return end
    local char = localPlayer.Character
    local _, hrp, hum = GetHRH(char)
    local _, tHrp, tHum = GetHRH(p.Character)
    if not (hrp and hum and hum.Health > 0 and tHrp and tHum and tHum.Health > 0) then return end
    local seat = hum.SeatPart
    if not (seat and seat.Parent) then return end
    local blob = seat.Parent
    local scr = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
    local leftDet = blob:FindFirstChild("LeftDetector")
    if not (scr and leftDet) then return end
    local cg = scr:FindFirstChild("CreatureGrab")
    local cr = scr:FindFirstChild("CreatureRelease")
    local lw = leftDet:FindFirstChild("LeftWeld")
    if not (cg and cr and lw) then return end

    local origCF = hrp.CFrame
    local startTick = tick()
    while true do
        task.wait(0.01)
        Teleport(hrp, tHrp.CFrame, CFrame.new(0, 7, 3))
        cg:FireServer(leftDet, tHrp, lw)
        if not hum.SeatPart or not tHrp.Parent or tHum.Health <= 0
            or (lw.Attachment0 and lw.Attachment0.Parent == tHrp) or tick() - startTick > 1 then break end
    end
    if hum.SeatPart and lw.Attachment0 and lw.Attachment0.Parent == tHrp then
        if method == "Bring" then
            cr:FireServer(lw)
            local bp = Instance.new("BodyPosition")
            bp.Position = origCF.Position
            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bp.D = 100
            bp.Parent = tHrp
            task.delay(0.25, function() if bp then bp:Destroy() end end)
        elseif method == "Kill" then
    cr:FireServer(lw)
    pcall(function() tHum:ChangeState(Enum.HumanoidStateType.Dead) end)
    state.session.track_kill()
end
        -- "Lock": không release, giữ nguyên người đó trên tay Blobman
    end
    if method ~= "Lock" and hrp.Parent then Teleport(hrp, origCF, CFrame.new(0, 0, 0)) end
end

