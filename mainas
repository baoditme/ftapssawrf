-- MODULE 11: AUTO SPIN SLOTS
-- ==========================================
do
    state.spinRunning = false
    state.spinCPS = 1

    function getTimeText()
        local slots = workspace_:FindFirstChild("Slots")
        if not slots then return "0:00", nil end
        for _, d in ipairs(slots:GetDescendants()) do
            if d:IsA("TextLabel") and d.Name == "TimeText" then
                return d.Text or "0:00", d
            end
        end
        return "0:00", nil
    end

    function findSlots()
        local out = {}
        local slots = workspace_:FindFirstChild("Slots")
        if not slots then return out end
        local children = slots:GetChildren()
        local tbl = {
            slots:FindFirstChild("Slots"),
            children[2], children[3], children[4], children[5],
            children[1], children[6]
        }
        local seen = {}
        for _, v in ipairs(tbl) do
            if v and not seen[v] then
                seen[v] = true
                local handle = v:FindFirstChild("SlotHandle") or v:FindFirstChild("Handle")
                if not handle and v:IsA("BasePart") then handle = v end
                local timeText = nil
                for _, d in ipairs(v:GetDescendants()) do
                    if d:IsA("TextLabel") and d.Name == "TimeText" then timeText = d break end
                end
                table.insert(out, {model = v, handle = handle, timeText = timeText})
            end
        end
        return out
    end

    function fireOwner(slot, cf)
        if not slot.handle then return end
        if setNetworkOwner then
            pcall(function() setNetworkOwner:FireServer(slot.handle, cf) end)
            if slot.model ~= slot.handle and slot.model:IsA("BasePart") then
                pcall(function() setNetworkOwner:FireServer(slot.model, cf) end)
            end
        end
    end

    task.spawn(function()
        local idx = 1
        while gui.Parent do
            task.wait(math.max(1 / state.spinCPS, 0.05))
            if state.spinRunning then
                local list = findSlots()
                if #list == 0 then task.wait(1) continue end
                if idx > #list then idx = 1 end
                local slot = list[idx]
                local cf = slot.handle and slot.handle.CFrame
                if not cf then idx = idx + 1 continue end
                local timeTxt = getTimeText()
                if timeTxt and timeTxt ~= "0:00" and timeTxt ~= "" then continue end

                local char = localPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then continue end
                local origCF = hrp.CFrame

                if _G._NileDesync and _G._NileDesync.IsAvailable(_G._NileDesync) then
                    _G._NileDesync.RequestDesync(_G._NileDesync, function() return cf end, 3)
                    task.wait(0.4)
                    pcall(fireOwner, slot, cf)
                    task.wait(0.6)
                    _G._NileDesync.CancelRequest(_G._NileDesync)
                else
                    hrp.CFrame = cf
                    task.wait(0.4)
                    pcall(fireOwner, slot, cf)
                    task.wait(0.6)
                    if hrp.Parent then
                        hrp.CFrame = origCF
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                end

                local ok = false
                for i=1,8 do
                    task.wait(0.25)
                    local t = getTimeText()
                    if t and t ~= "0:00" and t ~= "" then ok = true break end
                end
                if ok then
                    Notify("Spin Slots", "Slot #" .. idx .. " spun", "success", 2)
                    while state.spinRunning do
                        local t = getTimeText()
                        if not t or t == "0:00" or t == "" then break end
                        task.wait(1)
                    end
                else
                    idx = idx + 1
                    if idx > #list then
                        idx = 1
                        state.spinRunning = false
                        Notify("Spin Slots", "All slots broken - stopped", "warning", 3)
                    end
                end
            end
        end
    end)

    makeSection(serverTab, "Auto Spin Slots")
    makeToggle(serverTab, "Auto Spin Slots", false, function(on) state.spinRunning = on end)
    makeSlider(serverTab, "Spin Attempts / Sec", 1, 1, 5, function(v) state.spinCPS = v end)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 24)
    lbl.BackgroundColor3 = BG3
    lbl.TextColor3 = TEXT
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.Text = "Cooldown: --:--"
    lbl.Parent = serverTab
    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 6)
    task.spawn(function()
        while gui.Parent do
            task.wait(1)
            local t = getTimeText()
            pcall(function() lbl.Text = "Cooldown: " .. (t or "--:--") end)
        end
    end)
end

