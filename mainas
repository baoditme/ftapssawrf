-- Resolve correct toy container whether player is in plot or normal world[cite: 5, 8]
local function getToyContainer()
    local ip = LocalPlayer:FindFirstChild("InPlot")
    if ip and ip.Value then
        local plotItems = Workspace:FindFirstChild("PlotItems")
        local plots = Workspace:FindFirstChild("Plots")
        if plots and plotItems then
            for i = 1, 5 do
                local p = plots:FindFirstChild("Plot" .. i)
                local sign = p and p:FindFirstChild("PlotSign")
                local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
                if owners then
                    for _, v in ipairs(owners:GetChildren()) do
                        if v:IsA("StringValue") and v.Value == LocalPlayer.Name then
                            local pi = plotItems:FindFirstChild("Plot" .. i)
                            if pi then return pi end
                        end
                    end
                end
            end
        end
    end
    return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
end

-- Safe toy destroyer helper
local function destroyToyInstance(toy)
    if toy and destroyToyRemote then
        pcall(function() destroyToyRemote:FireServer(toy) end)
    end
end

-- Robust shuriken spawner with plot support and non-blocking wait
local function SpawnShuriken(name)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local canSpawn = LocalPlayer:FindFirstChild("CanSpawnToy")
    local inPlot = LocalPlayer:FindFirstChild("InPlot")

    -- Wait until game allows spawning (handles cooldowns properly)[cite: 8]
    local waitStart = tick()
    while canSpawn and not canSpawn.Value do
        if tick() - waitStart > 3 then return nil end
        task.wait(0.05)
    end

    local container = getToyContainer()
    if not container then return nil end

    -- Fire server to create shuriken[cite: 1, 8]
    pcall(function()
        spawnToyRemote:InvokeServer("NinjaShuriken", hrp.CFrame * CFrame.new(0, 15, 20), Vector3.zero)
    end)

    local toy = container:WaitForChild("NinjaShuriken", 2.5)
    if not toy then
        local fallback = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if fallback and fallback ~= container then
            toy = fallback:FindFirstChild("NinjaShuriken")
        end
    end
    if not toy then return nil end

    local soundPart = toy:WaitForChild("SoundPart", 1.5)
    if not soundPart then
        destroyToyInstance(toy)
        return nil
    end

    -- Acquire network ownership[cite: 1, 8]
    local t0 = tick()
    while tick() - t0 < 2 do
        pcall(function() setNetOwner:FireServer(soundPart, soundPart.CFrame) end)
        local po = soundPart:FindFirstChild("PartOwner")
        if po and po.Value == LocalPlayer.Name then break end
        RunService.RenderStepped:Wait()
    end

    local po = soundPart:FindFirstChild("PartOwner")
    if not (po and po.Value == LocalPlayer.Name) then
        destroyToyInstance(toy)
        return nil
    end

    -- Keep part floating to prevent floor collisions[cite: 1, 8]
    if not soundPart:FindFirstChild("BodyPosition") then
        local bp = Instance.new("BodyPosition")
        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bp.D = 100
        bp.Position = Vector3.new(math.random(-100000, 100000), 100000, math.random(-100000, 100000))
        bp.Parent = soundPart
    end

    toy.Name = name
    return toy
end

