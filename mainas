local function refreshWLList()
    local opts = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(opts, p.DisplayName .. " (@" .. p.Name .. ")")
        end
    end
    if wlDropdown and wlDropdown.Refresh then wlDropdown:Refresh(opts) end
end
refreshWLList()
Players.PlayerAdded:Connect(function() task.wait(0.5) refreshWLList() end)
Players.PlayerRemoving:Connect(function() task.wait(0.5) refreshWLList() end)

SettingsTab:CreateButton({
    Name = "Add Selected",
    Callback = function()
        if not wlTarget then return end
        local name = wlTarget:match("@([%w_]+)%)") or wlTarget
        local p = Players:FindFirstChild(name)
        if p then
            state.whitelist[p.UserId] = true
            saveConfig()
            Notify("Whitelist", "Added " .. p.Name, "success")
        end
    end,
})

SettingsTab:CreateButton({
    Name = "Clear Whitelist",
    Callback = function()
        state.whitelist = {}
        saveConfig()
        Notify("Whitelist", "Cleared", "info")
    end,
})

SettingsTab:CreateSection("HUD")

SettingsTab:CreateToggle({
    Name = "Show Player List",
    Default = state.hudVisible.playerList ~= false,
    Callback = function(on)
        state.hudVisible.playerList = on
        saveConfig()
        if _G.FTAP_PLAYERLIST_VISIBILITY then _G.FTAP_PLAYERLIST_VISIBILITY(on) end
    end,
})

SettingsTab:CreateButton({
    Name = "Reset Session Stats",
    Callback = function()
        state.session.start = tick()
        state.session.kills = 0
        state.session.voids = 0
        state.session.steals = 0
        state.session.breaks = 0
        state.session.deaths = 0
        Notify("Session", "Stats reset", "info")
    end,
})

