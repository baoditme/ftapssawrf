-- Run auto download/load (respect saved theme name)
pcall(function()
    -- If user saved a theme name, use that preset
    local savedTheme = state.themeName
    if not savedTheme and readfile and isfile and isfile("BHUB_Config/bhub_ftap_state.json") then
        local HS = game:GetService("HttpService")
        local ok, decoded = pcall(function() return HS:JSONDecode(readfile("BHUB_Config/bhub_ftap_state.json")) end)
        if ok and decoded and type(decoded.themeName) == "string" then
            savedTheme = decoded.themeName
        end
    end

    if savedTheme and _getPresetByName(savedTheme) then
        local ok = applyThemePreset(savedTheme)
        print("[BHUB] Loaded saved theme:", savedTheme, ok and "OK" or "FAIL")
    else
        -- Fallback to default bg
        local bgName = _G.NileBgName or DEFAULT_BG_NAME
        local bgLink = _G.NileBgLink or DEFAULT_BG_LINK
        local cached = _loadBgFromCache(bgName)
        if cached then
            _G.NileBgUrl = cached
            print("[BHUB] Using cached background:", bgName)
            return
        end
        print("[BHUB] No cache, downloading:", bgName)
        local url, path = _downloadDriveImage(bgLink, bgName)
        if url then
            _G.NileBgUrl = url
            print("[BHUB] Background ready:", path)
        else
            print("[BHUB] Download failed:", path)
        end
    end
end)
