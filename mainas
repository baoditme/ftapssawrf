function abBestTarget()
        local cam = workspace.CurrentCamera
    local mouse = cam.ViewportSize / 2
    local myChar = localPlayer.Character
    local best, bestD = nil, math.huge
        if state.marked and state.marked.Character and not (state.isWL and state.isWL(state.marked)) then
        local mh = state.marked.Character:FindFirstChildOfClass("Humanoid")
        local mp = abPart(state.marked.Character)
        if mp and mh and mh.Health > 0 then return mp end
    end
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= localPlayer and p.Character and not (state.isWL and state.isWL(p)) then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local part = abPart(p.Character)
            if part and hum and hum.Health > 0 then
                local sp, vis = cam:WorldToViewportPoint(part.Position)
                if vis then
                    local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
                    local inFov = (not state.ab.useFOV) or d <= (state.aimAssistFOV or 150)
                    if inFov and d < bestD then
                        local clear = true
                        if state.ab.wallCheck then
                            local rp = RaycastParams.new()
                            rp.FilterType = Enum.RaycastFilterType.Exclude
                            rp.FilterDescendantsInstances = {myChar}
                            local hit = workspace_:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, rp)
                            if hit and not hit.Instance:IsDescendantOf(p.Character) then clear = false end
                        end
                        if clear then bestD, best = d, part end
                    end
                end
            end
        end
    end
    return best
end

