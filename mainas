    -- ==========================================
    state.grabModes = {}
    state.grabStrengthPower = 5
    state.grabSpinSpeed = 5

    function _getGrabbedPart()
        local gp = workspace_:FindFirstChild("GrabParts")
        if not gp then return nil end
        local grabPart = gp:FindFirstChild("GrabPart")
        if not grabPart then return nil end
        for _, c in ipairs(grabPart:GetChildren()) do
            if c:IsA("WeldConstraint") and c.Part1 and c.Part1:IsA("BasePart") then
                return c.Part1
            end
        end
        return nil
    end

    -- ⭐ NEW HANDLERS from PoopHub/Resonance
    local function _getGrabPartModel(gp)
        local grabPart = gp and gp:FindFirstChild("GrabPart")
        local weld = grabPart and grabPart:FindFirstChild("WeldConstraint")
        return grabPart, weld, weld and weld.Part1
    end

    local function handleSkyGrab(gp)
        local _, _, target = _getGrabPartModel(gp)
        if not target then return end
        local bv = Instance.new("BodyVelocity")
        bv.Velocity = Vector3.new(0, 100, 0)
        bv.MaxForce = Vector3.new(0, math.huge, 0)
        bv.Name = "_RYZE_SkyGrab"
        bv.Parent = target
        Debris:AddItem(bv, 0.5)
    end

    local function handleTeleportGrab(gp, dir)
        local grabPart = gp and gp:FindFirstChild("GrabPart")
        if not grabPart then return end
        local dist = state.tpGrabDist or 30
        grabPart.Position = grabPart.Position + Vector3.new(0, dir == "up" and dist or -dist, 0)
    end

    local function handleChaosGrab(gp, isActive)
        local grabPart = gp and gp:FindFirstChild("GrabPart")
        if not grabPart then return end
        local bp = Instance.new("BodyPosition")
        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bp.P = 50000
        bp.D = 1000
        bp.Name = "_RYZE_ChaosBP"
        bp.Parent = grabPart
        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 50000
        bg.D = 1000
        bg.Name = "_RYZE_ChaosBG"
        bg.Parent = grabPart
        task.spawn(function()
            while isActive() and gp.Parent and grabPart.Parent do
                pcall(function()
                    local r = state.chaosRange or 50
                    bp.Position = grabPart.Position + Vector3.new(math.random(-r, r), math.random(-r, r), math.random(-r, r))
                    if state.chaosSpin then
                        bg.CFrame = CFrame.Angles(
                            math.rad(math.random(-180, 180)),
                            math.rad(math.random(-180, 180)),
                            math.rad(math.random(-180, 180))
                        )
                    end
                end)
                task.wait(0.1)
            end
            pcall(function() bp:Destroy() end)
            pcall(function() bg:Destroy() end)
        end)
    end

    local function handleSupersonicGrab(gp)
        local _, _, target = _getGrabPartModel(gp)
        if not target then return end
        local force = state.supersonicForce or 350
        local bv = Instance.new("BodyVelocity")
        bv.Velocity = Vector3.new(0, force, 0)
        bv.MaxForce = Vector3.new(0, math.huge, 0)
        bv.Name = "_RYZE_SupersonicGrab"
        bv.Parent = target
        Debris:AddItem(bv, 0.5)
    end

    local function handleFreezeGrab(gp)
        local grabPart = gp and gp:FindFirstChild("GrabPart")
        if not grabPart then return end
        local bp = Instance.new("BodyPosition")
        bp.Position = grabPart.Position + Vector3.new(0, state.freezeDist or 0, 0)
        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bp.P = 50000
        bp.D = 1000
        bp.Name = "_RYZE_FreezeBP"
        bp.Parent = grabPart
        Debris:AddItem(bp, 30)
    end

    -- ==========================================
    -- GRAB HANDLER (mở rộng từ bản gốc)
    -- ==========================================
    workspace_.ChildAdded:Connect(function(child)
        if child.Name ~= "GrabParts" then return end
        task.wait(0.05)
        local part = _getGrabbedPart()
        if not part then return end
        local modes = state.grabModes
        if not next(modes) then return end

        local model = part.Parent
        local grabbedPlayer = model and players:GetPlayerFromCharacter(model)
        local grabbedChar = grabbedPlayer and grabbedPlayer.Character
        local grabbedHRP = grabbedChar and grabbedChar:FindFirstChild("HumanoidRootPart")
        local grabbedHum = grabbedChar and grabbedChar:FindFirstChildOfClass("Humanoid")

        -- Super Strength: RMB (PC) + Touch (Mobile) to throw


        -- ⭐ NEW: Sky Grab (BodyVelocity up)
        if modes["Sky Grab"] then
            handleSkyGrab(child)
        end

        -- ⭐ NEW: Teleport Up
        if modes["Teleport Up"] then
            handleTeleportGrab(child, "up")
        end

        -- ⭐ NEW: Teleport Down
        if modes["Teleport Down"] then
            handleTeleportGrab(child, "down")
        end

        -- ⭐ NEW: Chaos Grab
        if modes["Chaos Grab"] then
            handleChaosGrab(child, function() return state.grabModes["Chaos Grab"] end)
        end

        -- ⭐ NEW: Supersonic Grab
        if modes["Supersonic Grab"] then
            handleSupersonicGrab(child)
        end

        -- ⭐ NEW: Freeze Grab
        if modes["Freeze Grab"] then
            handleFreezeGrab(child)
        end

        if modes["Massless"] then
            task.spawn(function()
                while _grabIsActive(part) do
                    pcall(function()
                        for _, d in ipairs(child:GetDescendants()) do
                            if d:IsA("BasePart") then
                                d.Massless = true
                                d.CanCollide = false
                                d.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                            end
                        end
                    end)
                    task.wait(0.1)
                end
            end)
        end

        if modes["Spin"] then
            task.spawn(function()
                local spinSpeed = 10 + (state.grabSpinSpeed - 1) * 30
                local bav = Instance.new("BodyAngularVelocity")
                bav.AngularVelocity = Vector3.new(0, spinSpeed, 0)
                bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bav.Parent = part
                while _grabIsActive(part) do
                    pcall(function() bav.AngularVelocity = Vector3.new(0, spinSpeed, 0) end)
                    task.wait()
                end
                if bav and bav.Parent then bav:Destroy() end
            end)
        end

        if modes["Noclip"] then
            task.spawn(function()
                while _grabIsActive(part) do
                    pcall(function()
                        for _, d in ipairs(child:GetDescendants()) do
                            if d:IsA("BasePart") then d.CanCollide = false end
                        end
                    end)
                    task.wait(0.05)
                end
            end)
        end

        if modes["Invisible"] then
            task.spawn(function()
                while _grabIsActive(part) do
                    local gp = workspace_:FindFirstChild("GrabParts")
                    if gp then
                        for _, d in ipairs(gp:GetDescendants()) do
                            if d:IsA("Beam") then d.Enabled = false end
                        end
                    end
                    task.wait(0.05)
                end
            end)
        end

        if modes["Free"] then
            task.spawn(function()
                while _grabIsActive(part) do
                    local gp = workspace_:FindFirstChild("GrabParts")
                    if gp then
                        local dp = gp:FindFirstChild("DragPart")
                        if dp then
                            local ao = dp:FindFirstChildOfClass("AlignOrientation")
                            if ao then ao.MaxTorque = 0 end
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end

        if grabbedPlayer then
            if modes["Kill Grab"] and grabbedHum and grabbedHum.Health > 0 then
                task.spawn(function()
                    pcall(function()
                        grabbedHum.BreakJointsOnDeath = false
                        grabbedHum:ChangeState(Enum.HumanoidStateType.Dead)
                        state.session.track_kill()
                    end)
                    _release(part)
                    if grabbedHRP then _skyVelocity(grabbedHRP) end
                end)
            end

            if modes["Void Grab"] and grabbedHRP then
                task.spawn(function()
                state.session.track_void()
                    _release(part)
                    _skyVelocity(grabbedHRP)
                end)
            end

            if modes["Teleport to Spawn"] and grabbedHRP then
                task.spawn(function()
                    local spawn = workspace_:FindFirstChildOfClass("SpawnLocation")
                    if spawn then
                        pcall(function()
                            grabbedHRP.CFrame = spawn.CFrame + Vector3.new(0, 3, 0)
                            grabbedHRP.AssemblyLinearVelocity = Vector3.zero
                        end)
                        _release(part)
                    end
                end)
            end

            if modes["Ragdoll Grab"] and grabbedHRP and ragdollRemote then
                task.spawn(function()
                    while _grabIsActive(part) do
                        pcall(function() ragdollRemote:FireServer(grabbedHRP, 15) end)
                        task.wait(0.1)
                    end
                end)
            end

            if modes["Unstick"] then
                task.spawn(function()
                    local seen = {}
                    while _grabIsActive(part) do
                        for _, d in ipairs(grabbedChar:GetDescendants()) do
                            if d:IsA("BasePart") then
                                for _, cp in ipairs(d:GetConnectedParts()) do
                                    if cp and not cp:IsDescendantOf(grabbedChar) then
                                        local sp = cp.Name == "StickyPart" and cp or cp:FindFirstChild("StickyPart", true)
                                        if sp and sp:IsA("BasePart") and not seen[sp] then
                                            seen[sp] = true
                                            pcall(function() setNetworkOwner:FireServer(sp, sp.CFrame) end)
                                        end
                                    end
                                end
                            end
                        end
                        task.wait(0.3)
                    end
                end)
            end
        end
    end)

    makeSection(auraTab, "Grab Modes")
    -- ==========================================
-- ⭐ INFINITY EXTEND (PORTED 100% từ PoopHub/Resonance)
-- Thực sự kéo dài reach bằng BodyPosition trên GrabPart
-- Scroll wheel (PC) / Buttons (Mobile) để tăng giảm khoảng cách
-- ==========================================
do
    local infExtendActive = state.infinityExtendOn or false
    local infExtendConn = nil
    local infExtendScrollConn = nil
    local currentDistance = state.infinityExtendDist or 12
    local camera = workspace.CurrentCamera
    local activeGrabParts = nil

    local function applyInfExtend(gp)
        if not gp or not gp.Parent then return end
        local grabPart = gp:WaitForChild("GrabPart", 2)
        local dragPart = gp:WaitForChild("DragPart", 2)
        if not grabPart or not dragPart then return end
        local weld = grabPart:WaitForChild("WeldConstraint", 2)
        if not weld or not weld.Part1 then return end

        -- Xóa BP cũ nếu có
        local oldBP = grabPart:FindFirstChild("_RYZE_InfExtendBP")
        if oldBP then oldBP:Destroy() end

        local bp = Instance.new("BodyPosition")
        bp.Name = "_RYZE_InfExtendBP"
        bp.MaxForce = Vector3.new(275000, 275000, 275000)
        bp.P = 20000
        bp.D = 950
        bp.Position = weld.Part1.Position
        bp.Parent = grabPart

        if currentDistance < 11 then currentDistance = 11 end
        local baseDist = (grabPart.Position - camera.CFrame.Position).Magnitude
        if baseDist > currentDistance then currentDistance = baseDist end

        -- Disable AlignPosition trên DragPart để BP điều khiển tự do
        local alignPos = dragPart:FindFirstChildOfClass("AlignPosition")
        if alignPos then alignPos.Enabled = false end

        task.spawn(function()
            while infExtendActive and gp.Parent and grabPart.Parent and bp.Parent do
                pcall(function()
                    bp.Position = camera.CFrame.Position + camera.CFrame.LookVector * currentDistance
                end)
                task.wait()
            end
            pcall(function() bp:Destroy() end)
        end)
    end

    local function setupScrollWheel()
        if infExtendScrollConn then infExtendScrollConn:Disconnect() infExtendScrollConn = nil end
        infExtendScrollConn = userInputService.InputChanged:Connect(function(input)
            if not infExtendActive then return end
            if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
            if currentDistance < 11 then currentDistance = 11 end
            local step = state.infExtendStep or 3
            if input.Position.Z < 0 then
                currentDistance = currentDistance - step
            else
                currentDistance = currentDistance + step
            end
            if currentDistance < 11 then currentDistance = 11 end
        end)
    end

    local function makeMobileButton(text, yOffset, cb)
        local btn = Instance.new("TextButton")
        btn.Name = "_RYZE_InfExtend_" .. text
        btn.Size = UDim2.new(0, 45, 0, 45)
        btn.Position = UDim2.new(1, -70, 1, yOffset)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        btn.BackgroundTransparency = 0.3
        btn.BorderSizePixel = 0
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(240, 240, 245)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 20
        btn.AutoButtonColor = false
        btn.Visible = false
        btn.ZIndex = 100
        btn.Parent = gui
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = Color3.fromRGB(115, 95, 245)
        stroke.Thickness = 1
        stroke.Transparency = 0.5
        btn.MouseButton1Click:Connect(cb)
        return btn
    end

    local btnUp = makeMobileButton("+", -259, function()
        if not infExtendActive then return end
        if currentDistance < 11 then currentDistance = 11 end
        currentDistance = currentDistance + (state.infExtendStep or 3)
    end)
    local btnDown = makeMobileButton("-", -211, function()
        if not infExtendActive then return end
        if currentDistance < 11 then currentDistance = 11 end
        currentDistance = currentDistance - (state.infExtendStep or 3)
        if currentDistance < 11 then currentDistance = 11 end
    end)

    makeSlider(auraTab, "Inf Extend Step", 3, 1, 25, function(v)
        state.infExtendStep = v
    end)
    makeSlider(auraTab, "Inf Extend Base Distance", state.infinityExtendDist or 12, 11, 500, function(v)
        currentDistance = v
        state.infinityExtendDist = v
    end)

    makeToggle(auraTab, "Infinity Extend", state.infinityExtendOn or false, function(on)
        infExtendActive = on
        state.infinityExtendOn = on
        if infExtendConn then infExtendConn:Disconnect() infExtendConn = nil end
        if not on then
            -- Cleanup
            local gp = workspace_:FindFirstChild("GrabParts")
            if gp then
                local grabPart = gp:FindFirstChild("GrabPart")
                if grabPart then
                    local bp = grabPart:FindFirstChild("_RYZE_InfExtendBP")
                    if bp then bp:Destroy() end
                end
                local dragPart = gp:FindFirstChild("DragPart")
                if dragPart then
                    local alignPos = dragPart:FindFirstChildOfClass("AlignPosition")
                    if alignPos then alignPos.Enabled = true end
                end
            end
            if infExtendScrollConn then infExtendScrollConn:Disconnect() infExtendScrollConn = nil end
            btnUp.Visible = false
            btnDown.Visible = false
            return
        end

        setupScrollWheel()

        -- Mobile buttons hiện khi TouchEnabled
        if userInputService.TouchEnabled then
            btnUp.Visible = true
            btnDown.Visible = true
        end

        -- GrabParts đang có sẵn → apply
        local existing = workspace_:FindFirstChild("GrabParts")
        if existing then
            task.spawn(function() applyInfExtend(existing) end)
        end

        -- Lắng nghe GrabParts mới
        infExtendConn = workspace_.ChildAdded:Connect(function(child)
            if not infExtendActive then return end
            if child.Name == "GrabParts" then
                task.wait(0.05)
                applyInfExtend(child)
            end
        end)
    end)

     gui.Destroying:Connect(function()
        infExtendActive = false
        if infExtendConn then infExtendConn:Disconnect() end
        if infExtendScrollConn then infExtendScrollConn:Disconnect() end
        if btnUp and btnUp.Parent then btnUp:Destroy() end
        if btnDown and btnDown.Parent then btnDown:Destroy() end
        local gp = workspace_:FindFirstChild("GrabParts")
        if gp then
            local grabPart = gp:FindFirstChild("GrabPart")
            if grabPart then
                local bp = grabPart:FindFirstChild("_RYZE_InfExtendBP")
                if bp then bp:Destroy() end
            end
            local dragPart = gp:FindFirstChild("DragPart")
            if dragPart then
                local alignPos = dragPart:FindFirstChildOfClass("AlignPosition")
                if alignPos then alignPos.Enabled = true end
            end
        end
    end)
end

-- ==========================================
-- ⭐ SUPER STRENGTH (PORTED 100% từ PoopHub)
-- Cơ chế:
--   1. GrabParts xuất hiện → tạo BodyVelocity MaxForce=0 trên weld.Part1
--   2. Khi release (Parent = nil) → check GetLastInputType():
--      - MB2 (PC right click) / MB1 / Touch / _G.MobileSuperStrengthTriggered
--      → THROW: boost BV theo LookVector
--      - Còn lại → destroy BV (drop bình thường, không lag)
--   3. Mobile: overlay textButton vô hình lên nút "Throw" native của game
--      (ContextActionGui > ContextButtonFrame > ImageLabel 9603669631)
-- ==========================================
do
    state.superStrength = false
    state.superStrengthPower = 5000
    state._ssConn = nil
    _G.MobileSuperStrengthTriggered = false

    -- ⭐ Mobile: text button vô hình để bắt touch trên nút "Throw" native
    local mobileThrowBtn = Instance.new("TextButton")
    mobileThrowBtn.Name = "_RYZE_MobileThrowBtn"
    mobileThrowBtn.BackgroundTransparency = 1
    mobileThrowBtn.Text = ""
    mobileThrowBtn.Active = false
    mobileThrowBtn.Visible = false
    mobileThrowBtn.ZIndex = 999
    mobileThrowBtn.Parent = gui

    local function setupThrowButton()
        task.spawn(function()
            local pg = localPlayer:FindFirstChild("PlayerGui")
            pg = pg and pg:WaitForChild("ContextActionGui", 5)
            pg = pg and pg:WaitForChild("ContextButtonFrame", 5)
            if not pg then return end

            local conn = nil
            local function checkAndMove(inst)
                if inst:IsA("ImageLabel") and inst.Image == "rbxassetid://9603669631" then
                    if inst.Parent and inst.Parent:IsA("GuiObject") then
                        mobileThrowBtn.Parent = inst.Parent
                        mobileThrowBtn.Position = UDim2.new(0, 0, 0, 0)
                        mobileThrowBtn.Size = UDim2.new(1, 0, 1, 0)
                        return true
                    end
                end
                return false
            end

            for _, d in ipairs(pg:GetDescendants()) do
                if checkAndMove(d) then return end
            end
            conn = pg.DescendantAdded:Connect(function(d)
                if checkAndMove(d) and conn then conn:Disconnect() end
            end)
        end)
    end
    setupThrowButton()

    -- ⭐ Mobile: bắt sự kiện touch trên nút throw → set trigger flag
    mobileThrowBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            if mobileThrowBtn.Visible then
                _G.MobileSuperStrengthTriggered = true
                task.delay(0.5, function() _G.MobileSuperStrengthTriggered = false end)
            end
        end
    end)

    -- ⭐ PC + Mobile: workspace.ChildAdded → apply BodyVelocity trên target
    local function attachSuperStrengthListener()
        if state._ssConn then state._ssConn:Disconnect() state._ssConn = nil end
        state._ssConn = workspace_.ChildAdded:Connect(function(child)
            if child.Name ~= "GrabParts" then return end
            if not state.superStrength then return end
            task.spawn(function()
                local grabPart = child:WaitForChild("GrabPart", 5)
                if not grabPart then return end
                local weld = grabPart:FindFirstChild("WeldConstraint")
                if not weld or not weld.Part1 then return end
                local targetPart = weld.Part1

                -- Xoá BV cũ nếu có
                local oldBV = targetPart:FindFirstChild("_RYZE_SSBV")
                if oldBV then oldBV:Destroy() end

                -- ⭐ Tạo BV 0 force → chưa làm gì target
                local bv = Instance.new("BodyVelocity")
                bv.Name = "_RYZE_SSBV"
                bv.MaxForce = Vector3.zero
                bv.Velocity = Vector3.zero
                bv.Parent = targetPart

                -- ⭐ Lắng nghe release
                local parentConn
                parentConn = child:GetPropertyChangedSignal("Parent"):Connect(function()
                    if child.Parent then return end
                    if parentConn then parentConn:Disconnect() end

                    local lastInput = userInputService:GetLastInputType()
                    local isMB2 = lastInput == Enum.UserInputType.MouseButton2
                    local isMB1 = lastInput == Enum.UserInputType.MouseButton1
                    local isTouch = lastInput == Enum.UserInputType.Touch
                    local mobileTrig = _G.MobileSuperStrengthTriggered

                    -- Logic y hệt Poop: MB2 hoặc mobileTrig → throw
                    --                 MB1 / Touch / khác (không phải throw) → drop sạch
                    local shouldThrow = isMB2 or mobileTrig

                    if shouldThrow and state.superStrength then
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Velocity = workspace.CurrentCamera.CFrame.LookVector * (state.superStrengthPower or 5000)
                        Debris:AddItem(bv, 1)
                    else
                        bv:Destroy()
                    end
                end)
            end)
        end)
    end

    -- ⭐ Toggle UI
    makeToggle(auraTab, "Super Strength (Throw on Release)", false, function(on)
        state.superStrength = on
        mobileThrowBtn.Visible = on
        if on then
            attachSuperStrengthListener()
        else
            if state._ssConn then state._ssConn:Disconnect() state._ssConn = nil end
        end
    end)

    -- ⭐ Slider force (10-10000, mặc định 5000)
    makeSlider(auraTab, "Super Strength Force", 5000, 10, 10000, function(v)
        state.superStrengthPower = v
    end)

    gui.Destroying:Connect(function()
        if state._ssConn then state._ssConn:Disconnect() end
        if mobileThrowBtn and mobileThrowBtn.Parent then mobileThrowBtn:Destroy() end
