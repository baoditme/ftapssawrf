local function _K_lh() local c = _K_lc() if not c then return end return c:FindFirstChildOfClass("Humanoid") end
local function _K_lr() local c = _K_lc() if not c then return end return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") end
local function _K_inv() return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys") end
local function _K_lookAt(from, to)
    local dir = (to - from).Unit
    local right = dir:Cross(Vector3.new(0, 1, 0))
    local up = right:Cross(dir)
    return CFrame.fromMatrix(from, right, up)
end
local function _K_sno(part)
    if not part or not part.Parent then return end
    pcall(function() setNetOwner:FireServer(part, part.CFrame) end)
end
local function _K_spawnToy(toyName, cf)
    local inv = _K_inv()
    if not inv then return nil end
    local canSpawn = LocalPlayer:FindFirstChild("CanSpawnToy")
    if canSpawn and not canSpawn.Value then
        pcall(function() canSpawn.Changed:Wait() end)
    end
    local t, conn
    conn = inv.ChildAdded:Connect(function(c) if c.Name == toyName then t = c end end)
    task.spawn(function()
        pcall(function() spawnToyRemote:InvokeServer(toyName, cf, Vector3.zero) end)
    end)
    local t0 = tick()
    repeat task.wait() until t or tick() - t0 > 2.5
    if conn then conn:Disconnect() end
    return t
end
local function _K_isFriend(p)
    if not p then return false end
    local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(p.UserId) end)
    return ok and res
end
local function _K_isInPlot(p)
    return p:FindFirstChild("InPlot") and p.InPlot.Value
end
local function _K_isValidTarget(p)
    if not p or p == LocalPlayer then return false end
    local c = p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return false end
    if _K.settings.ignoreFriends and _K_isFriend(p) then return false end
    if _K_isInPlot(p) then return false end
    return true, r, c
end

