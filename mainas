local function ensureFolder()
    pcall(function()
        if isfolder and not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end
    end)
end

local function serial(v, seen)
    seen = seen or {}
    local t = typeof(v)
    if t == "number" or t == "string" or t == "boolean" then return v end
    if t == "EnumItem" then
        return { __t = "EnumItem", e = string.gsub(tostring(v.EnumType), "Enum%.", ""), n = v.Name }
    end
    if t == "Color3" then
        return { __t = "Color3", r = v.R, g = v.G, b = v.B }
    end
    if t == "table" then
        if seen[v] then return nil end
        seen[v] = true
        local o = {}
        for k, val in pairs(v) do
            if typeof(val) ~= "Instance" and type(val) ~= "function" then
                o[tostring(k)] = serial(val, seen)
            end
        end
        seen[v] = nil
        return o
    end
    return nil
end

local function deserial(v)
    if type(v) ~= "table" then return v end
    if v.__t == "EnumItem" and Enum[v.e] and Enum[v.e][v.n] then return Enum[v.e][v.n] end
    if v.__t == "Color3" then return Color3.new(v.r, v.g, v.b) end
    local o = {}
    for k, val in pairs(v) do o[tonumber(k) or k] = deserial(val) end
    return o
end

local _saving = false
local function saveConfig()
    ensureFolder()
    if not writefile or _saving then return end
    _saving = true
    task.delay(0.5, function()
        _saving = false
        local data = {}
        for k, v in pairs(state) do
            if k ~= "session" then
                local s = serial(v)
                if s ~= nil then data[k] = s end
            end
        end
        pcall(function() writefile(CFG_FILE, HttpService:JSONEncode(data)) end)
    end)
end

local function loadConfig()
    ensureFolder()
    if not (isfile and isfile(CFG_FILE)) then return end
    local ok, raw = pcall(readfile, CFG_FILE)
    if not ok or not raw or raw == "" then return end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(decoded) ~= "table" then return end
    for k, v in pairs(decoded) do
        if k ~= "session" then
            local real = deserial(v)
            if type(real) == "table" and type(state[k]) == "table" then
                for sk, sv in pairs(real) do state[k][sk] = sv end
            else
                state[k] = real
            end
        end
    end
end
loadConfig()

