    for _, btn in ipairs(gui:GetDescendants()) do
        if btn:IsA("TextButton") and btn.Text:sub(1,2) == "  " then
            if btn.Text:sub(3) == label then
                for _, c in ipairs(btn:GetChildren()) do
                    if c:IsA("Frame") and c.Size == UDim2.new(0, 28, 0, 14) then
                        c.BackgroundColor3 = on and C_ACCENT or Color3.fromRGB(45, 45, 55)
                        local dot = c:FindFirstChildWhichIsA("Frame")
                        if dot then
                            dot.Position = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
                        end
                    end
                end
                return
            end
        end
    end
end

function makeToggle(parent, text, default, cb)
    local on = default or false
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = C_ELEM
        btn.BackgroundTransparency = 0
    btn.Text = "  " .. text
    btn.TextColor3 = C_TEXT
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = parent

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    local s = Instance.new("UIStroke")
    s.Thickness = 1
    s.Color = Color3.fromRGB(255, 255, 255)
    s.Transparency = 0.94
    s.Parent = btn

    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0, 28, 0, 14)
    pill.Position = UDim2.new(1, -36, 0.5, -7)
    pill.BackgroundColor3 = on and C_ACCENT or Color3.fromRGB(45, 45, 55)
    pill.BorderSizePixel = 0
    pill.Parent = btn
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 10, 0, 10)
    dot.Position = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
    dot.BackgroundColor3 = Color3.new(1, 1, 1)
    dot.BorderSizePixel = 0
    dot.Parent = pill
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    btn.MouseButton1Click:Connect(function()
        on = not on
        local targetColor = on and C_ACCENT or Color3.fromRGB(45, 45, 55)
        local targetDotPos = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)

        tweenService:Create(pill, TweenInfo.new(0.2, Enum.EasingStyle.Quart), { BackgroundColor3 = targetColor }):Play()
        tweenService:Create(dot, TweenInfo.new(0.2, Enum.EasingStyle.Quart), { Position = targetDotPos }):Play()
        pcall(cb, on)
        if _G.QueueSave then _G.QueueSave() end
    end)
    table.insert(allElements, { name = text, obj = btn, page = parent })
    return btn
end

function makeSlider(parent, text, default, min, max, cb)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 46)
    frame.BackgroundColor3 = C_ELEM
    frame.BorderSizePixel = 0
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -70, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = C_TEXT
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame

    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0, 50, 0, 18)
    valLbl.Position = UDim2.new(1, -60, 0, 4)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(default)
    valLbl.TextColor3 = C_MUTED
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 11
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Parent = frame

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 4)
    bar.Position = UDim2.new(0, 10, 0, 30)
    bar.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    bar.BorderSizePixel = 0
    bar.Parent = frame
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local initP = (default - min) / (max - min)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initP, 0, 1, 0)
    fill.BackgroundColor3 = C_ACCENT
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    -- Núm tròn trắng cho dễ nhìn vị trí kéo
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(initP, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.ZIndex = 3
    knob.Parent = bar
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    -- Hitbox CAO 30px (không phải 4px)
    local btnArea = Instance.new("TextButton")
    btnArea.Size = UDim2.new(1, 20, 0, 30)
    btnArea.Position = UDim2.new(0, -10, 0, -13)
    btnArea.BackgroundTransparency = 1
    btnArea.Text = ""
    btnArea.ZIndex = 4
    btnArea.Parent = bar

    local dragging = false
    local isScaleSlider = (text == "Menu Scale (%)")

        local lastV = default

    local function update(mx)
        local abs  = bar.AbsolutePosition.X
        local size = bar.AbsoluteSize.X
        if size <= 0 then return end
        local p = math.clamp((mx - abs) / size, 0, 1)
        local v = min + p * (max - min)
        v = (max - min < 1) and (math.floor(v * 100) / 100) or math.floor(v)
        lastV = v
        valLbl.Text = tostring(v)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, 0, 0.5, 0)
        -- ★ Scale slider: KHÔNG apply cb trong lúc kéo, để dành đến lúc thả
        if not isScaleSlider then
            pcall(cb, v)
            if _G.QueueSave then _G.QueueSave() end
        end
    end

    btnArea.MouseButton1Down:Connect(function()
        dragging = true
        if isScaleSlider then state._scaleSliderHold = true end
        local sf = frame:FindFirstAncestorWhichIsA("ScrollingFrame")
        if sf then sf.ScrollingEnabled = false end
        update(userInputService:GetMouseLocation().X)
    end)

    -- ★ BULLETPROOF: poll chuột bằng Heartbeat, không dùng InputChanged
    runService.Heartbeat:Connect(function()
        if not dragging then return end
        if not frame.Parent then dragging = false return end
        update(userInputService:GetMouseLocation().X)
    end)

            userInputService.InputEnded:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch) and dragging then
            dragging = false
            -- ★ Scale slider: commit giá trị cuối CÙNG 1 LẦN khi thả
            if isScaleSlider then
                pcall(cb, lastV)
            end
            if _G.QueueSave then _G.QueueSave() end
            for _, p in pairs(pages) do
                if p and p.Parent then p.ScrollingEnabled = true end
            end
        end
    end)

    -- ⭐ REGISTRY: cho phép restore từ config (không cần firesignal)
    if not _G.RYZE_Sliders then _G.RYZE_Sliders = {} end
    _G.RYZE_Sliders[text] = {
        setValue = function(v)
            v = math.clamp(v, min, max)
            lastV = v
            valLbl.Text = tostring(v)
            local p = (v - min) / (max - min)
            fill.Size = UDim2.new(p, 0, 1, 0)
            knob.Position = UDim2.new(p, 0, 0.5, 0)
            pcall(cb, v)
        end,
    }

    table.insert(allElements, { name = text, obj = frame, page = parent })
    return frame
end

