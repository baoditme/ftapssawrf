local _A_feature = {}

function _A_feature.setupAntiGrabV1()
    isHeld.Changed:Connect(function(isBeingHeld)
        if isBeingHeld and _A.settings.AntiGrab then
            local hrp = (LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart")
            local lastFire = 0
            local conn
            conn = RunService.Heartbeat:Connect(function()
                if isHeld.Value then
                    local now = tick()
                    if now - lastFire < 0.1 then return end
                    lastFire = now
                    hrp.Velocity = Vector3.new()
                    hrp.Anchored = true
                    struggleRemote:FireServer(LocalPlayer)
                    ragdollRemote:FireServer(hrp, 0)
                else
                    hrp.Velocity = Vector3.new()
                    hrp.Anchored = false
                    conn:Disconnect()
                end
            end)
        end
    end)
end

function _A_feature.startStruggleLoop()
    local char = LocalPlayer.Character
    if not char or _A.state.struggleTasks[char] then return end
    _A.state.struggleTasks[char] = true
    task.spawn(function()
        while _A.state.struggleTasks[char] do
            local head = char:FindFirstChild("Head")
            if head and head:FindFirstChild("PartOwner") and isHeld.Value then
                pcall(function()
                    struggleRemote:FireServer()
                    local gce = ReplicatedStorage:FindFirstChild("GameCorrectionEvents")
                    if gce then
                        local sav = gce:FindFirstChild("StopAllVelocity")
                        if sav then sav:FireServer() end
                    end
                end)
            else
                _A.state.struggleTasks[char] = nil
                break
            end
            task.wait(0.1)
        end
    end)
end

function _A_feature.enableAntiGrabSolaris()
    if _A.state.connections.antiGrab then _A.state.connections.antiGrab:Disconnect() end
    local lastCheck = 0
    _A.state.connections.antiGrab = RunService.Heartbeat:Connect(function()
        local now = tick()
        if now - lastCheck < 0.04 then return end
        lastCheck = now
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Head") then
            local head = char.Head
            if head:FindFirstChild("PartOwner") and isHeld.Value then
                _A_feature.startStruggleLoop()
