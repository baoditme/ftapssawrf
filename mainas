Workspace.ChildAdded:Connect(function(child)
    if child.Name ~= "GrabParts" then return end
    task.wait(0.05)
    local part = _getGrabbedPart()
    if not part then return end
    local modes = state.grab.modes
    if not next(modes) then return end

    local model = part.Parent
    local grabbedPlayer = model and Players:GetPlayerFromCharacter(model)
    local grabbedChar = grabbedPlayer and grabbedPlayer.Character
    local grabbedHRP = grabbedChar and grabbedChar:FindFirstChild("HumanoidRootPart")
    local grabbedHum = grabbedChar and grabbedChar:FindFirstChildOfClass("Humanoid")

    if modes["Sky Grab"]        then handleSkyGrab(child) end
    if modes["Teleport Up"]     then handleTeleportGrab(child, "up") end
    if modes["Teleport Down"]   then handleTeleportGrab(child, "down") end
    if modes["Chaos Grab"]      then handleChaosGrab(child, function() return state.grab.modes["Chaos Grab"] end) end
    if modes["Supersonic Grab"] then handleSupersonicGrab(child) end
    if modes["Freeze Grab"]     then handleFreezeGrab(child) end

    if modes["Massless"] then
        task.spawn(function()
            while _grabIsActive(part) do
                pcall(function()
                    for _, d in ipairs(child:GetDescendants()) do
                        if d:IsA("BasePart") then
                            d.Massless = true
                            d.CanCollide = false
                            d.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                        end
                    end
                end)
                task.wait(0.1)
            end
        end)
    end

    if modes["Spin"] then
        task.spawn(function()
            local spinSpeed = 10 + (state.grab.spinSpeed - 1) * 30
            local bav = Instance.new("BodyAngularVelocity")
            bav.AngularVelocity = Vector3.new(0, spinSpeed, 0)
            bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bav.Parent = part
            while _grabIsActive(part) do
                pcall(function() bav.AngularVelocity = Vector3.new(0, spinSpeed, 0) end)
                task.wait()
            end
            if bav and bav.Parent then bav:Destroy() end
        end)
    end

    if modes["Noclip"] then
        task.spawn(function()
            while _grabIsActive(part) do
                pcall(function()
                    for _, d in ipairs(child:GetDescendants()) do
                        if d:IsA("BasePart") then d.CanCollide = false end
                    end
                end)
                task.wait(0.05)
            end
        end)
    end

    if modes["Invisible"] then
        task.spawn(function()
            while _grabIsActive(part) do
                local gp = Workspace:FindFirstChild("GrabParts")
                if gp then
                    for _, d in ipairs(gp:GetDescendants()) do
                        if d:IsA("Beam") then d.Enabled = false end
                    end
                end
                task.wait(0.05)
            end
        end)
    end

    if modes["Free"] then
        task.spawn(function()
            while _grabIsActive(part) do
                local gp = Workspace:FindFirstChild("GrabParts")
                if gp then
                    local dp = gp:FindFirstChild("DragPart")
                    if dp then
                        local ao = dp:FindFirstChildOfClass("AlignOrientation")
                        if ao then ao.MaxTorque = 0 end
                    end
                end
                task.wait(0.1)
            end
        end)
    end

    if grabbedPlayer then
        if modes["Kill Grab"] and grabbedHum and grabbedHum.Health > 0 then
            task.spawn(function()
                pcall(function()
                    grabbedHum.BreakJointsOnDeath = false
                    grabbedHum:ChangeState(Enum.HumanoidStateType.Dead)
                    state.session.kills += 1
                end)
                _release(part)
                if grabbedHRP then _skyVelocity(grabbedHRP) end
            end)
        end

        if modes["Void Grab"] and grabbedHRP then
            task.spawn(function()
                state.session.voids += 1
                _release(part)
                _skyVelocity(grabbedHRP)
            end)
        end

        if modes["Teleport to Spawn"] and grabbedHRP then
            task.spawn(function()
                local spawn = Workspace:FindFirstChildOfClass("SpawnLocation")
                if spawn then
                    pcall(function()
                        grabbedHRP.CFrame = spawn.CFrame + Vector3.new(0, 3, 0)
                        grabbedHRP.AssemblyLinearVelocity = Vector3.zero
                    end)
                    _release(part)
                end
            end)
        end

        if modes["Ragdoll Grab"] and grabbedHRP and ragdollRemote then
            task.spawn(function()
                while _grabIsActive(part) do
                    pcall(function() ragdollRemote:FireServer(grabbedHRP, 15) end)
                    task.wait(0.1)
                end
            end)
        end

        if modes["Unstick"] then
            task.spawn(function()
                local seen = {}
                while _grabIsActive(part) do
                    for _, d in ipairs(grabbedChar:GetDescendants()) do
                        if d:IsA("BasePart") then
                            for _, cp in ipairs(d:GetConnectedParts()) do
                                if cp and not cp:IsDescendantOf(grabbedChar) then
                                    local sp = cp.Name == "StickyPart" and cp or cp:FindFirstChild("StickyPart", true)
                                    if sp and sp:IsA("BasePart") and not seen[sp] then
                                        seen[sp] = true
                                        pcall(function() setNetOwner:FireServer(sp, sp.CFrame) end)
                                    end
                                end
                            end
                        end
                    end
                    task.wait(0.3)
                end
            end)
        end
    end
end)

-- Infinity Extend
GrabTab:CreateSection("Infinity Extend")

local infExtend = { active = false, conn = nil, scrollConn = nil, distance = 12, step = 3 }
local camera = Workspace.CurrentCamera

local function applyInfExtend(gp)
    if not gp or not gp.Parent then return end
    local grabPart = gp:WaitForChild("GrabPart", 2)
    local dragPart = gp:WaitForChild("DragPart", 2)
    if not grabPart or not dragPart then return end
    local weld = grabPart:WaitForChild("WeldConstraint", 2)
    if not weld or not weld.Part1 then return end
    local oldBP = grabPart:FindFirstChild("_FTAP_InfExtendBP")
    if oldBP then oldBP:Destroy() end
    local bp = Instance.new("BodyPosition")
    bp.Name = "_FTAP_InfExtendBP"
    bp.MaxForce = Vector3.new(275000, 275000, 275000)
    bp.P = 20000 bp.D = 950
    bp.Position = weld.Part1.Position
    bp.Parent = grabPart
    if infExtend.distance < 11 then infExtend.distance = 11 end
    local baseDist = (grabPart.Position - camera.CFrame.Position).Magnitude
    if baseDist > infExtend.distance then infExtend.distance = baseDist end
    local alignPos = dragPart:FindFirstChildOfClass("AlignPosition")
    if alignPos then alignPos.Enabled = false end
    task.spawn(function()
        while infExtend.active and gp.Parent and grabPart.Parent and bp.Parent do
            pcall(function()
                bp.Position = camera.CFrame.Position + camera.CFrame.LookVector * infExtend.distance
            end)
            task.wait()
        end
        pcall(function() bp:Destroy() end)
    end)
end

local function setupInfExtendScroll()
    if infExtend.scrollConn then infExtend.scrollConn:Disconnect() infExtend.scrollConn = nil end
    infExtend.scrollConn = UserInputService.InputChanged:Connect(function(input)
        if not infExtend.active then return end
        if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
        if infExtend.distance < 11 then infExtend.distance = 11 end
        if input.Position.Z < 0 then
            infExtend.distance -= infExtend.step
        else
            infExtend.distance += infExtend.step
        end
        if infExtend.distance < 11 then infExtend.distance = 11 end
    end)
end

GrabTab:CreateToggle({
    Name = "Infinity Extend",
    Default = false,
    Callback = function(on)
        infExtend.active = on
        if infExtend.conn then infExtend.conn:Disconnect() infExtend.conn = nil end
        if not on then
            local gp = Workspace:FindFirstChild("GrabParts")
            if gp then
                local grabPart = gp:FindFirstChild("GrabPart")
                if grabPart then
                    local bp = grabPart:FindFirstChild("_FTAP_InfExtendBP")
                    if bp then bp:Destroy() end
                end
                local dragPart = gp:FindFirstChild("DragPart")
                if dragPart then
                    local alignPos = dragPart:FindFirstChildOfClass("AlignPosition")
                    if alignPos then alignPos.Enabled = true end
                end
            end
            if infExtend.scrollConn then infExtend.scrollConn:Disconnect() infExtend.scrollConn = nil end
            return
        end
        setupInfExtendScroll()
        local existing = Workspace:FindFirstChild("GrabParts")
        if existing then task.spawn(function() applyInfExtend(existing) end) end
        infExtend.conn = Workspace.ChildAdded:Connect(function(child)
            if not infExtend.active then return end
            if child.Name == "GrabParts" then
                task.wait(0.05)
                applyInfExtend(child)
            end
        end)
    end,
})

