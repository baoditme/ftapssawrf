-- [PATCH-05] MASS SILENT KICK (BOMBA)
-- ==========================================
do
    local function snapBlobTo(blob, targetCFrame)
        local hrp = blob:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        hrp.CFrame = targetCFrame

        local att0 = hrp:FindFirstChild("_RYZE_BlobAtt") or Instance.new("Attachment", hrp)
        att0.Name = "_RYZE_BlobAtt"

        local targetPart = workspace_:FindFirstChild("_RYZE_BlobTarget") or Instance.new("Part")
        targetPart.Anchored = true
        targetPart.CanCollide = false
        targetPart.Size = Vector3.new(1, 1, 1)
        targetPart.Transparency = 1
        targetPart.CFrame = targetCFrame
        targetPart.Name = "_RYZE_BlobTarget"
        targetPart.Parent = workspace_

        local att1 = targetPart:FindFirstChild("_RYZE_BlobTargetAtt") or Instance.new("Attachment", targetPart)
        att1.Name = "_RYZE_BlobTargetAtt"

        local ap = hrp:FindFirstChild("_RYZE_BlobAlignPos") or Instance.new("AlignPosition", hrp)
        ap.Name = "_RYZE_BlobAlignPos"
        ap.Attachment0 = att0
        ap.Attachment1 = att1
        ap.RigidityEnabled = true
        ap.Responsiveness = 300
        ap.MaxForce = math.huge

        local ao = hrp:FindFirstChild("_RYZE_BlobAlignOri") or Instance.new("AlignOrientation", hrp)
        ao.Name = "_RYZE_BlobAlignOri"
        ao.Attachment0 = att0
        ao.Attachment1 = att1
        ao.Responsiveness = 300
        ao.MaxTorque = math.huge
        ao.RigidityEnabled = true
    end

    local function releaseBlobAlign(blob)
        local hrp = blob:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if hrp:FindFirstChild("_RYZE_BlobAlignPos") then hrp._RYZE_BlobAlignPos:Destroy() end
        if hrp:FindFirstChild("_RYZE_BlobAlignOri") then hrp._RYZE_BlobAlignOri:Destroy() end
        if hrp:FindFirstChild("_RYZE_BlobAtt") then hrp._RYZE_BlobAtt:Destroy() end
        local t = workspace_:FindFirstChild("_RYZE_BlobTarget")
        if t then t:Destroy() end
    end

    local function getBlobman()
        local folder = workspace_:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        return folder and folder:FindFirstChild("CreatureBlobman")
    end

    makeButton(kickTab, "Mass Silent Kick (Blob Circle)", function()
        local blob = getBlobman()
        if not blob then
            Notify("Mass Kick", "Blobman not found", "warning", 2)
            return
        end
        local list = {}
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= localPlayer and not (state.isWL and state.isWL(p)) then
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    table.insert(list, p.Name)
                end
            end
        end
        if #list == 0 then
            Notify("Mass Kick", "No targets", "warning", 2)
            return
        end

        local grab = blob.BlobmanSeatAndOwnerScript and blob.BlobmanSeatAndOwnerScript:FindFirstChild("CreatureGrab")
        local release = blob.BlobmanSeatAndOwnerScript and blob.BlobmanSeatAndOwnerScript:FindFirstChild("CreatureRelease")
        local drop = blob.BlobmanSeatAndOwnerScript and blob.BlobmanSeatAndOwnerScript:FindFirstChild("CreatureDrop")
        local det = blob:FindFirstChild("LeftDetector")
        local weld = det and det:FindFirstChild("LeftWeld")
        if not (grab and release and drop and det and weld) then
            Notify("Mass Kick", "Blob remotes missing", "warning", 2)
            return
        end
        local localHrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not localHrp then return end

        task.spawn(function()
            -- Phase 1: pull into range
            for _, name in ipairs(list) do
                local p = players:FindFirstChild(name)
                if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local tHrp = p.Character.HumanoidRootPart
                    snapBlobTo(blob, tHrp.CFrame)
                    task.wait(0.15)
                    pcall(function()
                        grab:FireServer(blob.RightDetector, tHrp, blob.RightDetector.RightWeld)
                        release:FireServer(blob.RightDetector.RightWeld)
                    end)
                    task.wait(0.05)
                end
            end

            -- Phase 2: center
            snapBlobTo(blob, CFrame.new(0, 100, 0))
            task.wait(0.1)

            -- Phase 3: circular silent kick
            local center = Vector3.new(0, 100, 0)
            local radius = 40 + (#list * 5)
            local inc = (2 * math.pi) / #list
            for i, name in ipairs(list) do
                local angle = inc * (i - 1)
                local pos = Vector3.new(
                    center.X + radius * math.cos(angle),
                    center.Y,
                    center.Z + radius * math.sin(angle)
                )
                snapBlobTo(blob, CFrame.new(pos))
                task.wait(0.1)
                local p = players:FindFirstChild(name)
                if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local tHrp = p.Character.HumanoidRootPart
                    local blobHrp = blob:FindFirstChild("HumanoidRootPart")
                    if blobHrp then
                        tHrp.CFrame = CFrame.new(blobHrp.Position.X, blobHrp.Position.Y + 20, blobHrp.Position.Z)
                        task.wait(0.15)
                        pcall(function()
                            setNetworkOwner:FireServer(tHrp, tHrp.CFrame)
                            destroyGrabLine:FireServer(tHrp)
                            grab:FireServer(det, localHrp, weld)
                            grab:FireServer(det, tHrp, weld)
                            drop:FireServer(weld, tHrp.RootAttachment)
                        end)
                    end
                end
                task.wait()
            end

            task.wait(1)
            releaseBlobAlign(blob)
            Notify("Mass Kick", "Complete", "success", 2)
        end)
    end)
end

