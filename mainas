                            and (tHRP.Position - myHRP.Position).Magnitude <= state.grab.flingAuraRadius then
                            pcall(function() setNetOwner:FireServer(tHRP, tHRP.CFrame) end)
                            local po = tHRP:FindFirstChild("PartOwner")
                            if po and po.Value == LocalPlayer.Name and not tHRP:FindFirstChild("_FTAP_FlingBV") then
                                local dir = (tHRP.Position - myHRP.Position).Unit
                                local bv = Instance.new("BodyVelocity")
                                bv.Name = "_FTAP_FlingBV"
                                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bv.Velocity = Vector3.new(dir.X, 0.5, dir.Z) * state.grab.flingAuraStrength
                                bv.Parent = tHRP
