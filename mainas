        local spawnCF = hrp.CFrame * CFrame.new(0, 0, -3)
        for _, n in ipairs(ITEMS) do
            pcall(function() spawnToyRemote:InvokeServer(n, spawnCF, Vector3.zero) end); task.wait(0.15)
        end
        task.wait(0.3)

        local slots, bombs = {}, 0
        for _, c in ipairs(folder:GetChildren()) do
            if c.Name == "GlassBoxGray" and not slots[1] then
                local mp = mainPart(c); if mp then slots[1] = { part = mp, model = c } end
            elseif c.Name == "PalletLightBrown" and not slots[2] then
                local mp = mainPart(c); if mp then slots[2] = { part = mp, model = c } end
            elseif c.Name == "BombMissile" and bombs < 6 then
                local mp = mainPart(c); if mp then bombs += 1; slots[2+bombs] = { part = mp, model = c } end
            end
        end

        for i = 1, 8 do
            local s = slots[i]
            if s and s.part then
                local cf = hrp.CFrame * offCF(OFFS[i])
                pcall(function()
                    for _, d in ipairs(s.model:GetDescendants()) do
                        if d:IsA("BasePart") then d.CanCollide = false; d.CanTouch = false end
                    end
                end)
                claimMove(s.part, cf)
                local bp = Instance.new("BodyPosition")
                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bp.P, bp.D = 50000, 1000
                bp.Position = cf.Position; bp.Parent = s.part
                local bg = Instance.new("BodyGyro")
                bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bg.P, bg.D = 50000, 1000
                bg.CFrame = cf; bg.Parent = s.part
                table.insert(shieldParts, { part = s.part, model = s.model, index = i, bp = bp, bg = bg, launched = false })
            end
        end

        table.insert(shieldConns, runService.Heartbeat:Connect(function()
            if not _G.ShieldActive then return end
            local h = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not h then return end
            for _, s in ipairs(shieldParts) do
