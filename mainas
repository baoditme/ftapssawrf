-- [PATCH-06] FLING AURA
-- ==========================================
do
    state._flingAuraOn = false
    state._flingAuraRadius = 28
    state._flingAuraStrength = 400
    state._flingAuraMode = "Players"

    local flingTask = nil

    local function lookAt(pos, target)
        local dir = target - pos
        if dir.Magnitude < 0.001 then return CFrame.new(pos) end
        local u = dir.Unit
        local r = u:Cross(Vector3.new(0, 1, 0))
        if r.Magnitude < 0.001 then r = u:Cross(Vector3.new(0, 0, 1)) end
        return CFrame.fromMatrix(pos, r, r:Cross(u))
    end

    local function stopFlingAura()
        state._flingAuraOn = false
        if flingTask then
            pcall(task.cancel, flingTask)
            flingTask = nil
        end
    end

    makeToggle(grabTab, "Fling Aura", false, function(on)
        state._flingAuraOn = on
        if not on then stopFlingAura() return end

        flingTask = task.spawn(function()
            while state._flingAuraOn do
                local myHrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myHrp then
                    local radius = state._flingAuraRadius
                    local strength = state._flingAuraStrength

                    -- Objects
                    if state._flingAuraMode == "Objects" or state._flingAuraMode == "Both" then
                        local parts = workspace_:GetPartBoundsInRadius(myHrp.Position, radius)
                        for _, v in ipairs(parts) do
                            if v:IsA("BasePart") and not v.Anchored then
                                local isPlayerPart = false
                                for _, plr in ipairs(players:GetPlayers()) do
                                    if plr.Character and v:IsDescendantOf(plr.Character) then
                                        isPlayerPart = true
                                        break
                                    end
                                end
                                if not isPlayerPart then
                                    pcall(function() setNetworkOwner:FireServer(v, v.CFrame) end)
                                    if not v:FindFirstChild("_RYZE_FlingVel") then
                                        local dir = lookAt(myHrp.Position, v.Position)
                                        local bv = Instance.new("BodyVelocity")
                                        bv.Name = "_RYZE_FlingVel"
                                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                        bv.Velocity = Vector3.new(dir.LookVector.X, 0.5, dir.LookVector.Z) * strength
                                        bv.Parent = v
                                        task.delay(1, function() if bv and bv.Parent then bv:Destroy() end end)
                                    end
                                end
                            end
                        end
                    end

                    -- Players
                    if state._flingAuraMode == "Players" or state._flingAuraMode == "Both" then
                        for _, p in ipairs(players:GetPlayers()) do
                            if p ~= localPlayer and not (state.isWL and state.isWL(p)) then
                                local tHrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                                local tHum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                                if tHrp and tHum and tHum.Health > 0
                                    and (tHrp.Position - myHrp.Position).Magnitude <= radius then
                                    pcall(function() setNetworkOwner:FireServer(tHrp, tHrp.CFrame) end)
                                    local po = tHrp:FindFirstChild("PartOwner")
                                    if po and po.Value == localPlayer.Name and not tHrp:FindFirstChild("_RYZE_FlingVel") then
                                        local dir = (tHrp.Position - myHrp.Position).Unit
                                        local bv = Instance.new("BodyVelocity")
                                        bv.Name = "_RYZE_FlingVel"
                                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                        bv.Velocity = Vector3.new(dir.X, 0.5, dir.Z) * strength
                                        bv.Parent = tHrp
                                        task.delay(0.6, function() if bv and bv.Parent then bv:Destroy() end end)
                                    end
                                end
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end)

    makeSlider(grabTab, "Fling Aura Radius", 28, 5, 60, function(v) state._flingAuraRadius = v end)
    makeSlider(grabTab, "Fling Aura Strength", 400, 400, 10000, function(v) state._flingAuraStrength = v end)
    makeDropdown(grabTab, "Fling Aura Target", {"Players", "Objects", "Both"}, "Players",
        function(v) state._flingAuraMode = v end)

    gui.Destroying:Connect(stopFlingAura)
end

