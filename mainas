    state.silent = {enabled = false, distance = 41, part = "Head", wallMode = "Wall"}
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local caller = checkcaller and checkcaller() or false
        if caller or not state.silent.enabled then
            return oldNamecall(self, ...)
        end
        if self ~= workspace_ then
            return oldNamecall(self, ...)
        end
        if getnamecallmethod() ~= "Raycast" then
            return oldNamecall(self, ...)
        end
        local args = {...}
        if not args[1] or not args[2] or typeof(args[3]) ~= "RaycastParams" then
            return oldNamecall(self, ...)
        end
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return oldNamecall(self, ...) end
        local cam = workspace.CurrentCamera
        local mouse = userInputService:GetMouseLocation()
        local best, bestD = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character then
