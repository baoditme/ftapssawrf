                            owned = Ownerboat(head)
                            if not state.loopNoBlobRunning or (p:FindFirstChild("InPlot") and p.InPlot.Value) or not head or not pHum or pHum.Health <= 0 or not hrp or owned or tick() - startTick > 1 then break end
