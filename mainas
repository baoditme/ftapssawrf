        grab:FireServer(det, tHRP, weld)
        task.wait(0.7)
        drop:FireServer(weld, tHRP)
        task.wait(0.3)
        grab:FireServer(det, tHRP, weld)
        local bp = Instance.new("BodyPosition")
        bp.Position = Vector3.new(0, 999e5, 0)
        bp.MaxForce = Vector3.new(0, 99999e9, 0)
        bp.Parent = tHRP
        task.wait(0.6)
        grab:FireServer(det, tHRP, weld)
        bp:Destroy()
        hrp.CFrame = orig
    end

    -- ==========================================
    -- KICK #2: Loop Kick (grab/drop spam)
    -- ==========================================
    local loopKickRunning = false
    function EkLoopKick(targetName)
        local target = Plrs:FindFirstChild(targetName)
        if not target or target == LP then return end
        local char = LP.Character or LP.CharacterAdded:Wait()
        local hum = char:WaitForChild("Humanoid")
        local hrp = char:WaitForChild("HumanoidRootPart")
        local seat = hum.SeatPart
        if not seat then return end
        local blob = seat.Parent
        local tChar = target.Character or target.CharacterAdded:Wait()
        local tHRP = tChar:WaitForChild("HumanoidRootPart")
        local tHum = tChar:WaitForChild("Humanoid")
        local leftDet = blob:WaitForChild("LeftDetector")
        local leftWeld = leftDet:WaitForChild("LeftWeld")
        local rightDet = blob:WaitForChild("RightDetector")
        local rightWeld = rightDet:WaitForChild("RightWeld")
        local grab = blob.BlobmanSeatAndOwnerScript:WaitForChild("CreatureGrab")
        local drop = blob.BlobmanSeatAndOwnerScript:WaitForChild("CreatureDrop")
        local orig = hrp.CFrame
        hrp.CFrame = tHRP.CFrame * CFrame.new(0, -5, 0)
        task.wait(0.1)
        grab:FireServer(leftDet, tHRP, leftWeld)
        task.wait(0.5)
        drop:FireServer(leftWeld, tHRP)
        task.wait(0.2)
        local bp = Instance.new("BodyPosition")
        bp.Position = Vector3.new(0, 999e6, 0)
        bp.MaxForce = Vector3.new(999e6, 999e6, 999e6)
        bp.Parent = tHRP
        grab:FireServer(leftDet, tHRP, leftWeld)
        task.wait(0.5)
        drop:FireServer(leftWeld, tHRP)
        while target and target.Parent and tHum.Health > 0 and loopKickRunning do
            grab:FireServer(leftDet, tHRP, leftWeld) task.wait()
            drop:FireServer(leftWeld, tHRP) task.wait()
            grab:FireServer(rightDet, tHRP, rightWeld) task.wait()
            drop:FireServer(rightWeld, tHRP) task.wait()
            grab:FireServer(leftDet, tHRP, leftWeld)
            grab:FireServer(rightDet, tHRP, rightWeld) task.wait()
            drop:FireServer(leftWeld, tHRP)
            drop:FireServer(rightWeld, tHRP) task.wait()
        end
        if bp then bp:Destroy() end
        hrp.CFrame = orig
    end

    -- ==========================================
    -- KICK #3: BlobKill (aggressive loop)
    -- ==========================================
    local blobKillRunning = false
    function EkBlobKill(targetName)
        local blob
        do
