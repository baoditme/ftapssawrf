KickTab:CreateToggle({ Name = "Enable Grab Kick", Default = false, Callback = function(v)
    if not v then
        _K.settings.grabKickActive = false
        if _K.state.grabKickTask then pcall(function() task.cancel(_K.state.grabKickTask) end) _K.state.grabKickTask = nil end
        if _K.state.grabKickFloatConn then _K.state.grabKickFloatConn:Disconnect() _K.state.grabKickFloatConn = nil end
        return
    end
    if not _K.target then Notify("Kick", "Select target first", "warning") return end
    _K.settings.grabKickActive = true
    _K.state.grabKickTask = task.spawn(function()
        local GE = ReplicatedStorage:WaitForChild("GrabEvents")
        local destroyEvent = GE:WaitForChild("DestroyGrabLine")
        local ownerEvent = GE:WaitForChild("SetNetworkOwner")
        local function startFloat()
            if _K.state.grabKickFloatConn then return end
            _K.state.grabKickFloatConn = RunService.Stepped:Connect(function()
                local ch = _K_lc()
                if ch then for _, p in pairs(ch:GetChildren()) do if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end end end
            end)
        end
        local function stopFloat()
            if _K.state.grabKickFloatConn then _K.state.grabKickFloatConn:Disconnect() _K.state.grabKickFloatConn = nil end
        end
        local function checkAlive(t)
            if not t or t == LocalPlayer or not t.Character then return false end
            local r = t.Character:FindFirstChild("HumanoidRootPart")
            local h = t.Character:FindFirstChildOfClass("Humanoid")
            return r and h and h.Health > 0
        end
        local function hasOwn(t)
            local head = t.Character and t.Character:FindFirstChild("Head")
            return head and head:FindFirstChild("PartOwner") and head.PartOwner.Value == LocalPlayer.Name
        end
        local myCF = nil
        while _K.settings.grabKickActive do
            local mr = _K_lr()
            if mr then myCF = mr.CFrame end
            local tgt = Players:FindFirstChild(_K.target)
            if not tgt then task.wait(0.1) continue end
            if not checkAlive(tgt) then task.wait(0.1) continue end
            local pips = Workspace:FindFirstChild("PlotItems") and Workspace.PlotItems:FindFirstChild("PlayersInPlots")
            if pips then
                local inSafe = false
                for _, c in pairs(pips:GetChildren()) do
                    if c.Name == _K.target then inSafe = true break end
                    if c:IsA("ObjectValue") and c.Value and c.Value.Name == _K.target then inSafe = true break end
                    if c:IsA("StringValue") and c.Value == _K.target then inSafe = true break end
                end
                if inSafe then
                    while _K.settings.grabKickActive do
                        task.wait(0.5)
                        local still = false
                        pips = Workspace:FindFirstChild("PlotItems") and Workspace.PlotItems:FindFirstChild("PlayersInPlots")
                        if pips then
                            for _, c in pairs(pips:GetChildren()) do
                                if c.Name == _K.target then still = true break end
                                if c:IsA("ObjectValue") and c.Value and c.Value.Name == _K.target then still = true break end
                                if c:IsA("StringValue") and c.Value == _K.target then still = true break end
                            end
                        end
                        if not still then break end
                    end
                end
            end
            local tHrp = tgt.Character and tgt.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                for _ = 0, 50 do
                    if not _K.settings.grabKickActive then break end
                    startFloat()
                    local mr2 = _K_lr()
                    if mr2 then
                        local d = LocalPlayer:DistanceFromCharacter(tHrp.Position)
                        if d <= 30 then pcall(function() ownerEvent:FireServer(tHrp, CFrame.lookAt(mr2.Position, tHrp.Position)) end) end
                    end
                    if not checkAlive(tgt) or not _K.settings.grabKickActive or hasOwn(tgt) or tHrp.AssemblyLinearVelocity.Magnitude > 500 then
                        pcall(function() destroyEvent:FireServer(tHrp) end)
                        task.wait()
                        local bv = tHrp:FindFirstChild("SkyVelocity")
                        if not bv then
                            bv = Instance.new("BodyVelocity")
                            bv.Name = "SkyVelocity"
                            bv.Velocity = Vector3.new(0, 1e14, 0)
                            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bv.Parent = tHrp
                        end
                        break
                    end
                    task.wait()
                    local mr3 = _K_lr()
                    if mr3 and tHrp.Parent then
                        if tHrp.Position.Y <= -12 then
                            mr3.CFrame = CFrame.new(tHrp.Position + Vector3.new(0, 5, -15))
                        else
                            mr3.CFrame = CFrame.new(tHrp.Position + Vector3.new(0, -10, -10))
                        end
                        local h = _K_lh()
                        if h and h.SeatPart == nil then h.Sit = false end
                    end
                end
            end
            local mr4 = _K_lr()
            if mr4 and myCF then mr4.CFrame = myCF end
            task.wait(0.1)
        end
        stopFloat()
        local mr5 = _K_lr()
        if mr5 and myCF then mr5.CFrame = myCF end
    end)
end })

