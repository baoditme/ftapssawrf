    layout.Parent = page

        pages[name] = page

    page.DescendantAdded:Connect(function(d)
        if d:IsA("GuiObject") and d.ZIndex < 5 then
            d.ZIndex = 5
        end
    end)

    local btn = Instance.new("TextButton")
