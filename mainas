state.toySet = {}

function computeToyPositions()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    local center = hrp.CFrame
    local positions = {}
    if state.toyShape == "Circle" then
        local count = 20
        for i = 1, count do
            local ang = (i / count) * math.pi * 2
            local y = ((i - 1) % 5) / 4 * state.toyHeight
            table.insert(positions, center
                * CFrame.new(math.cos(ang) * state.toyRadius, y, math.sin(ang) * state.toyRadius))
        end
    elseif state.toyShape == "Square" then
        local side = 2
        local step = state.toyRadius / 2
        for ix = -side, side do
            for iz = -side, side do
                if math.abs(ix) == side or math.abs(iz) == side then
                    local y = (math.abs(ix) + math.abs(iz)) / (side * 2) * state.toyHeight
                    table.insert(positions, center * CFrame.new(ix * step, y, iz * step))
                end
            end
        end
    elseif state.toyShape == "Line" then
        for i = -8, 8 do
            table.insert(positions, center
                * CFrame.new(0, ((i + 8) / 16) * state.toyHeight, i * (state.toyRadius / 8)))
        end
    end
    return positions
end

function clearToySet()
    for _, t in ipairs(state.toySet) do
        if t and t.Parent then pcall(function() destroyToyRemote:FireServer(t) end) end
    end
    state.toySet = {}
end

