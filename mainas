    makeButton(funTab, "Launch 1 Missile -> Target", function()
        local p = missileTarget and players:FindFirstChild(missileTarget)
        if not p or not p.Character then
            pcall(Notify, "Shield", "Select target first", "warning", 2); return
        end
        local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
        if not tHrp then return end
        local s = getFreeBomb()
        if not s then pcall(Notify, "Shield", "No unused missiles left", "warning", 2); return end
