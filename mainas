local function driveId(link)
    if not link or link == "" then return nil end
    return link:match("/file/d/([%w_-]+)")
        or link:match("[?&]id=([%w_-]+)")
        or link:match("/d/([%w_-]+)")
end

local function dlImage(link, name)
    local id = driveId(link)
    if not id then return nil end
    local url = "https://drive.usercontent.google.com/download?id=" .. id .. "&export=download&confirm=t"
    local http = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
    if not (http and writefile) then return nil end
    local ok, res = pcall(function() return http({ Url = url, Method = "GET" }) end)
    if not (ok and res and res.Body and #res.Body > 100) then return nil end
    if res.Body:sub(1, 1) == "<" then return nil end
    local ext = (string.byte(res.Body, 1) == 0x89) and "png" or "jpg"
    local path = name .. "." .. ext
    for _, e in ipairs({ ".png", ".jpg" }) do
        local old = name .. e
        if isfile and isfile(old) then pcall(delfile, old) end
    end
    writefile(path, res.Body)
    local u
    if getcustomasset then
        local ok2, r = pcall(getcustomasset, path)
        if ok2 then u = r end
    end
    if not u and getsynasset then
        local ok3, r = pcall(getsynasset, path)
        if ok3 then u = r end
    end
    return u
end

local function loadCache(name)
    for _, e in ipairs({ ".png", ".jpg" }) do
        local p = name .. e
        if isfile and isfile(p) then
            if getcustomasset then
                local ok, u = pcall(getcustomasset, p)
                if ok and u then return u end
            end
            if getsynasset then
                local ok, u = pcall(getsynasset, p)
                if ok and u then return u end
            end
        end
    end
    return nil
end

