function createSnowEffect(parent, density)
    density = density or 12
    local layer = Instance.new("Frame")
    layer.Name = "SnowLayer"
    layer.Size = UDim2.fromScale(1, 1)
    layer.BackgroundTransparency = 1
    layer.ClipsDescendants = true
    layer.ZIndex = 1
    layer.Parent = parent

        local function spawnFlake()
        if not layer.Parent then return end
        local size = math.random(2, 4)
        local flake = Instance.new("Frame")
        flake.Size = UDim2.fromOffset(size, size)
        flake.Position = UDim2.new(math.random(), 0, -0.05, 0)
        flake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        flake.BackgroundTransparency = math.random(40, 75) / 100
        flake.BorderSizePixel = 0
        flake.ZIndex = 1
        flake.Parent = layer
        Instance.new("UICorner", flake).CornerRadius = UDim.new(1, 0)

        local dur = math.random(40, 80) / 10   -- 4.0 - 8.0s
        local drift = (math.random() - 0.5) * 0.08
        local target = UDim2.new(flake.Position.X.Scale + drift, 0, 1.05, 0)

        local t = tweenService:Create(flake,
            TweenInfo.new(dur, Enum.EasingStyle.Linear),
            { Position = target, Rotation = math.random(-180, 180) })
        t:Play()
        t.Completed:Connect(function()
            flake:Destroy()
            if layer.Parent then
                task.delay(math.random(0, 15) / 10, spawnFlake)
            end
        end)
    end

    for i = 1, density do
        task.delay(math.random(0, 60) / 10, spawnFlake)
    end
end

function makeResizableHudBox(name, defaultPos, defaultSize)
    local f = Instance.new("Frame")
    f.Name = name
    f.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
    f.BackgroundTransparency = 0.15
    f.BorderSizePixel = 0
    f.ClipsDescendants = true
    f.Parent = wmGui

    applyTransform(f, defaultPos, defaultSize)
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    
    local stroke = Instance.new("UIStroke", f)
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.93

    local resizeGrip = Instance.new("ImageButton")
    resizeGrip.Name = "ResizeHandle"
    resizeGrip.Size = UDim2.new(0, 14, 0, 14)
    resizeGrip.Position = UDim2.new(1, -14, 1, -14)
    resizeGrip.BackgroundTransparency = 1
    resizeGrip.Image = "rbxassetid://6031094678"
    resizeGrip.ImageColor3 = C_ACCENT
    resizeGrip.Visible = false
    resizeGrip.ZIndex = 10
    resizeGrip.Parent = f

    local resizing = false
    local startMousePos, startSize

    resizeGrip.MouseButton1Down:Connect(function()
        resizing = true
        startMousePos = userInputService:GetMouseLocation()
        startSize = f.AbsoluteSize
    end)

    userInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            resizing = false
        end
    end)

    userInputService.InputChanged:Connect(function(inp)
        if resizing and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            local currentMouse = userInputService:GetMouseLocation()
            local delta = currentMouse - startMousePos
            local newX = math.max(140, startSize.X + delta.X)
            local newY = math.max(26, startSize.Y + delta.Y)
            f.Size = UDim2.fromOffset(newX, newY)
        end
    end)

    if state.snowEnabled ~= false then
        pcall(createSnowEffect, f, 10)
    end
    return f, resizeGrip
end

