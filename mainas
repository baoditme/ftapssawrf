-- 3) TRIGGERBOT
do
    local trigOn = false
    local trigMode = "All"
    local trigTarget = nil
    local trigRadius = 150
    local trigPredict = 0.12
    local drawing = Drawing and Drawing.new("Circle")
    if drawing then
        drawing.Thickness = 2
        drawing.Color = Color3.fromRGB(255, 100, 100)
        drawing.Filled = false
        drawing.Visible = false
    end

    local function getTarget()
        local cam = workspace.CurrentCamera
        local mouse = userInputService:GetMouseLocation()

        if trigMode == "Single" then
            local p = trigTarget and players:FindFirstChild(trigTarget)
            if p and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local sp, vis = cam:WorldToViewportPoint(hrp.Position)
                    if vis and (Vector2.new(sp.X, sp.Y) - mouse).Magnitude <= trigRadius then
                        return hrp
                    end
                end
            end
            return nil
        end

        local best, bestD = nil, math.huge
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= localPlayer and (not state.isWL or not state.isWL(p)) then
                local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local sp, vis = cam:WorldToViewportPoint(hrp.Position)
                    if vis then
                        local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
                        if d < bestD and d <= trigRadius then
                            best, bestD = hrp, d
                        end
                    end
                end
            end
        end
        return best
    end

    runService.RenderStepped:Connect(function()
        if not drawing then return end
        drawing.Position = userInputService:GetMouseLocation()
        drawing.Radius = trigRadius
        drawing.Visible = trigOn
    end)

    task.spawn(function()
        while gui.Parent do
            task.wait(0.01)
            if trigOn then
                local grp = workspace_:FindFirstChild("GrabParts")
                local dragPart = grp and grp:FindFirstChild("DragPart")
                if dragPart then
                    local tgt = getTarget()
                    if tgt then
                        local pos = tgt.Position
                        if trigPredict > 0 and tgt.AssemblyLinearVelocity.Magnitude > 1 then
                            pos = pos + tgt.AssemblyLinearVelocity * trigPredict
                        end
                        pcall(function() dragPart.Position = pos end)
                    end
                end
            end
        end
    end)

    makeSection(aimTab, "Triggerbot (DragPart)")
    makeToggle(aimTab, "Triggerbot ON/OFF", false, function(on) trigOn = on end)
    makeSlider(aimTab, "Triggerbot Radius", 150, 20, 400, function(v) trigRadius = v end)
    makeSlider(aimTab, "Prediction (s)", 0.12, 0, 0.5, function(v) trigPredict = v end)
    makeDropdown(aimTab, "Trigger Mode", {"All", "Single"}, "All", function(v) trigMode = v end)
    if state.makePlayerDropdown then
        state.makePlayerDropdown(aimTab, "Trigger Target", function(n) trigTarget = n end)
    end
    gui.Destroying:Connect(function()
        trigOn = false
        if drawing then drawing:Remove() end
    end)
end

