do
    local shapeNames = {"Heart", "Star", "Circle", "Square", "Triangle", "Plus", "Infinity"}

    -- Path generators: t in [0, 2*pi] → Vector3 point in 2D plane
    local shapeFunctions = {
        Heart = function(t)
            return Vector3.new(
                16 * math.sin(t)^3,
                13 * math.cos(t) - 5 * math.cos(2*t) - 2 * math.cos(3*t) - math.cos(4*t),
                0
            )
        end,
        Star = function(t)
            local r = 1 + 0.4 * math.cos(5 * t)
            return Vector3.new(math.cos(t) * r * 15, math.sin(t) * r * 15, 0)
        end,
        Circle = function(t)
            return Vector3.new(math.cos(t) * 15, math.sin(t) * 15, 0)
        end,
        Square = function(t)
            local angle = (t % (math.pi * 2)) / (math.pi * 2) * 4
            local side = math.floor(angle)
            local f = angle - side
            local pts = {{-15, -15}, {15, -15}, {15, 15}, {-15, 15}}
            local p1 = pts[side + 1]
            local p2 = pts[(side % 4) + 1]
            return Vector3.new(
                p1[1] + (p2[1] - p1[1]) * f,
                p1[2] + (p2[2] - p1[2]) * f,
                0
            )
        end,
        Triangle = function(t)
            local angle = (t % (math.pi * 2)) / (math.pi * 2) * 3
            local side = math.floor(angle)
            local f = angle - side
            local pts = {{0, 17}, {-15, -10}, {15, -10}}
            local p1 = pts[side + 1]
            local p2 = pts[(side % 3) + 1]
            return Vector3.new(
                p1[1] + (p2[1] - p1[1]) * f,
                p1[2] + (p2[2] - p1[2]) * f,
                0
            )
        end,
        Plus = function(t)
            local angle = (t % (math.pi * 2)) / (math.pi * 2) * 12
            local side = math.floor(angle) % 12
            local f = angle - math.floor(angle)
            local pts = {
                {-4, -17}, {4, -17}, {4, -4}, {17, -4},
                {17, 4}, {4, 4}, {4, 17}, {-4, 17},
                {-4, 4}, {-17, 4}, {-17, -4}, {-4, -4}
            }
            local p1 = pts[side + 1]
            local p2 = pts[(side % 12) + 1]
            return Vector3.new(
                p1[1] + (p2[1] - p1[1]) * f,
                p1[2] + (p2[2] - p1[2]) * f,
                0
            )
        end,
        Infinity = function(t)
            -- Lemniscate (figure-8)
            local a = 18
            local denom = 1 + math.sin(t)^2
            return Vector3.new(
                a * math.cos(t) / denom,
                a * math.sin(t) * math.cos(t) / denom,
                0
            )
        end,
    }

    local shape = {
        enabled = false,
        type = "Heart",
        amount = 10,
        size = 1.5,
        heightOffset = 12,
        rotOffset = 0,
        rotSpeed = 20,
        target = nil,
        handles = {},
        toys = {},
        conns = {},
        phase = 0,
    }

    local function getTargetRoot()
        if shape.target then
            local p = players:FindFirstChild(shape.target)
            if p and p.Character then
                return p.Character:FindFirstChild("HumanoidRootPart")
            end
        end
        local c = localPlayer.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function findToyPart(model)
        return model:FindFirstChild("SoundPart")
            or model:FindFirstChild("Stick")
            or model.PrimaryPart
            or model:FindFirstChildWhichIsA("BasePart")
    end

    local function cleanup()
        shape.enabled = false
        for _, c in ipairs(shape.conns) do pcall(function() c:Disconnect() end) end
        shape.conns = {}
        for _, h in ipairs(shape.handles) do pcall(function() h:Destroy() end) end
        shape.handles = {}
        for _, t in ipairs(shape.toys) do
            if t and t.Parent then
                pcall(function() destroyToyRemote:FireServer(t) end)
            end
        end
        shape.toys = {}
        shape.phase = 0
    end

    local function rebuildHandles(n)
        for _, h in ipairs(shape.handles) do pcall(function() h:Destroy() end) end
        shape.handles = {}
        for _ = 1, n do
            local p = Instance.new("Part")
            p.Name = "RYZE_ShapeHandle"
            p.Anchored = true
            p.CanCollide = false
            p.CanQuery = false
            p.CanTouch = false
            p.Transparency = 1
            p.Size = Vector3.new(1, 1, 1)
            p.Parent = workspace_
            table.insert(shape.handles, p)
