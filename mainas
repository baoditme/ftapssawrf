local flyRef = { conn = nil, bv = nil, bg = nil }
local function stopFly()
    if flyRef.conn then flyRef.conn:Disconnect() flyRef.conn = nil end
    if flyRef.bv then flyRef.bv:Destroy() flyRef.bv = nil end
    if flyRef.bg then flyRef.bg:Destroy() flyRef.bg = nil end
