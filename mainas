-- SILENT AUTO SAVE / LOAD CONFIG (FIXED HOÀN CHỈNH)
-- ==========================================
do
    local FOLDER = "RYZE_Config"
    local FILE = FOLDER .. "/RYZE_ftap_state.json"
    local HttpService = game:GetService("HttpService")

    function ensureFolder()
        pcall(function()
            if isfolder and not isfolder(FOLDER) then makefolder(FOLDER) end
        end)
    end

        function serializeValue(val)
        local t = typeof(val)
        if t == "number" or t == "string" or t == "boolean" then
            return val
        elseif t == "EnumItem" then
            -- ⭐ FIX LỖI: Enum.KeyCode không có .Name, phải dùng tostring và cắt chuỗi
            local enumName = string.gsub(tostring(val.EnumType), "Enum%.", "")
            return {_type = "EnumItem", enum = enumName, name = val.Name}
        elseif t == "Color3" then
            return {_type = "Color3", r = val.R, g = val.G, b = val.B}
        elseif t == "table" then
            local sub = {}
            for k, v in pairs(val) do
                if typeof(v) ~= "Instance" and type(v) ~= "function" then
                    sub[tostring(k)] = serializeValue(v)
                end
            end
            return sub
        end
        return nil
    end

    function deserializeValue(val)
        if type(val) == "table" then
            if val._type == "Color3" then
                return Color3.new(val.r, val.g, val.b)
            elseif val._type == "EnumItem" and Enum[val.enum] and Enum[val.enum][val.name] then
                return Enum[val.enum][val.name]
            else
                local sub = {}
                for k, v in pairs(val) do
                    local realKey = tonumber(k) or k
                    sub[realKey] = deserializeValue(v)
                end
                return sub
            end
        end
        return val
    end

    function saveConfig()
        ensureFolder()
        if not writefile then return end
        local exportData = {}
        for k, v in pairs(state) do
            if k == "session" then continue end
            if typeof(v) ~= "Instance" and type(v) ~= "function" and not tostring(k):find("Conn") then
                exportData[tostring(k)] = serializeValue(v)
            end
        end
        _G.saveConfig = saveConfig
        pcall(function()
            writefile(FILE, HttpService:JSONEncode(exportData))
        end)
    end

    function loadConfig()
        ensureFolder()
        if not (isfile and isfile(FILE)) then return end
        local raw = ""
        local ok = pcall(function() raw = readfile(FILE) end)
        if not ok or not raw or raw == "" then return end

        local success, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
        if not success or type(decoded) ~= "table" then return end

        for k, v in pairs(decoded) do
            local realVal = deserializeValue(v)
            if type(realVal) == "table" and type(state[k]) == "table" then
                for subK, subV in pairs(realVal) do
                    state[k][subK] = subV
                end
            else
                state[k] = realVal
            end
        end

        -- Áp dụng vị trí HUD và Scale ngay lập tức
        task.defer(function()
            if state.hudConfig then
                if wmBox and state.hudConfig.wmPos and state.hudConfig.wmSize then
                    applyTransform(wmBox, state.hudConfig.wmPos, state.hudConfig.wmSize)
                end
                if hotkeyBox and state.hudConfig.hkPos and state.hudConfig.hkSize then
                    applyTransform(hotkeyBox, state.hudConfig.hkPos, state.hudConfig.hkSize)
                end
                if pBox and state.hudConfig.plPos and state.hudConfig.plSize then
                    applyTransform(pBox, state.hudConfig.plPos, state.hudConfig.plSize)
                end
                if statsBox and state.hudConfig.ssPos and state.hudConfig.ssSize then
                    applyTransform(statsBox, state.hudConfig.ssPos, state.hudConfig.ssSize)
                end
                if state.hudVisible then
                    if wmBox then wmBox.Visible = state.hudVisible.wm ~= false end
                    if hotkeyBox then hotkeyBox.Visible = state.hudVisible.hk ~= false end
                    if pBox then pBox.Visible = state.hudVisible.pl ~= false end
                    if statsBox then statsBox.Visible = state.hudVisible.ss ~= false end
                end
            end
            if mainScale and state.menuScale then
                mainScale.Scale = state.menuScale / 100
            end
        end)
        print("[RYZE] Config Loaded!")
    end

    -- Khôi phục cấu hình ngay lập tức khi inject
    loadConfig()

    -- 🟢 FIX QUAN TRỌNG: Lưu config NGAY LẬP TỨC khi tắt GUI (bấm X hoặc Re-inject)
    gui.Destroying:Connect(function()
        if state.autoSaveConfig then
            saveConfig()
        end
    end)

    -- Tự động lưu cấu hình mỗi 3 giây phòng hờ crash
    task.spawn(function()
        while gui.Parent do
            task.wait(3)
            if state.autoSaveConfig then
                saveConfig()
            end
        end
    end)
end

