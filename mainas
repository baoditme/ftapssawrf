do
    local ds = {
        enabled = false,
        loc = CFrame.new(),
        isOffsetted = false,
        _requestActive = false,
        _targetCFFunc = nil,
        _requestTimeout = 5,
        _requestStartTime = 0,
        _spinConn = nil,
        serverCF = nil,
    }

    function ds.GetServerCFrame(self)
        local ch = localPlayer.Character
        if not ch then return nil end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        if self.enabled then
            if self._requestActive and self._targetCFFunc then
                local ok, res = pcall(self._targetCFFunc)
                if ok and typeof(res) == "CFrame" then return res end
            end
            if self.serverCF and typeof(self.serverCF) == "CFrame" then return self.serverCF end
        end
        return hrp.CFrame
    end

    function ds.RequestDesync(self, func, timeout)
        if self._requestActive then return false end
        self._requestActive = true
        self._targetCFFunc = func
        self._requestTimeout = timeout or 5
        self._requestStartTime = tick()
        if not self.enabled then
            self.enabled = true
            if not self._spinConn then
                self._spinConn = runService.Heartbeat:Connect(function()
                    local ch = localPlayer.Character
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    if hrp and ds.enabled then
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0.01, 0)
                    end
                end)
            end
            local ch = localPlayer.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp then self.loc = hrp.CFrame end
        end
        return true
    end

    function ds.CancelRequest(self)
        if not self._requestActive then return end
        self._requestActive = false
        self._targetCFFunc = nil
        self.serverCF = nil
        local ch = localPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if hrp and self.isOffsetted then hrp.CFrame = self.loc end
        self.isOffsetted = false
        self.enabled = false
        task.delay(5, function()
            if self._spinConn and not ds.enabled then
                self._spinConn:Disconnect() self._spinConn = nil
            end
        end)
    end

    function ds.IsAvailable(self) return not self._requestActive end

    runService.Stepped:Connect(function()
        if ds.enabled and ds.isOffsetted and localPlayer.Character then
            local hrp = localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp and ds.loc then hrp.CFrame = ds.loc ds.isOffsetted = false end
        end
    end)

    runService.Heartbeat:Connect(function()
        if not ds.enabled or not localPlayer.Character then return end
        local hrp = localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        ds.loc = hrp.CFrame
        if ds._requestActive and ds._requestStartTime then
            if ds._requestTimeout <= tick() - ds._requestStartTime then
                ds:CancelRequest()
                return
            end
        end
        if ds._requestActive and ds._targetCFFunc then
            local ok, cf = pcall(ds._targetCFFunc)
            if ok and cf then
                hrp.CFrame = cf
                ds.serverCF = cf
                ds.isOffsetted = true
            end
        end
    end)

    _G._NileDesync = ds

    -- ---- Fakepos ----
    state.fakeposOn = false
    local fakePart = nil
