do
    local _L = {
        state = {
            lineActive = false,
            lineThreads = {},
            lineIntensity = 520,
            lineDelay = 1,
            packetActive = false,
            packetTask = nil,
            packetAmount = 900,
        },
    }

    local function _L_startLineLag()
        if _L.state.lineActive then return end
        _L.state.lineActive = true
        local ge = ReplicatedStorage:FindFirstChild("GrabEvents")
        local cgl = ge and ge:FindFirstChild("CreateGrabLine")
        if not cgl then
            Notify("Line Lag", "CreateGrabLine not found.", "warning", 3)
            _L.state.lineActive = false
            return
        end
        local th = coroutine.create(function()
            while _L.state.lineActive do
                local spawnLoc = Workspace:FindFirstChild("SpawnLocation")
                    or Workspace:FindFirstChild("Spawn")
                    or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
                if spawnLoc then
                    local n = _L.state.lineIntensity or 520
                    for _ = 1, n do
                        if _L.state.lineActive then
                            local x = math.random(-2140500000, 2104000001)
                            local z = math.random(-2.11e9, 2101000000)
                            pcall(function() cgl:FireServer(spawnLoc, CFrame.new(x, 0, z)) end)
                            continue
                        end
                        break
                    end
                end
                if _L.state.lineActive then task.wait(_L.state.lineDelay or 1) end
            end
        end)
        table.insert(_L.state.lineThreads, th)
        coroutine.resume(th)
        Notify("Line Lag", "Started.", "info", 2)
    end

    local function _L_stopLineLag()
        _L.state.lineActive = false
        task.wait(0.1)
        for _, t in ipairs(_L.state.lineThreads) do pcall(coroutine.close, t) end
        _L.state.lineThreads = {}
        Notify("Line Lag", "Stopped.", "info", 2)
    end

    local function _L_startPacketLag()
        if _L.state.packetActive then return end
        _L.state.packetActive = true
        local ge = ReplicatedStorage:WaitForChild("GrabEvents", 5)
        local ext = ge and ge:FindFirstChild("ExtendGrabLine")
        if not ext then
            Notify("Packet Lag", "ExtendGrabLine not found.", "warning", 3)
            _L.state.packetActive = false
            return
        end
        _L.state.packetTask = task.spawn(function()
            while _L.state.packetActive do
                pcall(function()
                    ext:FireServer(string.rep("x", _L.state.packetAmount or 900))
                end)
                task.wait()
            end
        end)
        Notify("Packet Lag", "Started.", "info", 2)
    end

    local function _L_stopPacketLag()
        _L.state.packetActive = false
        if _L.state.packetTask then
            pcall(function() task.cancel(_L.state.packetTask) end)
            _L.state.packetTask = nil
        end
        Notify("Packet Lag", "Stopped.", "info", 2)
    end

    FunTab:CreateSection("Lag Tools")

    FunTab:CreateSlider({
        Name = "Line Lag Intensity",
        Default = 520, Min = 1, Max = 2000,
        Callback = function(v) _L.state.lineIntensity = v end,
    })
    FunTab:CreateSlider({
        Name = "Line Lag Delay (s)",
        Default = 1, Min = 0.1, Max = 5,
        Callback = function(v) _L.state.lineDelay = v end,
    })
    FunTab:CreateToggle({
        Name = "Line Lag",
        Default = false,
        Callback = function(on)
            if on then _L_startLineLag() else _L_stopLineLag() end
        end,
    })

    FunTab:CreateSlider({
        Name = "Packet Lag Amount",
        Default = 900, Min = 10, Max = 5000,
        Callback = function(v) _L.state.packetAmount = v end,
    })
    FunTab:CreateToggle({
        Name = "Packet Lag",
        Default = false,
        Callback = function(on)
            if on then _L_startPacketLag() else _L_stopPacketLag() end
        end,
    })
end



