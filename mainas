    Fun.startHeadThrow = function(char)
        Fun.stopPose()
        local rootPart = char:WaitForChild("HumanoidRootPart")
        local humanoid = char:WaitForChild("Humanoid")
        local head = char:FindFirstChild("Head")
        Fun.RagdollRemote:FireServer(rootPart, 9999999)
        local movePos = rootPart.Position
        local walkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
        local isThrowing, throwProgress, headStartPos = false, 0, nil
        Fun.activeMode = "dance"
        Fun.poseConnection = Fun.RunService.Heartbeat:Connect(function(dt)
            if not char or not char.Parent or not rootPart or not rootPart.Parent then Fun.stopPose() return end
            local look = Fun.camera.CFrame.LookVector
            local yaw = math.atan2(-look.X, -look.Z)
            local pos = rootPart.Position
            if (pos - movePos).Magnitude > 8 then movePos = pos end
            local moveDir = humanoid.MoveDirection
            if moveDir.Magnitude > 0.01 then movePos = movePos + moveDir * walkSpeed * dt end
            local targetCF = CFrame.new(movePos) * CFrame.Angles(0, yaw, 0)
            rootPart.CFrame = targetCF
            if not isThrowing then
                throwProgress = throwProgress + dt * 1.5
                if throwProgress >= 1 then
                    isThrowing = true throwProgress = 0
                    if head then headStartPos = head.Position end
                end
            else
                throwProgress = throwProgress + dt * 4
                if throwProgress >= 1 then
                    isThrowing = false throwProgress = 0
                    if head then
                        head.CFrame = targetCF * CFrame.new(0, 1.5, 0)
                        head.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
            local armAng, armPos, headOff, lean = 0, 0, 0, 0
            if not isThrowing then
                local s = throwProgress * throwProgress * (3 - 2 * throwProgress)
                armAng = -2.094 * s armPos = s * 0.8 headOff = s * 0.5 lean = 0.2618 * s
            else
                local s = throwProgress * throwProgress * (3 - 2 * throwProgress)
                armAng = -2.094 + 3.14159 * s armPos = 0.8 - s * 1.5 headOff = 0.5 lean = 0.2618 - 0.5236 * s
            end
            local offsets = {
                Torso = CFrame.new(0, 0, 0) * CFrame.Angles(lean, 0, 0),
                Head = CFrame.new(0, 1.5 + headOff, 0),
                ["Left Arm"] = CFrame.new(-1.5, 1, 0) * CFrame.Angles(armAng, 0, 0.1745) * CFrame.new(0, -1 + armPos, 0),
                ["Right Arm"] = CFrame.new(1.5, 1, 0) * CFrame.Angles(armAng, 0, -0.1745) * CFrame.new(0, -1 + armPos, 0),
                ["Left Leg"] = CFrame.new(-0.5, -2, 0), ["Right Leg"] = CFrame.new(0.5, -2, 0),
            }
            for k, v in pairs(offsets) do
                local part = char:FindFirstChild(k)
                if part and part:IsA("BasePart") and part ~= head then
                    part.CFrame = targetCF * v
                    part.AssemblyLinearVelocity = Vector3.zero
                end
            end
            if head and isThrowing then
                local startPos = headStartPos or (targetCF * CFrame.new(0, 1.5, 0)).Position
                local targetPos = startPos + targetCF.LookVector * 200 * throwProgress * throwProgress
                head.CFrame = CFrame.new(targetPos)
                head.AssemblyLinearVelocity = Vector3.zero
            end
        end)
    end

