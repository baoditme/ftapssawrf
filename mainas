-- ==========================================
-- WATERMARK: FPS + PING + SERVER LAG
-- ==========================================
local Stats = game:GetService("Stats")
local pingItem = Stats.Network.ServerStatsItem["Data Ping"]

local wmFrames, wmLast = 0, tick()
local hbAccum, hbCount, hbLast = 0, 0, tick()

-- Đo tần số Heartbeat (proxy cho server lag)
runService.Heartbeat:Connect(function()
    local now = tick()
    local dt = now - hbLast
    hbLast = now
    if dt > 0 and dt < 0.5 then  -- bỏ spike do client freeze
        hbAccum = hbAccum + dt
        hbCount = hbCount + 1
    end
end)

runService.RenderStepped:Connect(function()
    if not wmGui.Enabled then return end
    wmFrames = wmFrames + 1
    if tick() - wmLast >= 1 then
        -- Ping (ms)
        local ping = 0
        pcall(function() ping = math.floor(pingItem:GetValue()) end)

        -- Server Hz (60 = bình thường)
        local hz = 60
        if hbCount > 0 then
            hz = math.floor(hbCount / hbAccum + 0.5)
            if hz > 60 then hz = 60 end
        end
        hbAccum, hbCount = 0, 0

        -- Nhãn ping
        local pTxt
        if ping >= 250 then      pTxt = "!!"
        elseif ping >= 150 then  pTxt = "HIGH"
        elseif ping >= 80 then   pTxt = "~"
        else                     pTxt = "OK" end

        -- Nhãn server lag
        local sTxt
        if hz < 20 then          sTxt = "!!"
        elseif hz < 40 then      sTxt = "LAG"
        elseif hz < 55 then      sTxt = "~"
        else                     sTxt = "OK" end

        wmLbl.Text = string.format(
            "RYZE FTAP  |  %d FPS  |  Ping %dms [%s]  |  Srv %dHz [%s]  |  %dP",
            wmFrames, ping, pTxt, hz, sTxt, #players:GetPlayers()
        )
        wmFrames, wmLast = 0, tick()
    end
end)

