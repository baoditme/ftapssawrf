                            cg:FireServer(rightDet, tHrp, rw)
                        end
                    end)
                end
            end
        else
            flag = false
            n2 = 0
        end
        runService.Heartbeat:Wait()
    end
    if useSkyMode then _removeSkyKickFloor() end
end

