function createSnowEffect(parent, density)
    density = density or 12
    local layer = Instance.new("Frame")
    layer.Name = "SnowLayer"
    layer.Size = UDim2.fromScale(1, 1)
    layer.BackgroundTransparency = 1
    layer.ClipsDescendants = true
    layer.ZIndex = 1
    layer.Parent = parent

        local function spawnFlake()
        if not layer.Parent then return end
        local size = math.random(2, 4)
        local flake = Instance.new("Frame")
        flake.Size = UDim2.fromOffset(size, size)
        flake.Position = UDim2.new(math.random(), 0, -0.05, 0)
        flake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        flake.BackgroundTransparency = math.random(40, 75) / 100
        flake.BorderSizePixel = 0
        flake.ZIndex = 1
        flake.Parent = layer
        Instance.new("UICorner", flake).CornerRadius = UDim.new(1, 0)

        local dur = math.random(40, 80) / 10   -- 4.0 - 8.0s
        local drift = (math.random() - 0.5) * 0.08
        local target = UDim2.new(flake.Position.X.Scale + drift, 0, 1.05, 0)

        local t = tweenService:Create(flake,
            TweenInfo.new(dur, Enum.EasingStyle.Linear),
            { Position = target, Rotation = math.random(-180, 180) })
        t:Play()
        t.Completed:Connect(function()
            flake:Destroy()
            if layer.Parent then
                task.delay(math.random(0, 15) / 10, spawnFlake)
            end
        end)
    end

    for i = 1, density do
        task.delay(math.random(0, 60) / 10, spawnFlake)
    end
end

