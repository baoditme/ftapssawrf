-- ---------- Shared helpers ----------
function _G.NileColorPicker(parent, text, default, cb)
    local fr = Instance.new("Frame")
    fr.Size = UDim2.new(1, 0, 0, 76)
    fr.BackgroundColor3 = BG3
    fr.BorderSizePixel = 0
    fr.Parent = parent
    Instance.new("UICorner", fr).CornerRadius = UDim.new(0, 6)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -90, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = TEXT
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = fr
    local prev = Instance.new("Frame")
    prev.Size = UDim2.new(0, 70, 0, 18)
    prev.Position = UDim2.new(1, -80, 0, 4)
    prev.BackgroundColor3 = default
    prev.BorderSizePixel = 0
    prev.Parent = fr
    Instance.new("UICorner", prev).CornerRadius = UDim.new(0, 4)
    local cur = {math.floor(default.R*255+0.5), math.floor(default.G*255+0.5), math.floor(default.B*255+0.5)}
    local labels = {}
    local sCol = {Color3.fromRGB(255,80,80), Color3.fromRGB(80,255,80), Color3.fromRGB(80,80,255)}
    local sLbl = {"R", "G", "B"}
    function refresh()
        prev.BackgroundColor3 = Color3.fromRGB(cur[1], cur[2], cur[3])
        for i=1,3 do if labels[i] then labels[i].Text = tostring(cur[i]) end end
        if cb then pcall(cb, prev.BackgroundColor3) end
    end
    for i=1,3 do
        local yOff = 24 + (i-1)*17
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -20, 0, 14)
        row.Position = UDim2.new(0, 10, 0, yOff)
        row.BackgroundTransparency = 1
        row.Parent = fr
        local rl = Instance.new("TextLabel")
        rl.Size = UDim2.new(0, 14, 1, 0)
        rl.BackgroundTransparency = 1
        rl.Text = sLbl[i]
        rl.TextColor3 = sCol[i]
        rl.Font = Enum.Font.GothamBold
        rl.TextSize = 10
        rl.Parent = row
        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, -66, 0, 6)
        bar.Position = UDim2.new(0, 16, 0.5, -3)
        bar.BackgroundColor3 = BG
        bar.BorderSizePixel = 0
        bar.Parent = row
        Instance.new("UICorner", bar).CornerRadius = UDim.new(1,0)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(cur[i]/255, 0, 1, 0)
        fill.BackgroundColor3 = sCol[i]
        fill.BorderSizePixel = 0
        fill.Parent = bar
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)
        local vlbl = Instance.new("TextLabel")
        vlbl.Size = UDim2.new(0, 34, 1, 0)
        vlbl.Position = UDim2.new(1, -38, 0, 0)
        vlbl.BackgroundTransparency = 1
        vlbl.Text = tostring(cur[i])
        vlbl.TextColor3 = TEXT
        vlbl.Font = Enum.Font.GothamBold
        vlbl.TextSize = 10
        vlbl.TextXAlignment = Enum.TextXAlignment.Right
        vlbl.Parent = row
        labels[i] = vlbl
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.Parent = bar
        local dragging, idx = false, i
        function upd(mx)
            local abs = bar.AbsolutePosition.X
            local sz = bar.AbsoluteSize.X
            if sz <= 0 then return end
            local p = math.clamp((mx-abs)/sz, 0, 1)
            cur[idx] = math.floor(p*255+0.5)
            fill.Size = UDim2.new(p, 0, 1, 0)
            refresh()
        end
        btn.MouseButton1Down:Connect(function() dragging = true end)
        userInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        userInputService.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then upd(inp.Position.X) end
        end)
    end
    return fr
end

function _G.NileKeybind(parent, text, default, cb)
    local btn = makeButton(parent, text .. ": " .. default.Name, function() end)
    local waiting = false
    btn.MouseButton1Click:Connect(function()
        waiting = true
        btn.Text = text .. ": ..."
    end)
    userInputService.InputBegan:Connect(function(i, gp)
        if waiting and i.UserInputType == Enum.UserInputType.Keyboard then
            waiting = false
            btn.Text = text .. ": " .. i.KeyCode.Name
            cb(i.KeyCode)
            if _G.QueueSave then _G.QueueSave() end
        end
    end)
    cb(default)
    return btn
end

