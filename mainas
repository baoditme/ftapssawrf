-- ==========================================
do
    local foodOn = false
    local instOn = false
    local foodTask, instTask = nil, nil
    local foodHeld = {}
    local instHeld = {}
    local foodFailed = {}
    local instFailed = {}

    local foodModels = {
        "FoodDonut","FoodBread","FoodBanana","FoodBroccoli","FoodCakePink",
        "FoodCoconut","FoodDippyEgg","FoodFrenchFries","FoodHamburger",
        "FoodHotdog","FoodMayonnaise","FoodMeatStick","FoodMushroomPoison",
        "FoodPizzaCheese","FoodPizzaPepperoni","FoodSodaCan","PoopPile",
        "PoopPileSparkle","CupMugWhite","CupMugBrown",
    }
    local instModels = {
        "InstrumentBrassBugle","InstrumentBrassTrumpet","InstrumentBrassVuvuzela",
        "InstrumentDrumBongos","InstrumentDrumSnare","InstrumentGuitarAcoustic",
        "InstrumentGuitarBanjo","InstrumentGuitarLyre","InstrumentGuitarUkulele",
        "InstrumentGuitarViolin","InstrumentPianoKeyboard","InstrumentPianoMelodica",
        "InstrumentVoiceMicrophone","InstrumentWoodwindOcarina","InstrumentWoodwindSaxophone",
    }

    local function isIn(list, name)
        for _, n in ipairs(list) do
            if n == name then return true end
        end
        return false
    end

    local function scanToys(list)
        local out = {}
        for _, root in ipairs(workspace_:GetChildren()) do
            if root:IsA("Model") and isIn(list, root.Name) and root:FindFirstChild("HoldPart") then
                table.insert(out, root)
            end
            if root:IsA("Folder") then
                for _, c in ipairs(root:GetChildren()) do
                    if c:IsA("Model") and isIn(list, c.Name) and c:FindFirstChild("HoldPart") then
                        table.insert(out, c)
                    end
                end
            end
        end
        return out
    end

    local function holdOne(toy, held, failed)
        if not toy or not toy.Parent then return false end
        if failed[toy] and tick() - failed[toy] < 5 then return false end
        local hp = toy:FindFirstChild("HoldPart")
        if not hp then return false end
        local hold = hp:FindFirstChild("HoldItemRemoteFunction")
        if not hold then return false end
        local char = localPlayer.Character
        if not char then return false end
        local ok = pcall(function() hold:InvokeServer(toy, char) end)
        if not ok then
            failed[toy] = tick()
            return false
        end
        task.wait(0.03)
        local rs = game:GetService("ReplicatedStorage")
        local he = rs:FindFirstChild("HoldEvents")
        local use = he and he:FindFirstChild("Use")
        if use then pcall(function() use:FireServer(toy) end) end
        held[toy] = tick()
        failed[toy] = nil
        return true
    end

    local function dropOne(toy, held)
        if not toy or not toy.Parent then held[toy] = nil return end
        local hp = toy:FindFirstChild("HoldPart")
        if not hp then held[toy] = nil return end
        local drop = hp:FindFirstChild("DropItemRemoteFunction")
        if drop then
            pcall(function()
                drop:InvokeServer(toy, CFrame.new(0, -500, 0), Vector3.new(0, 97.69, 0))
            end)
        end
        held[toy] = nil
    end

    local function loop(list, held, failed, isOn)
        local lastTick, lastCleanup = 0, 0
        while isOn() do
            local now = tick()
            if now - lastTick < 0.4 then
                task.wait()
            else
                lastTick = now
                if now - lastCleanup > 3 then
                    for k in pairs(held) do
                        if not k or not k.Parent then held[k] = nil end
                    end
                    for k, v in pairs(failed) do
                        if not k or not k.Parent or now - v > 10 then failed[k] = nil end
                    end
                    lastCleanup = now
                end

                local toys = scanToys(list)
                local grabbed = 0
                for _, t in ipairs(toys) do
                    if grabbed >= 10 then break end
                    if not held[t] and holdOne(t, held, failed) then
                        grabbed = grabbed + 1
                    end
                end

                local dropped = 0
                for k, v in pairs(held) do
                    if dropped >= 5 then break end
                    if k.Parent and now - v >= 2.7 then
                        dropOne(k, held)
                        dropped = dropped + 1
                    elseif not k.Parent then
                        held[k] = nil
                    end
                end
                task.wait()
            end
        end
    end

    makeSection(funTab, "Hold Aura")
    makeToggle(funTab, "Eat All Food", false, function(v)
        foodOn = v
        if not v then
            foodHeld = {}
            foodFailed = {}
        else
            foodHeld = {}
            foodFailed = {}
            if foodTask then task.cancel(foodTask) end
            foodTask = task.spawn(function()
                loop(foodModels, foodHeld, foodFailed, function() return foodOn end)
            end)
        end
    end)
    makeToggle(funTab, "Use All Instruments", false, function(v)
        instOn = v
        if not v then
            instHeld = {}
            instFailed = {}
        else
            instHeld = {}
            instFailed = {}
            if instTask then task.cancel(instTask) end
            instTask = task.spawn(function()
                loop(instModels, instHeld, instFailed, function() return instOn end)
            end)
        end
    end)
    gui.Destroying:Connect(function()
        foodOn = false
        instOn = false
    end)
end

