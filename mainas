local function _gkaGrab(blob, target)
    if not blob or not blob.Parent or not target then return end
    for _, side in ipairs({"Left", "Right"}) do
        local det = blob:FindFirstChild(side .. "Detector")
        local weld = det and det:FindFirstChild(side .. "Weld")
        local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
        local cg = script and script:FindFirstChild("CreatureGrab")
        if det and weld and cg then
            pcall(function() cg:FireServer(det, target, weld) end)
        end
    end
end

local function _gkaRere(blob, target)
    if not blob or not blob.Parent or not target then return end
    for _, side in ipairs({"Left", "Right"}) do
        local det = blob:FindFirstChild(side .. "Detector")
        local weld = det and det:FindFirstChild(side .. "Weld")
        local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
        local cr = script and script:FindFirstChild("CreatureRelease")
        if weld and cr then
            pcall(function() cr:FireServer(weld, target) end)
        end
    end
end

local function _gkaDrop(blob, target)
    if not blob or not blob.Parent or not target then return end
    for _, side in ipairs({"Left", "Right"}) do
        local det = blob:FindFirstChild(side .. "Detector")
        local weld = det and det:FindFirstChild(side .. "Weld")
        local script = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
        local cd = script and script:FindFirstChild("CreatureDrop")
        if weld and cd then
            pcall(function() cd:FireServer(weld, target) end)
        end
    end
end

local function _gkaUngrab(target)
    if target and destroyGrabLine then
        pcall(function() destroyGrabLine:FireServer(target) end)
    end
end

