do
function getExecutorName()
    local ok, name = pcall(function() return identifyexecutor and identifyexecutor() or "Unknown" end)
    return ok and tostring(name) or "Unknown"
end

function matchList(str, list)
    local s = tostring(str):lower()
    for _, x in ipairs(list) do
        if s:find(x, 1, true) then return true end
    end
    return false
end

local executorName = getExecutorName()
local PC_EXECS = {"xeno","solara","synapse","scriptware","sirhurt","krnl","electron","owl","nihon","macsploit","swift","samsung","valyse"}
local MOBILE_EXECS = {"delta","codex","arceus","hydrogen","cryptic","frost","trigon","vega","calamari","bloxhub","fluxus"}

local isPCExec = matchList(executorName, PC_EXECS)
local isMobileExec = matchList(executorName, MOBILE_EXECS)
    or (userInputService.TouchEnabled and not userInputService.MouseEnabled)

function testHookSupport()
    if not (hookmetamethod and newcclosure and getnamecallmethod) then
        return false, "hookmetamethod missing"
    end
    local ok = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            return old(self, ...)
        end))
    end)
    return ok, ok and "hook works" or "hook call failed"
end

local hookOK, hookMsg = testHookSupport()

-- Rule: PC executors blocked. Mobile/Unknown: use if hook works.
local allowHook = false
if not isPCExec or isMobileExec then
    allowHook = hookOK
end

Notify("Executor", string.format("%s | Mobile=%s | Hook=%s",
    executorName, tostring(isMobileExec), tostring(allowHook)), "info", 5)
print(string.format("[RYZE] Executor: %s | PC=%s | Mobile=%s | hookOK=%s (%s)",
    executorName, tostring(isPCExec), tostring(isMobileExec), tostring(hookOK), hookMsg))

