                    pcall(function() setNetworkOwner:FireServer(s.part, cf) end)
                    s.bp.Position = cf.Position
                    s.bg.CFrame = cf
                end
            end
        end))
        pcall(Notify, "Shield", "ON", "success", 2)
    end

    local function shieldObey(slot, targetPart)
        if not slot or not slot.part or not slot.part.Parent then return end
        slot.launched = true
        if slot.bp then slot.bp.MaxForce = Vector3.zero end
        if slot.bg then slot.bg.MaxTorque = Vector3.zero end
        task.spawn(function()
            local btn = slot.model and slot.model:FindFirstChild("Button")
            if btn then pcall(function() setNetworkOwner:FireServer(btn, btn.CFrame) end); task.wait(0.05) end
            pcall(function() setNetworkOwner:FireServer(slot.part, slot.part.CFrame) end); task.wait(0.05)
