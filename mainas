-- MODULE 10: ESP (Server / Sticky / Blackhole)
-- ==========================================
do
    state.serverESP = false
    state.serverESPColor = Color3.fromRGB(255, 20, 147)
    state.serverESPOutline = Color3.fromRGB(0, 0, 0)
    state.lowerPCLD = true
    state.stickyESP = false
    state.stickyESPColor = Color3.fromRGB(255, 0, 0)
    state.blackholeESP = false
    state.blackholeESPColor = Color3.fromRGB(0, 255, 255)

    local cache = {}

    function setHL(adornee, key, fill, outline, fillT)
        if not adornee then return end
        local hl = cache[key]
        if not hl or not hl.Parent then
            hl = Instance.new("Highlight")
            hl.Name = "_nileESP_" .. key
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = fillT or 0.35
            hl.OutlineTransparency = 0
            hl.Parent = adornee
            cache[key] = hl
        end
        hl.Adornee = adornee
        hl.FillColor = fill
        hl.OutlineColor = outline
    end

    function clearHL(key)
        local hl = cache[key]
        if hl then pcall(function() hl:Destroy() end) cache[key] = nil end
    end

    task.spawn(function()
        while gui.Parent do
            task.wait(0.2)
            -- Auto-lower PCLD
            if state.lowerPCLD and localPlayer.Character then
                local pcld = localPlayer.Character:FindFirstChild("PCLD") or localPlayer.Character:FindFirstChild("PCID")
                if pcld and pcld:IsA("BasePart") then
                    pcld.CanCollide = false
                    local hrp = localPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then pcld.CFrame = hrp.CFrame * CFrame.new(0, -4, 0) end
                end
            end
            -- Server ESP
            for _, p in ipairs(players:GetPlayers()) do
                if p ~= localPlayer and p.Character then
                    local ch = p.Character
                    local key = "S_" .. p.UserId
                    if state.serverESP then
                        local pcld = ch:FindFirstChild("PCLD") or ch:FindFirstChild("PCID")
                        if pcld and pcld:IsA("BasePart") then
                            setHL(pcld, key, state.serverESPColor, state.serverESPOutline, 0.3)
                        end
                    else
                        clearHL(key)
                    end
                end
            end
            -- Sticky ESP
            local stickySet = {}
            if state.stickyESP then
                for _, p in ipairs(players:GetPlayers()) do
                    local folder = workspace_:FindFirstChild(p.Name .. "SpawnedInToys")
                    if folder then
                        for _, toy in ipairs(folder:GetChildren()) do
                            local sp = toy:FindFirstChild("StickyPart", true)
                            if sp and sp:IsA("BasePart") then
                                local key = "ST_" .. tostring(sp)
                                stickySet[key] = true
                                setHL(sp, key, state.stickyESPColor, Color3.new(1,1,1), 0.3)
                            end
                        end
                    end
                end
