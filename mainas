-- MODULE 14: JET (F-22 RAPTOR)
-- ==========================================
do
    state.jetSpawnKey = Enum.KeyCode.J
    state.jetBoostKey = Enum.KeyCode.F
    state.jetSpeedMult = 1

    local jetRoot = nil
    local jetModel = nil
    local seated = false
    local flightConn = nil
    local bv, bg, weld = nil, nil, nil
    local pitch, roll = 0, 0
    local wDown, sDown, aDown, dDown = false, false, false, false
    local boosting = false

    function spawnJet()
        if jetRoot and jetRoot.Parent then return end
        local ch = localPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local cam = workspace.CurrentCamera
        local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
        if look.Magnitude < 0.01 then look = hrp.CFrame.LookVector end
        local spawnPos = hrp.Position + look.Unit * 12 + Vector3.new(0, 3, 0)
        local cf = CFrame.new(spawnPos, spawnPos + look.Unit)

        jetRoot = Instance.new("Part")
        jetRoot.Name = "_JetPhysicsRoot"
        jetRoot.Size = Vector3.new(4, 1, 8)
        jetRoot.Transparency = 1
        jetRoot.CanCollide = false
        jetRoot.Massless = true
        jetRoot.CFrame = cf
        jetRoot.Parent = workspace_

        local ok, objs = pcall(function() return game:GetObjects("rbxassetid://18152799439") end)
        if not ok or not objs or not objs[1] then
            jetRoot:Destroy() jetRoot = nil
            Notify("JET", "Không tải được asset F-22", "kick", 3)
            return
        end
        jetModel = objs[1]
        jetModel.Parent = workspace_
        pcall(function() jetModel:PivotTo(cf) end)
        pcall(function()
            local gear = workspace_["[Aeolus-V4] F-22 Raptor"].Misc.LandingGear
            if gear then gear:Destroy() end
        end)
        for _, d in ipairs(jetModel:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Massless = true
                d.Anchored = false
                local w = Instance.new("WeldConstraint")
                w.Part0 = jetRoot
                w.Part1 = d
                w.Parent = jetRoot
            end
        end
        Notify("JET", "F-22 spawned", "success", 2)
    end

    function removeJet()
        if weld then pcall(function() weld:Destroy() end) weld = nil end
        if bv then pcall(function() bv:Destroy() end) bv = nil end
        if bg then pcall(function() bg:Destroy() end) bg = nil end
        if flightConn then pcall(function() flightConn:Disconnect() end) flightConn = nil end
        if jetModel then pcall(function() jetModel:Destroy() end) jetModel = nil end
        if jetRoot then pcall(function() jetRoot:Destroy() end) jetRoot = nil end
        local ch = localPlayer.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if hum then hum.Sit = false end
        seated = false
    end

    function seatJet()
        if seated or not jetRoot or not jetRoot.Parent then return end
        local ch = localPlayer.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        hrp.CFrame = jetRoot.CFrame * CFrame.new(0, 3, 0)
        hum.Sit = true
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e6,1e6,1e6)
        bv.Velocity = Vector3.zero
        bv.P = 1000
        bv.Parent = hrp
        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(1e6,1e6,1e6)
        bg.P = 800
        bg.D = 300
        bg.CFrame = hrp.CFrame
        bg.Parent = hrp
        weld = Instance.new("Weld")
        weld.Part0 = hrp
        weld.Part1 = jetRoot
        weld.C0 = CFrame.new(0, -5, 10)
        weld.Parent = hrp
        seated = true

        flightConn = runService.Heartbeat:Connect(function(dt)
            if not seated or not hrp or not hrp.Parent or not jetRoot or not jetRoot.Parent then
                if flightConn then flightConn:Disconnect() flightConn = false end
                return
            end
            local hum2 = ch and ch:FindFirstChildOfClass("Humanoid")
            if hum2 and not hum2.Sit then hum2.Sit = true end

            -- pitch/roll smoothing
            local pTarget = wDown and 0.5 or (sDown and -0.5 or 0)
            local rTarget = aDown and 0.5 or (dDown and -0.5 or 0)
            pitch = pitch + (pTarget - pitch) * math.min(dt*4, 1)
            roll = roll + (rTarget - roll) * math.min(dt*4, 1)

            local cam = workspace.CurrentCamera
            local camCF = cam.CFrame
            local look = camCF.LookVector
            local right = camCF.RightVector
            local fwd = Vector3.new(look.X, 0, look.Z)
            if fwd.Magnitude > 0.01 then fwd = fwd.Unit end
            local base = CFrame.new(hrp.Position, hrp.Position + fwd)
            local goal = base * CFrame.Angles(pitch, 0, roll)
            bg.CFrame = bg.CFrame:Lerp(goal, math.min(dt*8, 1))

            local speed = 300 * state.jetSpeedMult * (boosting and 2.5 or 1)
            local dir = (bg.CFrame.LookVector + Vector3.new(0, pitch * 2, 0)).Unit
            bv.Velocity = dir * speed * math.max(math.abs(pitch) * 2 + 0.15, 0.15)
        end)
        Notify("JET", "Đã ngồi vào F-22", "success", 2)
    end

    function toggleJet()
        if seated then
            removeJet()
            Notify("JET", "Đã rời F-22", "info", 2)
        else
            if not jetRoot or not jetRoot.Parent then spawnJet() end
            task.wait(0.15)
            seatJet()
        end
    end

    -- Keybinds
    local boostKey = Enum.KeyCode.F
    userInputService.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.UserInputType == Enum.UserInputType.Keyboard and state.jetSpawnKey and state.jetSpawnKey ~= Enum.KeyCode.Unknown and i.KeyCode == state.jetSpawnKey then toggleJet() end
        if i.KeyCode == state.jetBoostKey and seated then boosting = true end
        if i.KeyCode == Enum.KeyCode.W then wDown = true end
        if i.KeyCode == Enum.KeyCode.S then sDown = true end
        if i.KeyCode == Enum.KeyCode.A then aDown = true end
        if i.KeyCode == Enum.KeyCode.D then dDown = true end
    end)
    userInputService.InputEnded:Connect(function(i)
        if i.KeyCode == state.jetBoostKey then boosting = false end
        if i.KeyCode == Enum.KeyCode.W then wDown = false end
        if i.KeyCode == Enum.KeyCode.S then sDown = false end
        if i.KeyCode == Enum.KeyCode.A then aDown = false end
        if i.KeyCode == Enum.KeyCode.D then dDown = false end
    end)
    userInputService.JumpRequest:Connect(function()
        if seated then toggleJet() end
    end)

    localPlayer.CharacterAdded:Connect(function()
        removeJet()
    end)
    gui.Destroying:Connect(removeJet)

    makeSection(mainTab, "JET (F-22 Raptor)")
    makeButton(mainTab, "Spawn + Mount F-22", function() toggleJet() end)
    makeButton(mainTab, "Dismount / Destroy Jet", function() removeJet() end)
    makeSlider(mainTab, "Jet Speed Multiplier", 1, 0.5, 5, function(v) state.jetSpeedMult = v end)
    _G.NileKeybind(mainTab, "Spawn Toggle Key", Enum.KeyCode.J, function(k) state.jetSpawnKey = k end)
    _G.NileKeybind(mainTab, "Boost Key (hold)", Enum.KeyCode.F, function(k) state.jetBoostKey = k end)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 44)
    lbl.BackgroundColor3 = BG3
    lbl.TextColor3 = TEXT2
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 11
    lbl.TextWrapped = true
    lbl.Text = "W/S: pitch up/down  |  A/D: roll  |  F (hold): boost  |  Space: dismount"
    lbl.Parent = mainTab
    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 6)
end



