-- Kiểm tra bị grab ở BẤT KỲ bộ phận R6 nào (không chỉ Head)
function isBeingGrabbedR6(char)
    if isHeld and isHeld.Value then return true end
    if not char then return false end
    for _, name in ipairs(R6_PARTS) do
        local p = char:FindFirstChild(name)
        local po = p and p:FindFirstChild("PartOwner")
        if po and po.Value ~= localPlayer.Name then return true end
    end
    return false
end

-- Tắt CanCollide của RagdollLimbPart trong 4 chi R6 (chống văng khi nổ)
