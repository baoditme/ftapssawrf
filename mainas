-- Helper: lấy tất cả target còn sống trong server
local function _bypassGetAll()
    local out = {}
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local skip = false
            if state._bypassExcludeFriends then
                local ok, isFriend = pcall(function() return localPlayer:IsFriendsWith(p.UserId) end)
                if ok and isFriend then skip = true end
            end
            if not skip and state._bypassExcludeWhitelist and state.isWL and state.isWL(p) then
                skip = true
            end
            if not skip then
                local char = p.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    table.insert(out, {player = p, char = char, hrp = hrp, hum = hum})
                end
            end
        end
    end
    return out
end

-- Helper: worker loop với tick rate
local function _bypassWorker(stateKey, workerFunc)
    if state[stateKey] then
        pcall(function() task.cancel(state[stateKey]) end)
        state[stateKey] = nil
    end
    return task.spawn(function()
        while state["_bypass" .. stateKey:gsub("_bypass", "") .. "On"] do
            local list = _bypassGetAll()
            for _, t in ipairs(list) do
                if not state["_bypass" .. stateKey:gsub("_bypass", "") .. "On"] then break end
                pcall(workerFunc, t)
            end
            task.wait(state._bypassTickRate or 0.15)
        end
    end)
end

