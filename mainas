        if not (canSpawn and canSpawn.Value) or (inPlot and inPlot.Value) then return nil end

        pcall(function()
            spawnToyRemote:InvokeServer("NinjaKunai",
                hrp.CFrame * CFrame.new(0, 0, 10),
                Vector3.new(0, 90, 0))
        end)
        task.wait(0.3)
        return folder:FindFirstChild("NinjaKunai")
    end

    local function attachKunai(k)
        local sp = k:FindFirstChild("StickyPart")
        if not sp then return false end
        local weld = sp:FindFirstChild("StickyWeld")
        if not weld then return false end
        local char = localPlayer.Character
        if not char then return false end
        local target = char:FindFirstChild("Left Leg") or char:FindFirstChild("Torso")
        if not target then return false end

        for _ = 1, 8 do
            local po = sp:FindFirstChild("PartOwner")
            if po and po.Value == localPlayer.Name then break end
            pcall(function() setNetworkOwner:FireServer(sp, sp.CFrame) end)
            task.wait(0.05)
        end

        pcall(function()
            stickyPartEvent:FireServer(sp, target, CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(90), math.rad(90)))
        end)
        for _, obj in ipairs(k:GetChildren()) do
            if obj.Name == "Pyramid" then
                obj.CanTouch = false obj.CanCollide = false obj.CanQuery = false obj.Transparency = 0
                if not obj:FindFirstChild("Highlight") then
                    local hl = Instance.new("Highlight", obj)
                    hl.FillColor = Color3.fromRGB(0, 0, 0)
                end
            elseif obj.Name == "Main" then
                obj.CanTouch = false obj.CanCollide = false obj.CanQuery = false obj.Transparency = 0
                if not obj:FindFirstChild("Highlight") then
                    local hl = Instance.new("Highlight", obj)
                    hl.FillColor = Color3.fromRGB(255, 255, 255)
                end
            elseif obj:IsA("BasePart") then
                obj.CanTouch = false obj.CanCollide = false obj.CanQuery = false obj.Transparency = 1
            end
        end
        task.wait(0.2)
        return checkKunaiState(k) == "attached"
    end

    local function stop()
        on = false
        if task_ then task.cancel(task_) task_ = nil end
        destroyKunai()
    end

    local function start()
        stop()
        on = true
        doNotify("Anti-Kick enabled", "info")
        task_ = task.spawn(function()
            while on do
                task.wait(0.2)
                local char = localPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not (char and hum and hum.Health > 0) then
                    task.wait(0.5)
                else
                    local state = checkKunaiState(kunai)
                    if state == "gone" or state == "noweld" then
                        destroyKunai()
                        kunai = spawnKunai()
                        if kunai then
                            if attachKunai(kunai) then
                                doNotify("Kunai attached - protected", "success")
                            else
                                doNotify("Attach failed, retrying", "warning")
                                destroyKunai()
                            end
                        else
                            doNotify("Spawn failed, retrying", "warning")
                        end
                    elseif state == "detached" then
                        local sp = kunai:FindFirstChild("StickyPart")
                        if sp then
                            for _ = 1, 3 do
                                pcall(function() setNetworkOwner:FireServer(sp, sp.CFrame) end)
                            end
                            local target = char:FindFirstChild("Left Leg") or char:FindFirstChild("Torso")
                            if target then
                                pcall(function() stickyPartEvent:FireServer(sp, target, attachCF) end)
                            end
                            doNotify("Kunai detached - reattaching", "warning")
                        end
                    end

                    if kunai and kunai.Parent then
                        local sp = kunai:FindFirstChild("StickyPart")
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if sp and hrp and (sp.Position - hrp.Position).Magnitude > 40 then
                            destroyKunai()
                            doNotify("Kunai too far - respawning", "warning")
                        end
                    end
                end
            end
        end)
    end

    makeSection(defenseTab, "Anti-Kick (Kunai)")
    makeToggle(defenseTab, "Anti-Kick Kunai ON/OFF", false, function(v)
        if v then start() else stop() doNotify("Anti-Kick disabled", "info") end
    end)
    makeButton(defenseTab, "Force Reattach Kunai", function()
        if not on then return end
        destroyKunai()
        doNotify("Forcing reattach", "info")
    end)
    gui.Destroying:Connect(stop)
end

