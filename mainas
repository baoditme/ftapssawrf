        end
        for len = #fullText - 1, 0, -1 do
            local currentText = string.sub(fullText, 1, len)
            for _ = 1, 2 do
                if not gui.Parent or not titleLabel.Parent then return end
                titleLabel.Text = (currentText == "" and "" or (currentText .. " ")) .. cursor
                task.wait(0.04)
            end
        end
        for _ = 1, 40 do
            if not gui.Parent or not titleLabel.Parent then return end
            titleLabel.Text = cursor
            task.wait(0.05)
        end
        for len = 1, #fullText do
            local currentText = string.sub(fullText, 1, len)
            for _ = 1, 2 do
                if not gui.Parent or not titleLabel.Parent then return end
                titleLabel.Text = currentText .. " " .. cursor
                task.wait(0.04)
            end
        end
    end
end)

