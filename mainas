    local function applyBodyMaterial()
        local char = localPlayer.Character
        if not char then return end
        -- Xoá folder cũ + folder orphan từ lần inject trước (nếu có)
        if bodyMatFolder then pcall(function() bodyMatFolder:Destroy() end) end
        local orphan = localPlayer:FindFirstChild("_RYZE_BodyMatStash")
        while orphan do
            pcall(function() orphan:Destroy() end)
            orphan = localPlayer:FindFirstChild("_RYZE_BodyMatStash")
        end
        bodyMatFolder = Instance.new("Folder")
        bodyMatFolder.Name = "_RYZE_BodyMatStash"
        bodyMatFolder.Parent = localPlayer
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
                obj.Parent = bodyMatFolder
            end
        end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("SurfaceAppearance") then
                d.Parent = bodyMatFolder
            end
        end
        bodyMatSaved = {}
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
                bodyMatSaved[d] = { mat = d.Material, col = d.Color }
                pcall(function()
                    d.Material = Enum.Material[V.bodyMatType] or Enum.Material.Neon
                    d.Color = V.bodyMatColor
                end)
            end
        end
    end
    local function removeBodyMaterial()
        local char = localPlayer.Character
        for part, info in pairs(bodyMatSaved) do
            if part and part.Parent then
                pcall(function()
                    part.Material = info.mat
                    part.Color = info.col
                end)
            end
        end
        bodyMatSaved = {}
        if bodyMatFolder then
            if char then
                for _, obj in ipairs(bodyMatFolder:GetChildren()) do
                    pcall(function() obj.Parent = char end)
                end
            end
            pcall(function() bodyMatFolder:Destroy() end)
            bodyMatFolder = nil
        end
    end
    local function applyBodyMatColor(c)
        for part in pairs(bodyMatSaved) do
            if part and part.Parent then
                pcall(function() part.Color = c end)
            end
        end
    end

