function _BH_apply(model)
    if not model or _BH.state.entries[model] then return end
    local hole = model:FindFirstChild("Hole")
    if not hole then return end
    local gui = hole:FindFirstChild("BillboardGui")

    local entry = {
        model = model, hole = hole, gui = gui,
        origHoleTrans = hole.Transparency,
        origGuiEnabled = gui and gui.Enabled,
        origBeams = {}, origTrails = {}, origParticles = {}, origLights = {},
        beams = {}, conns = {},
    }
    _BH.state.entries[model] = entry

    hole.Transparency = 1
    if gui then gui.Enabled = false end
    for _, d in ipairs(hole:GetDescendants()) do
        if d:IsA("Beam") then table.insert(entry.origBeams, d) d.Enabled = false
        elseif d:IsA("Trail") then table.insert(entry.origTrails, d) d.Enabled = false
        elseif d:IsA("ParticleEmitter") then table.insert(entry.origParticles, d) d.Enabled = false
        elseif d:IsA("Light") then table.insert(entry.origLights, d) d.Enabled = false
        end
    end

    local custom = Instance.new("Part")
    custom.Name = "_RYZE_BH_Custom"
    custom.Shape = Enum.PartType.Ball
    custom.Material = Enum.Material.Neon
    custom.Color = _BH.settings.color
    custom.Size = Vector3.new(0.5, 0.5, 0.5)
    custom.Anchored = true
    custom.CanCollide = false
    custom.CanTouch = false
    custom.CanQuery = false
    custom.CastShadow = false
    custom.CFrame = CFrame.new(hole.Position)
    custom.Parent = Workspace
    entry.custom = custom

    table.insert(entry.conns, RunService.Heartbeat:Connect(function()
        if not custom.Parent or not hole.Parent then return end
        custom.CFrame = CFrame.new(hole.Position)
    end))

    local tw = TweenService:Create(custom, TweenInfo.new(_BH.settings.expandTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(_BH.settings.baseSize, _BH.settings.baseSize, _BH.settings.baseSize),
    })
    tw:Play()

    task.spawn(function()
        while custom.Parent and hole.Parent and _BH.settings.on do
            for _ = 1, _BH.settings.lightningPerTick do
                local segments = math.random(6, 10)
                local startPos = Vector3.new(
                    custom.Position.X + math.random(-15, 15),
                    custom.Position.Y + 60 + math.random(0, 30),
                    custom.Position.Z + math.random(-15, 15)
                )
                local endPos = custom.Position
                local points = {startPos}
                for i = 1, segments - 1 do
                    local t = i / segments
                    local base = startPos:Lerp(endPos, t)
                    local offX = math.random(-10, 10)
                    local offZ = math.random(-10, 10)
                    table.insert(points, base + Vector3.new(offX, 0, offZ))
                end
                table.insert(points, endPos)
                local atts = {}
                for _, pos in ipairs(points) do
                    local att = Instance.new("Attachment")
                    att.Parent = Workspace.Terrain
                    att.WorldPosition = pos
                    table.insert(atts, att)
                end
                for i = 1, #atts - 1 do
                    local beam = Instance.new("Beam")
                    beam.Attachment0 = atts[i]
                    beam.Attachment1 = atts[i + 1]
                    beam.Width0 = 0.15
                    beam.Width1 = 0.15
                    beam.FaceCamera = true
                    beam.Segments = 1
                    beam.Color = ColorSequence.new(_BH.settings.color)
                    beam.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0),
                        NumberSequenceKeypoint.new(0.5, 0.15),
                        NumberSequenceKeypoint.new(1, 0.4),
                    })
                    beam.LightEmission = 1
                    beam.LightInfluence = 0
                    beam.Parent = custom
                    Debris:AddItem(beam, 0.16)
                end
                for _, att in ipairs(atts) do
                    Debris:AddItem(att, 0.2)
                end
            end
            task.wait(_BH.settings.lightningRate)
        end
    end)

    table.insert(entry.conns, model.AncestryChanged:Connect(function(_, parent)
        if parent then return end
        _BH_shrink(model)
    end))
end

function _BH_shrink(model)
    local entry = _BH.state.entries[model]
    if not entry or entry.shrinking then return end
    entry.shrinking = true
    local custom = entry.custom
    if custom and custom.Parent then
        local tw = TweenService:Create(custom, TweenInfo.new(_BH.settings.shrinkTime, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = Vector3.new(0.05, 0.05, 0.05),
        })
        tw:Play()
        tw.Completed:Once(function() _BH_cleanup(model) end)
    else
        _BH_cleanup(model)
    end
end

function _BH_cleanup(model)
    local entry = _BH.state.entries[model]
    if not entry then return end
    _BH.state.entries[model] = nil
    for _, c in ipairs(entry.conns) do pcall(function() c:Disconnect() end) end
    for _, b in ipairs(entry.beams) do pcall(function() b:Destroy() end) end
    if entry.custom and entry.custom.Parent then entry.custom:Destroy() end
    if entry.hole and entry.hole.Parent then
        entry.hole.Transparency = entry.origHoleTrans or 0
        for _, b in ipairs(entry.origBeams) do if b.Parent then b.Enabled = true end end
        for _, t in ipairs(entry.origTrails) do if t.Parent then t.Enabled = true end end
        for _, p in ipairs(entry.origParticles) do if p.Parent then p.Enabled = true end end
        for _, l in ipairs(entry.origLights) do if l.Parent then l.Enabled = true end end
    end
    if entry.gui and entry.gui.Parent then
        entry.gui.Enabled = entry.origGuiEnabled ~= false
    end
end

win.Gui.Destroying:Connect(function()
    _BH.settings.on = false
    if _BH.state.watcher then pcall(function() _BH.state.watcher:Disconnect() end) _BH.state.watcher = nil end
