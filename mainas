        end

        local char = localPlayer.Character
        char = char and char:FindFirstChild("HumanoidRootPart")
        if not char or #filtered == 0 then
            StopLineLag()
            noBlobRunning = false
            return
        end

        local hrps = {}
        for _, p in ipairs(filtered) do
            local c = p.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if h then table.insert(hrps, {player = p, hrp = h}) end
        end

        -- Chiếm NetworkOwner: 0.16s/target × 5 lần fire
        for _, t in ipairs(hrps) do
            pcall(function()
                char.CFrame = t.hrp.CFrame * CFrame.new(0, 0, 3)
                char.AssemblyLinearVelocity = Vector3.zero
            end)
            task.wait(0.16)
            for i = 1, 5 do
                setNetworkOwner:FireServer(t.hrp, t.hrp.CFrame)
            end
        end

        -- Vòng tròn bán kính 80, cao Y=32
        local step = 6.283185307179586 / #hrps
        for i, t in ipairs(hrps) do
            local a = (i - 1) * step
            local x, z = math.cos(a) * 80, math.sin(a) * 80
            pcall(function()
                t.hrp.CFrame = CFrame.new(x, 32, z)
                t.hrp.AssemblyLinearVelocity = Vector3.zero
            end)
            local bp = Instance.new("BodyPosition")
            bp.MaxForce = Vector3.new(3e9, 4e9, 3e9)
            bp.P = 5e7
            bp.Position = Vector3.new(x, 32, z)
            bp.Parent = t.hrp
            task.delay(3, function() pcall(function() bp:Destroy() end) end)
            task.wait()
        end

        task.wait(1.3)

        -- Kéo grab-line vào toạ độ vô cực rồi destroy → đứt → kick
        for _, t in ipairs(hrps) do
            pcall(function()
                createGrabLine:FireServer(t.hrp, CFrame.new(3e9, 4e9, 2e9))
                task.wait()
                destroyGrabLine:FireServer(t.hrp)
            end)
        end
        state.session.track_kill(#hrps)
        -- [FIX 1] Giữ Line Lag đúng 12s
        task.wait(12)
        StopLineLag()
        noBlobRunning = false
    end)
end

