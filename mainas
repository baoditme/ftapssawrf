makeSlider(aimTab, "Trigger Distance", 60, 5, 300, function(v) state.trig.dist = v end)
end -- kết thúc khối do của Module 7

-- ==========================================
-- MODULE 8: PLAYER AURA + GRAB MODES (SAVITAR port)
-- ==========================================
do
    local Debris = game:GetService("Debris")
    local _voidTracked = {}   -- [userId] = tick() lần cuối track
local _killTracked = {}

    function _isWL(p)
        return state.isWL and state.isWL(p) or false
    end

    function _ownerIsMe(part)
        local po = part and part:FindFirstChild("PartOwner")
        return po ~= nil and po.Value == localPlayer.Name
    end

    function _lookAt(pos, target)
        local dir = target - pos
        if dir.Magnitude < 0.001 then return CFrame.new(pos) end
        local unit = dir.Unit
        local right = unit:Cross(Vector3.new(0, 1, 0))
        if right.Magnitude < 0.001 then right = unit:Cross(Vector3.new(0, 0, 1)) end
        return CFrame.fromMatrix(pos, right, right:Cross(unit))
    end

    function _snowship(part)
        if not part or not part.Parent or not part:IsA("BasePart") then return end
        if _ownerIsMe(part) then return end
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if localPlayer:DistanceFromCharacter(part.Position) > 30 then return end
        pcall(function()
            setNetworkOwner:FireServer(part, _lookAt(hrp.Position, part.Position))
        end)
    end

    function _skyVelocity(part)
        if not part or part:FindFirstChild("_nileSkyVel") then return end
        local bv = Instance.new("BodyVelocity")
        bv.Name = "_nileSkyVel"
        bv.Velocity = Vector3.new(0, 1e14, 0)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Parent = part
        Debris:AddItem(bv, 0.25)
    end

    function _release(part)
        if not part then return end
        pcall(function() destroyGrabLine:FireServer(part) end)
    end

    function _grabIsActive(part)
        if not part or not part.Parent then return false end
        local gp = workspace_:FindFirstChild("GrabParts")
        if not gp then return false end
        local grabPart = gp:FindFirstChild("GrabPart")
        if not grabPart then return false end
        local weld = grabPart:FindFirstChild("WeldConstraint")
        return weld ~= nil and weld.Part1 == part
    end

    -- ==========================================
    -- PLAYER AURA
    -- ==========================================
    state.auraRadius = 30
    state.auraModes = {}
    state.auraLoop = false

    function _getAuraTargets()
        local out = {}
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return out end
        local pos = hrp.Position
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= localPlayer and not _isWL(p) and p.Character then
                local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                if tHrp and tHum and tHum.Health > 0
                    and (tHrp.Position - pos).Magnitude <= state.auraRadius then
                    table.insert(out, {player = p, hrp = tHrp, hum = tHum, char = p.Character})
                end
            end
        end
        return out
    end

    function _runAuraMode(mode, t)
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local tHrp = t.hrp

        if mode == "Kill" then
    if not _ownerIsMe(tHrp) then
        _snowship(tHrp)
    else
        local uid = t.player.UserId
        if not _killTracked[uid] or tick() - _killTracked[uid] > 5 then
            _killTracked[uid] = tick()
            state.session.track_kill()
        end
        task.spawn(function()
            pcall(function()
                t.hum.BreakJointsOnDeath = false
                t.hum:ChangeState(Enum.HumanoidStateType.Dead)
            end)
            task.wait(0.05)
            _release(tHrp)
            _skyVelocity(tHrp)
        end)
    end
        elseif mode == "Void" then
    if not _ownerIsMe(tHrp) then
        _snowship(tHrp)
    else
        _release(tHrp)
        _skyVelocity(tHrp)
        local uid = t.player.UserId
        if not _voidTracked[uid] or tick() - _voidTracked[uid] > 5 then
            _voidTracked[uid] = tick()
            state.session.track_void()
        end
    end
        elseif mode == "Fling" then
            if not _ownerIsMe(tHrp) then
                _snowship(tHrp)
            elseif not tHrp:FindFirstChild("_nileAuraBV") then
                local bv = Instance.new("BodyVelocity")
                bv.Name = "_nileAuraBV"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = Vector3.new(math.random(-150, 150), 500, math.random(-150, 150))
                bv.Parent = tHrp
                Debris:AddItem(bv, 0.4)
            end
        elseif mode == "Grab" then
            _snowship(tHrp)
        elseif mode == "TP to Spawn" then
            if not _ownerIsMe(tHrp) then
                _snowship(tHrp)
            else
                local spawn = workspace_:FindFirstChildOfClass("SpawnLocation")
                if spawn then
                    pcall(function()
                        tHrp.CFrame = spawn.CFrame + Vector3.new(0, 3, 0)
                        tHrp.AssemblyLinearVelocity = Vector3.zero
                        tHrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                    _release(tHrp)
                end
            end
        elseif mode == "Ragdoll" then
            _snowship(tHrp)
            if _ownerIsMe(tHrp) and ragdollRemote then
                pcall(function() ragdollRemote:FireServer(tHrp, 15) end)
            end
        elseif mode == "Struggle" then
            if not _ownerIsMe(tHrp) then
                _snowship(tHrp)
            elseif struggleRemote then
                pcall(function() struggleRemote:FireServer() end)
            end
        elseif mode == "Unstick" then
            local seen = {}
            for _, d in ipairs(t.char:GetDescendants()) do
                if d:IsA("BasePart") then
                    for _, cp in ipairs(d:GetConnectedParts()) do
                        if cp and not cp:IsDescendantOf(t.char) then
                            local sp = cp.Name == "StickyPart" and cp or cp:FindFirstChild("StickyPart", true)
                            if sp and sp:IsA("BasePart") and not seen[sp] then
                                seen[sp] = true
                                pcall(function() setNetworkOwner:FireServer(sp, sp.CFrame) end)
                            end
                        end
                    end
                end
            end
        elseif mode == "Magnet" then
            if not _ownerIsMe(tHrp) then
                _snowship(tHrp)
            else
                local dir = hrp.Position - tHrp.Position
                if dir.Magnitude > 0.001 then
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Velocity = dir.Unit * 200
                    bv.Parent = tHrp
                    Debris:AddItem(bv, 0.2)
                end
            end
        end
    end

    local _auraHL = {}
    function _updateHL()
        local active = state.auraModes["Highlight"]
        local targets = active and _getAuraTargets() or {}
        local seen = {}
        for _, t in ipairs(targets) do
            seen[t.player] = true
            local hl = _auraHL[t.player]
            if not hl or not hl.Parent then
                hl = Instance.new("Highlight")
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.FillTransparency = 0.4
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee = t.char
                hl.Parent = t.char
                _auraHL[t.player] = hl
            end
            hl.FillColor = Color3.fromHSV((tick() * 0.2) % 1, 0.9, 1)
        end
        for p, hl in pairs(_auraHL) do
            if not seen[p] then
                pcall(function() hl:Destroy() end)
                _auraHL[p] = nil
            end
        end
    end

    task.spawn(function()
        while gui.Parent do
            task.wait(0.06)
            if state.auraLoop then
                _updateHL()
                local hasOther = false
                for k in pairs(state.auraModes) do
                    if k ~= "Highlight" then hasOther = true break end
                end
                if hasOther then
                    for _, t in ipairs(_getAuraTargets()) do
                        for mode in pairs(state.auraModes) do
                            if mode ~= "Highlight" then
                                task.spawn(_runAuraMode, mode, t)
                            end
                        end
                    end
                end
            elseif next(_auraHL) then
                for p, hl in pairs(_auraHL) do
                    pcall(function() hl:Destroy() end)
                end
                _auraHL = {}
            end
        end
    end)

    makeSection(auraTab, "Player Aura (SAVITAR)")
    makeToggle(auraTab, "Aura Master Switch", false, function(on) state.auraLoop = on end)
    makeSlider(auraTab, "Aura Radius", 30, 5, 100, function(v) state.auraRadius = v end)
    local auraModeList = {"Kill", "Void", "Fling", "Grab", "TP to Spawn", "Ragdoll", "Struggle", "Unstick", "Magnet", "Highlight"}
    for _, mode in ipairs(auraModeList) do
        makeToggle(auraTab, "Aura: " .. mode, false, function(on)
            state.auraModes[mode] = on or nil
        end)
    end

    -- ==========================================
    -- GRAB MODES
    -- ==========================================
    state.grabModes = {}
    state.grabStrengthPower = 5
    state.grabSpinSpeed = 5

    function _getGrabbedPart()
        local gp = workspace_:FindFirstChild("GrabParts")
        if not gp then return nil end
        local grabPart = gp:FindFirstChild("GrabPart")
        if not grabPart then return nil end
        for _, c in ipairs(grabPart:GetChildren()) do
            if c:IsA("WeldConstraint") and c.Part1 and c.Part1:IsA("BasePart") then
                return c.Part1
            end
        end
        return nil
    end

    workspace_.ChildAdded:Connect(function(child)
        if child.Name ~= "GrabParts" then return end
        task.wait(0.05)
        local part = _getGrabbedPart()
        if not part then return end
        local modes = state.grabModes
        if not next(modes) then return end

        local model = part.Parent
        local grabbedPlayer = model and players:GetPlayerFromCharacter(model)
        local grabbedChar = grabbedPlayer and grabbedPlayer.Character
        local grabbedHRP = grabbedChar and grabbedChar:FindFirstChild("HumanoidRootPart")
        local grabbedHum = grabbedChar and grabbedChar:FindFirstChildOfClass("Humanoid")

        -- Super Strength: RMB to throw
        if modes["Super Strength"] then
            local rmConn
            rmConn = userInputService.InputBegan:Connect(function(input, gp)
                if gp then return end
                if input.UserInputType ~= Enum.UserInputType.MouseButton2 then return end
                if not _grabIsActive(part) then
                    pcall(function() rmConn:Disconnect() end)
                    return
                end
                local power = 100 * (400 ^ ((state.grabStrengthPower - 1) / 9))
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = workspace.CurrentCamera.CFrame.LookVector * power
                bv.Parent = part
                Debris:AddItem(bv, 0.2)
            end)
            task.spawn(function()
                while _grabIsActive(part) do task.wait(0.1) end
                pcall(function() rmConn:Disconnect() end)
            end)
        end

        if modes["Massless"] then
            task.spawn(function()
                while _grabIsActive(part) do
                    pcall(function()
                        for _, d in ipairs(child:GetDescendants()) do
                            if d:IsA("BasePart") then
                                d.Massless = true
                                d.CanCollide = false
                                d.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                            end
                        end
                    end)
                    task.wait(0.1)
                end
            end)
        end

        if modes["Spin"] then
            task.spawn(function()
                local spinSpeed = 10 + (state.grabSpinSpeed - 1) * 30
                local bav = Instance.new("BodyAngularVelocity")
                bav.AngularVelocity = Vector3.new(0, spinSpeed, 0)
                bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bav.Parent = part
                while _grabIsActive(part) do
                    pcall(function() bav.AngularVelocity = Vector3.new(0, spinSpeed, 0) end)
                    task.wait()
                end
                if bav and bav.Parent then bav:Destroy() end
            end)
        end

        if modes["Noclip"] then
            task.spawn(function()
                while _grabIsActive(part) do
                    pcall(function()
                        for _, d in ipairs(child:GetDescendants()) do
                            if d:IsA("BasePart") then d.CanCollide = false end
                        end
                    end)
                    task.wait(0.05)
                end
            end)
        end

        if modes["Invisible"] then
            task.spawn(function()
                while _grabIsActive(part) do
                    local gp = workspace_:FindFirstChild("GrabParts")
                    if gp then
                        for _, d in ipairs(gp:GetDescendants()) do
                            if d:IsA("Beam") then d.Enabled = false end
                        end
                    end
                    task.wait(0.05)
                end
            end)
        end

        if modes["Free"] then
            task.spawn(function()
                while _grabIsActive(part) do
                    local gp = workspace_:FindFirstChild("GrabParts")
                    if gp then
                        local dp = gp:FindFirstChild("DragPart")
                        if dp then
                            local ao = dp:FindFirstChildOfClass("AlignOrientation")
                            if ao then ao.MaxTorque = 0 end
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end

        if grabbedPlayer then
            if modes["Kill Grab"] and grabbedHum and grabbedHum.Health > 0 then
                task.spawn(function()
                    pcall(function()
                        grabbedHum.BreakJointsOnDeath = false
                        grabbedHum:ChangeState(Enum.HumanoidStateType.Dead)
                        state.session.track_kill()
                    end)
                    _release(part)
                    if grabbedHRP then _skyVelocity(grabbedHRP) end
                end)
            end

            if modes["Void Grab"] and grabbedHRP then
                task.spawn(function()
                state.session.track_void()
                    _release(part)
                    _skyVelocity(grabbedHRP)
                end)
            end

            if modes["Teleport to Spawn"] and grabbedHRP then
                task.spawn(function()
                    local spawn = workspace_:FindFirstChildOfClass("SpawnLocation")
                    if spawn then
                        pcall(function()
                            grabbedHRP.CFrame = spawn.CFrame + Vector3.new(0, 3, 0)
                            grabbedHRP.AssemblyLinearVelocity = Vector3.zero
                        end)
                        _release(part)
                    end
                end)
            end

            if modes["Ragdoll Grab"] and grabbedHRP and ragdollRemote then
                task.spawn(function()
                    while _grabIsActive(part) do
                        pcall(function() ragdollRemote:FireServer(grabbedHRP, 15) end)
                        task.wait(0.1)
                    end
                end)
            end

            if modes["Unstick"] then
                task.spawn(function()
                    local seen = {}
                    while _grabIsActive(part) do
                        for _, d in ipairs(grabbedChar:GetDescendants()) do
                            if d:IsA("BasePart") then
                                for _, cp in ipairs(d:GetConnectedParts()) do
                                    if cp and not cp:IsDescendantOf(grabbedChar) then
                                        local sp = cp.Name == "StickyPart" and cp or cp:FindFirstChild("StickyPart", true)
                                        if sp and sp:IsA("BasePart") and not seen[sp] then
                                            seen[sp] = true
                                            pcall(function() setNetworkOwner:FireServer(sp, sp.CFrame) end)
                                        end
                                    end
                                end
                            end
                        end
                        task.wait(0.3)
                    end
                end)
            end
        end
    end)

    makeSection(auraTab, "Grab Modes (SAVITAR)")
    makeSlider(auraTab, "Super Strength Power", 5, 1, 10, function(v) state.grabStrengthPower = v end)
    makeSlider(auraTab, "Spin Speed", 5, 1, 10, function(v) state.grabSpinSpeed = v end)
    local grabModesList = {
        "Super Strength", "Kill Grab", "Void Grab", "Teleport to Spawn",
        "Massless", "Spin", "Ragdoll Grab", "Invisible",
        "Free", "Noclip", "Unstick"
    }
    for _, mode in ipairs(grabModesList) do
        makeToggle(auraTab, "Grab: " .. mode, false, function(on)
            state.grabModes[mode] = on or nil
        end)
    end

    
end

