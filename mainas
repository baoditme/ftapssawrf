    makeToggle(kickTab, "Loop Kick (Blobman)", false, function(on)
        if on then
            if not state.targetName then Notify("Kick", "Choose target first", "warning", 2) return end
            loopKickRunning = true
            task.spawn(EkLoopKick, state.targetName)
        else
            loopKickRunning = false
        end
    end)

    makeToggle(kickTab, "Blob Kill ", false, function(on)
        if on then
            if not state.targetName then Notify("Kick", "Choose target first", "warning", 2) return end
            blobKillRunning = true
            task.spawn(EkBlobKill, state.targetName)
        else
            blobKillRunning = false
        end
    end)

    makeToggle(kickTab, "Bypass ", false, function(on)
        if on then
            if not state.targetName then Notify("Kick", "Choose target first", "warning", 2) return end
            bypassRunning = true
            task.spawn(EkBypass, state.targetName)
        else
            bypassRunning = false
        end
    end)

    makeToggle(kickTab, "Blob Lock ", false, function(on)
        if on then
            if not state.targetName then Notify("Kick", "Choose target first", "warning", 2) return end
            BlobLock:Start(state.targetName)
        else
            BlobLock:Stop()
        end
    end)

    makeToggle(kickTab, "Snowball Ragdoll", false, function(on)
        if on then
            if not state.targetName then Notify("Kick", "Choose target first", "warning", 2) return end
            snowballRunning = true
            task.spawn(EkSnowballRagdoll, state.targetName)
        else
