function IsInPlot(arg)
    if not arg then return false end
    local inPlot = arg:FindFirstChild("InPlot")
    if inPlot and inPlot:IsA("BoolValue") then return inPlot.Value end
    local attr = arg:GetAttribute("InPlot")
    if typeof(attr) == "boolean" then return attr end
    local character = arg.Character
    if not character then return false end
    local hrp = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
    if not hrp then return false end
    local plots = workspace:FindFirstChild("Plots") or workspace:FindFirstChild("PlayerPlots") or workspace:FindFirstChild("Houses") or workspace:FindFirstChild("PlotsFolder")
    if not plots then return false end
    local plot = nil
    for _, child in ipairs(plots:GetChildren()) do
        if child:IsA("Model") then
            local a2 = child:GetAttribute("OwnerUserId") or child:GetAttribute("OwnerId")
            local hit = (typeof(a2) == "number" and a2 == arg.UserId) and true or false
            if not hit then
                local a3 = child:GetAttribute("OwnerName")
                if typeof(a3) == "string" and a3 == arg.Name then hit = true end
            end
            if not hit then
                local own = child:FindFirstChild("Owner") or child:FindFirstChild("PlotOwner")
                if own then
                    if (own:IsA("ObjectValue") and own.Value == arg) or (own:IsA("IntValue") and own.Value == arg.UserId) or (own:IsA("StringValue") and own.Value == arg.Name) then hit = true end
                end
            end
            if not hit then
                local oid = child:FindFirstChild("OwnerUserId") or child:FindFirstChild("OwnerId")
                if oid and oid:IsA("IntValue") and oid.Value == arg.UserId then hit = true end
            end
            if not hit then
                if child.Name == arg.Name or child.Name == tostring(arg.UserId) then hit = true end
            end
            if hit then plot = child break else plot = nil end
        else plot = nil end
    end
    if not plot then
        for _, d in ipairs(plots:GetDescendants()) do
            if d:IsA("Model") then
                local a2 = d:GetAttribute("OwnerUserId") or d:GetAttribute("OwnerId")
                local hit = (typeof(a2) == "number" and a2 == arg.UserId) and true or false
                if not hit then
                    local a3 = d:GetAttribute("OwnerName")
                    if typeof(a3) == "string" and a3 == arg.Name then hit = true end
                end
                if not hit then
                    local own = d:FindFirstChild("Owner") or d:FindFirstChild("PlotOwner")
                    if own then
                        if (own:IsA("ObjectValue") and own.Value == arg) or (own:IsA("IntValue") and own.Value == arg.UserId) or (own:IsA("StringValue") and own.Value == arg.Name) then hit = true end
                    end
                end
                if not hit then
                    local oid = d:FindFirstChild("OwnerUserId") or d:FindFirstChild("OwnerId")
                    if oid and oid:IsA("IntValue") and oid.Value == arg.UserId then hit = true end
                end
                if not hit then
                    if d.Name == arg.Name or d.Name == tostring(arg.UserId) then hit = true end
                end
                if hit then plot = d break end
            end
        end
    end
    if not plot then return false end
    local areaPart = nil
    for _, name in ipairs({"PlotArea", "Area", "Region", "Bounds", "Boundary", "Base", "Baseplate", "HouseArea"}) do
        areaPart = plot:FindFirstChild(name, true)
        if not (areaPart and areaPart:IsA("BasePart")) then areaPart = nil continue end
        break
    end
    if areaPart then
        local p = areaPart.CFrame:PointToObjectSpace(hrp.Position)
        local half = areaPart.Size * 0.5
        local ok = math.abs(p.X) <= half.X
        if ok then ok = math.abs(p.Y) <= half.Y end
        if ok then ok = math.abs(p.Z) <= half.Z end
        return ok
    end
    local bb, size = plot:GetBoundingBox()
    local p = bb:PointToObjectSpace(hrp.Position)
    local half = (size + Vector3.new(6, 10, 6)) * 0.5
    local ok = math.abs(p.X) <= half.X
    if ok then ok = math.abs(p.Y) <= half.Y end
    if ok then ok = math.abs(p.Z) <= half.Z end
    return ok
end

