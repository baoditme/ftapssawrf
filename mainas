local ragRef = { active = false, task = nil, pallet = nil }

GrabTab:CreateToggle({
    Name = "Ragdoll Grab (Pallet)",
    Default = false,
    Callback = function(on)
        ragRef.active = on
        if ragRef.task then pcall(task.cancel, ragRef.task) ragRef.task = nil end
        if not on then
            if ragRef.pallet and ragRef.pallet.Parent then
                pcall(function() destroyToyRemote:FireServer(ragRef.pallet) end)
            end
            ragRef.pallet = nil
            return
        end
        ragRef.task = task.spawn(function()
            while ragRef.active do
                task.wait(0.1)
                local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                if not folder then task.wait(0.5) else
                    local pallet = folder:FindFirstChild("_FTAP_RagdollGrab")
                    if not pallet then
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp and spawnToyRemote then
                            pcall(function()
                                spawnToyRemote:InvokeServer("PalletLightBrown", hrp.CFrame, Vector3.zero)
                            end)
                            task.wait(0.3)
                            local pl = folder:FindFirstChild("PalletLightBrown")
                            if pl then
                                pl.Name = "_FTAP_RagdollGrab"
                                local sp = pl:FindFirstChild("SoundPart")
                                if sp then
                                    for _, d in ipairs(pl:GetDescendants()) do
                                        if d:IsA("BasePart") then
                                            d.Transparency = 1
                                            d.Size = Vector3.new(0.5, 0.5, 0.5)
                                            d.CanCollide = false
                                        end
                                    end
                                    pallet = pl
                                    ragRef.pallet = pl
                                    task.spawn(function()
                                        while ragRef.active and sp and sp.Parent do
                                            pcall(function() setNetOwner:FireServer(sp, sp.CFrame) end)
                                            task.wait(0.1)
                                        end
                                    end)
                                end
                            end
                        end
                    end
                    local grabbed = _getGrabbedPart()
                    local grabbedModel = grabbed and grabbed.Parent
                    local grabbedHead = grabbedModel and grabbedModel:FindFirstChild("Head")
                    if pallet and grabbedHead then
                        local sp = pallet:FindFirstChild("SoundPart")
                        if sp and firetouchinterest then
                            pcall(function()
                                firetouchinterest(sp, grabbedHead, 0)
                                task.wait()
                                firetouchinterest(sp, grabbedHead, 1)
                            end)
                        end
                    end
                end
            end
        end)
    end,
})

-- Perspective Grab
GrabTab:CreateSection("Perspective Grab")

local persp = { active = false, origFOV = nil }

local function stopPerspective()
    local cam = Workspace.CurrentCamera
    if persp.origFOV then
        local target = persp.origFOV
        task.spawn(function()
            for _ = 1, 20 do
                cam.FieldOfView = cam.FieldOfView + (target - cam.FieldOfView) * 0.15
                task.wait()
            end
        end)
    end
    local cc = Lighting:FindFirstChild("_FTAP_PerspCC")
    if cc then cc:Destroy() end
end

GrabTab:CreateToggle({
    Name = "Perspective Grab",
    Default = false,
    Callback = function(on)
        persp.active = on
        if not on then stopPerspective() return end
        local cam = Workspace.CurrentCamera
        persp.origFOV = cam.FieldOfView
        local cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "_FTAP_PerspCC"
        cc.Saturation = -0.3
        cc.TintColor = Color3.fromRGB(200, 210, 255)
        cc.Parent = Lighting
        task.spawn(function()
            while persp.active do
                task.wait()
                cam.FieldOfView = cam.FieldOfView + (120 - cam.FieldOfView) * 0.1
            end
        end)
    end,
})

