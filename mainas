        return m:FindFirstChild("SquareTaper") or m:FindFirstChild("PyramidOctagon")
            or m:FindFirstChild("SoundPart") or m:FindFirstChild("Handle")
            or m:FindFirstChildWhichIsA("BasePart")
    end
    local function stopTentacle()
        _G.TentacleActive = false
        for _, c in ipairs(tentConns) do pcall(function() c:Disconnect() end) end
        tentConns, tentSegs = {}, {}
    end
    local function segPos(base, i, x, y, z, off)
        off = off or 0
        local per = i / SEG_PER
        return (base * CFrame.new(off, 1, 3) * CFrame.Angles(
            math.rad(x * bendStrength * per),
            math.rad(y * bendStrength * per + twistAngle * per),
            math.rad(z * bendStrength * per)
        ) * CFrame.new(0, spacing * i, 0)).Position
    end
    local function segCF(base, i, x, y, z, off)
        local pos = segPos(base, i, x, y, z, off)
        local lk = i < SEG_PER and (segPos(base, i+1, x, y, z, off) - pos)
                     or (pos - segPos(base, i-1, x, y, z, off))
        if lk.Magnitude < 0.001 then return CFrame.new(pos) end
        local u = lk.Unit
        local r = Vector3.new(0,1,0):Cross(u)
        local fr = r.Magnitude < 0.001 and Vector3.new(1,0,0) or r.Unit
        return CFrame.fromMatrix(pos, fr, u, -u:Cross(fr).Unit)
    end
    local function stickTo(base, tp, off)
        local u = base:VectorToObjectSpace(tp - (base * CFrame.new(off or 0, 1, 3)).Position).Unit
        return math.clamp(u.X*3, -3, 3), math.clamp(u.Y*3, -3, 3), math.clamp(-u.Z*3, -3, 3)
    end

