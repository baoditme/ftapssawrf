        if not folder then return end
        for _, c in ipairs(folder:GetChildren()) do
            if c.Name == "TetracubeI" then
                pcall(function() destroyToyRemote:FireServer(c) end); task.wait(0.05)
            end
        end
        task.wait(0.3)
        local total = SEG_PER * stickCount
        local spawnCF = hrp.CFrame * CFrame.new(0, 0, 3)
        for _ = 1, total do
            pcall(function() spawnToyRemote:InvokeServer("TetracubeI", spawnCF, Vector3.zero) end); task.wait(0.15)
        end
        task.wait(0.3)
        if isRemote then
            local pi = workspace_:FindFirstChild("PlotItems")
            folder = pi and pi:FindFirstChild(plotName)
            if not folder then task.wait(1); folder = pi and pi:FindFirstChild(plotName) end
        end
        if not folder then return end

        local startT = tick()
        local collected = {}
        for _, c in ipairs(folder:GetChildren()) do
            if c.Name == "TetracubeI" and #collected < total then
                local mp = mainPart(c)
                if mp then
                    pcall(function()
                        for _, d in ipairs(c:GetDescendants()) do
                            if d:IsA("BasePart") then d.CanCollide = false; d.CanTouch = false end
                        end
                    end)
                    table.insert(collected, { part = mp, model = c })
                end
            end
        end

        local offs = OFFS[stickCount] or {0}
        for i = 1, stickCount do
            local side = offs[i] or 0
            local parts = {}
            for j = 1, SEG_PER do
                local s = collected[(i-1) * SEG_PER + j]
                if s then
                    local cf = segCF(hrp.CFrame, j, sticks[i].x, sticks[i].y, sticks[i].z, side)
                    pcall(function()
                        setNetworkOwner:FireServer(s.part, s.part.CFrame); task.wait(0.05)
                        s.part.CFrame = cf
                        s.part.AssemblyLinearVelocity = Vector3.zero
                        s.part.AssemblyAngularVelocity = Vector3.zero
                        setNetworkOwner:FireServer(s.part, cf)
                    end)
                    local bp = Instance.new("BodyPosition")
                    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bp.P, bp.D = 50000, 1000
                    bp.Position = cf.Position; bp.Parent = s.part
                    local bg = Instance.new("BodyGyro")
                    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    bg.P, bg.D = 50000, 1000
                    bg.CFrame = cf; bg.Parent = s.part
                    table.insert(parts, { part = s.part, model = s.model, index = j, bp = bp, bg = bg })
                end
            end
            tentSegs[i] = { parts = parts, sideOffset = side }
        end

        table.insert(tentConns, runService.Heartbeat:Connect(function(dt)
            if not _G.TentacleActive then return end
            local h = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not h then return end
            local canClaim = not isRemote or (tick() - startT) < 5
            if wiggle then wiggleTime += dt * wiggleSpeed end
            for i = 1, stickCount do
                local seg = tentSegs[i]
                if seg then
                    local st = sticks[i]
                    local x, y, z = st.x, st.y, st.z
                    if wiggle then
                        local ph = wiggleTime + (i-1) * math.pi * 0.5
                        x += math.sin(ph * 1.3) * 2
                        y += math.sin(ph * 0.9 + 1) * 1.5
                        z += math.cos(ph * 1.1 + 2) * 1.5
                    end
                    if st.trackingEnabled and st.trackingTarget then
                        local tc = st.trackingTarget.Character
                        tc = tc and tc:FindFirstChild("HumanoidRootPart")
                        if tc then x, y, z = stickTo(h.CFrame, tc.Position, seg.sideOffset) end
                    end
                    for _, p in ipairs(seg.parts) do
                        if p.part and p.part.Parent then
                            local cf = segCF(h.CFrame, p.index, x, y, z, seg.sideOffset)
                            if canClaim then pcall(function() setNetworkOwner:FireServer(p.part, cf) end) end
                            p.bp.Position = cf.Position
                            p.bg.CFrame = cf
                        end
                    end
                end
            end
        end))
        pcall(Notify, "Tentacle", "ON", "success", 2)
    end

    makeSection(funTab, "Tentacle")
    makeDropdown(funTab, "Tentacle Search Mode", {"My Toys","Plot1","Plot2","Plot3","Plot4","Plot5"}, "My Toys", function(v) searchMode = v end)
    makeDropdown(funTab, "Tentacle Stick Count", {"1","2","3","4"}, "1", function(v) stickCount = tonumber(v) or 1 end)
    makeToggle(funTab, "Tentacle ON/OFF", false, function(on)
        if on then startTentacle() else stopTentacle() end
    end)
    makeButton(funTab, "Refresh Tentacle", function()
        if _G.TentacleActive then startTentacle() end
    end)
    makeSlider(funTab, "Tentacle Spacing", 4, 2, 7, function(v) spacing = v end)
    makeSlider(funTab, "Tentacle Bend", 40, 0, 120, function(v) bendStrength = v end)
    makeSlider(funTab, "Tentacle Twist", 0, -180, 180, function(v) twistAngle = v end)
    makeToggle(funTab, "Tentacle Wiggle", false, function(on) wiggle = on; wiggleTime = 0 end)
    makeSlider(funTab, "Tentacle Wiggle Speed", 1, 0.1, 5, function(v) wiggleSpeed = v end)

    local stickIdx = 1
    if state.makePlayerDropdown then
        state.makePlayerDropdown(funTab, "Tentacle Track Target", function(n)
            local p = players:FindFirstChild(n)
            sticks[stickIdx].trackingTarget = p
