-- ---------- ANCHOR (giữ part bằng BodyPosition + BodyGyro) ----------
state.anch = {}
state.anchClick = false

function unanchorPart(part)
    local rec = state.anch[part]
    if not rec then return end
    for _, k in ipairs({"bp", "bg", "hl"}) do
        if rec[k] then pcall(function() rec[k]:Destroy() end) end
    end
    state.anch[part] = nil
end

function unanchorAll()
    for part in pairs(state.anch) do unanchorPart(part) end
end

function anchorPart(part)
    if state.anch[part] then unanchorPart(part) return end
    if not part:IsA("BasePart") or part.Anchored then
        Notify("Anchor", "Part này không dùng được", "warning", 2) return
    end
    for _, p in ipairs(players:GetPlayers()) do
        if p.Character and part:IsDescendantOf(p.Character) then
            Notify("Anchor", "Không anchor nhân vật", "warning", 2) return
        end
    end
    Ownerboat(part)
    local bp = Instance.new("BodyPosition")
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bp.P, bp.D = 100000, 1000
    bp.Position = part.Position
    bp.Parent = part
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P, bg.D = 100000, 1000
    bg.CFrame = part.CFrame
    bg.Parent = part
    local hl = Instance.new("Highlight")
    hl.FillColor = ACCENT
    hl.FillTransparency = 0.6
    hl.Parent = part
    state.anch[part] = {bp = bp, bg = bg, hl = hl}
    Notify("Anchor", "Đã anchor " .. part.Name, "success", 2)
end

-- giữ ownership liên tục
task.spawn(function()
    while gui.Parent do
        for part in pairs(state.anch) do
            if not part.Parent then state.anch[part] = nil else pcall(Ownerboat, part) end
        end
