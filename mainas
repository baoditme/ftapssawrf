function _G.QueueSave()
    if not _G.saveConfig then return end
    if _isSaving then
        _savePending = true
        return
    end
    _isSaving = true
    task.delay(0.5, function()
        if _G.saveConfig then _G.saveConfig() end
        _isSaving = false
        if _savePending then
            _savePending = false
            _G.QueueSave()
        end
    end)
end
