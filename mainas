win.Gui.Destroying:Connect(function()
    -- Giữ config: lưu state hiện tại, lần sau load lại
    pcall(saveConfig)

    -- 1. Disconnect tất cả connection runtime
    if flyRef.conn then flyRef.conn:Disconnect() end
    if flyRef.bv then flyRef.bv:Destroy() end
    if flyRef.bg then flyRef.bg:Destroy() end
    if noclipConn then noclipConn:Disconnect() end
    if infExtend.conn then infExtend.conn:Disconnect() end
    if infExtend.scrollConn then infExtend.scrollConn:Disconnect() end
    if flingAuraConn then flingAuraConn:Disconnect() end
    stopPerspective()
    if state._ssConn then state._ssConn:Disconnect() state._ssConn = nil end
    if ragRef.task then pcall(task.cancel, ragRef.task) end
    local gp = Workspace:FindFirstChild("GrabParts")
    if gp then
        local grabPart = gp:FindFirstChild("GrabPart")
        if grabPart then
            local bp = grabPart:FindFirstChild("_FTAP_InfExtendBP")
            if bp then bp:Destroy() end
        end
                local dragPart = gp:FindFirstChild("DragPart")
        if dragPart then
            local alignPos = dragPart:FindFirstChildOfClass("AlignPosition")
            if alignPos then alignPos.Enabled = true end
        end
    end

    -- 2. Reset player runtime về default
    local char = LocalPlayer.Character
    if char then
        -- Xóa mover/effect tạm trên nhân vật
        for _, name in ipairs({
            "_FTAP_FlyBV", "_FTAP_FlyBG",
            "_RYZEFlyBV", "_RYZEFlyBG",
            "_FTAP_FlingBV", "_FTAP_SSBV",
        }) do
            local obj = char:FindFirstChild(name, true)
            if obj then pcall(function() obj:Destroy() end) end
        end
        -- Bật lại CanCollide (noclip off)
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and not p.CanCollide then
                pcall(function() p.CanCollide = true end)
            end
        end
        -- Reset Humanoid
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.WalkSpeed = 16
                hum.JumpPower = 50
                hum.UseJumpPower = false
                hum.PlatformStand = false
            end)
        end
        -- Reset HRP
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                hrp.Anchored = false
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    -- 3. Reset environment
    pcall(function()
        Workspace.Gravity = 196.2
        Workspace.CurrentCamera.FieldOfView = 70
    end)
    pcall(function()
        LocalPlayer.CameraMinZoomDistance = 0.5
        LocalPlayer.CameraMaxZoomDistance = 128
    end)

    -- 4. Dọn effect tạm trong Lighting
    pcall(function()
        local cc = Lighting:FindFirstChild("_FTAP_PerspCC")
        if cc then cc:Destroy() end
    end)
end)

