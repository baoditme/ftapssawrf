local _conns = {}
function proxyService(real)
    return setmetatable({}, {
        __index = function(_, k)
            local v = real[k]
            if typeof(v) == "RBXScriptSignal" then
                return {
                    Connect = function(_, f) local c = v:Connect(f) table.insert(_conns, c) return c end,
                    Once = function(_, f) local c = v:Once(f) table.insert(_conns, c) return c end,
                    Wait = function() return v:Wait() end,
                }
            elseif type(v) == "function" then
                return function(_, ...) return v(real, ...) end
            end
            return v
        end,
        __newindex = function(_, k, val) real[k] = val end,
    })
end

