-- [AUTO COIN HUD CUSTOM] - v11 (rainbow icon border)
-- ============================================================
task.spawn(function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local plr = Players.LocalPlayer

    local ICON_SPIN_SPEED = 120 -- degrees per second
    local ICON_SCALE = 0.75
    local ICON_STROKE = 2       -- icon border thickness
    local RAINBOW_SPEED = 0.12
    local BG_SATURATION = 0.7
    local BG_BRIGHTNESS = 0.3
    local STEP_NAME = "_RYZE_CoinHud"

    local IMG = loadCache("ryze_ftap_avatar")
    if not IMG then
        local ok, res = pcall(dlImage, AVATAR_LINK, "ryze_ftap_avatar")
        if ok and res then IMG = res end
    end
    if not IMG then
        warn("[RYZE FTAP] Could not load AVATAR_LINK image, coin HUD left as default")
        return
    end

    local alive = true
    local created, restoreFns, conns = {}, {}, {}
    local current = nil
    local angle, hue = 0, 0

    local function rainbow(shift, sat, val)
        local kps = {}
        for i = 0, 12 do
            local h = (i / 12 + shift) % 1
            table.insert(kps, ColorSequenceKeypoint.new(i / 12, Color3.fromHSV(h, sat, val)))
        end
        return ColorSequence.new(kps)
    end

    local function make(class, name, parent)
        local o = parent:FindFirstChild(name) or Instance.new(class)
        o.Name = name
        o.Parent = parent
        table.insert(created, o)
        return o
    end

    local function getDisplay()
        local pg = plr:FindFirstChild("PlayerGui")
        local menuGui = pg and pg:FindFirstChild("MenuGui")
        local topRight = menuGui and menuGui:FindFirstChild("TopRight")
        local coinsFrame = topRight and topRight:FindFirstChild("CoinsFrame")
        return coinsFrame and coinsFrame:FindFirstChild("CoinsDisplay")
    end

    local function apply(d, img)
        d:SetAttribute("_RYZE_CoinsApplied", true)

        local origFrame = {
            BackgroundColor3 = d.BackgroundColor3,
            BackgroundTransparency = d.BackgroundTransparency,
        }
        local origImgTransparency = img.ImageTransparency

        restoreFns[#restoreFns + 1] = function()
            for k, v in pairs(origFrame) do pcall(function() d[k] = v end) end
            pcall(function() img.ImageTransparency = origImgTransparency end)
            pcall(function() d:SetAttribute("_RYZE_CoinsApplied", nil) end)
        end

        -- Hide the game's own coin image (locked hidden)
        img.ImageTransparency = 1
        table.insert(conns, img:GetPropertyChangedSignal("ImageTransparency"):Connect(function()
            if alive and img.ImageTransparency ~= 1 then img.ImageTransparency = 1 end
        end))

        -- Our spinning icon (child of CoinImage so it stays in place)
        local icon = make("ImageLabel", "_RYZE_Icon", img)
        icon.BackgroundTransparency = 1
        icon.Image = IMG
        icon.ScaleType = Enum.ScaleType.Crop
        icon.AnchorPoint = Vector2.new(0.5, 0.5)
        icon.Position = UDim2.fromScale(0.5, 0.5)
        icon.Size = UDim2.fromScale(ICON_SCALE, ICON_SCALE)
        icon.ZIndex = img.ZIndex + 1
        local ratio = make("UIAspectRatioConstraint", "_RYZE_Ratio", icon)
        ratio.AspectRatio = 1
        local corner = make("UICorner", "_RYZE_IconCorner", icon)
        corner.CornerRadius = UDim.new(0.22, 0)

        -- Rainbow border on the icon
        local iconStroke = make("UIStroke", "_RYZE_IconStroke", icon)
        iconStroke.Color = Color3.new(1, 1, 1)
        iconStroke.Thickness = ICON_STROKE
        iconStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        local iconGrad = iconStroke:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient", iconStroke)
        iconGrad.Color = rainbow(0, 1, 1)

        -- Background: keep original transparency, dark rainbow tint
        if not d:FindFirstChildOfClass("UICorner") then
            local c = make("UICorner", "_RYZE_FrameCorner", d)
            c.CornerRadius = UDim.new(0, 12)
        end
        d.BackgroundColor3 = Color3.new(1, 1, 1)
        local bgGrad = make("UIGradient", "_RYZE_BgGradient", d)
        bgGrad.Color = rainbow(0, BG_SATURATION, BG_BRIGHTNESS)

        -- Rainbow border on the HUD frame
        local stroke = make("UIStroke", "_RYZE_Stroke", d)
        stroke.Color = Color3.new(1, 1, 1)
        stroke.Thickness = 2
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        local strokeGrad = stroke:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient", stroke)
        strokeGrad.Color = rainbow(0, 1, 1)

        current = { display = d, image = img, icon = icon, bgGrad = bgGrad, strokeGrad = strokeGrad, iconGrad = iconGrad }
    end

    pcall(function() RunService:UnbindFromRenderStep(STEP_NAME) end)
    RunService:BindToRenderStep(STEP_NAME, Enum.RenderPriority.Last.Value, function(dt)
        if not alive then return end

        local d = getDisplay()
        local img = d and d:FindFirstChild("CoinImage")
        if not img or not (img:IsA("ImageLabel") or img:IsA("ImageButton")) then
            current = nil
            return
        end

        if not current or current.image ~= img or not current.icon.Parent then
            apply(d, img)
        end

        angle = (angle + ICON_SPIN_SPEED * dt) % 360
        hue = (hue + RAINBOW_SPEED * dt) % 1
        current.icon.Rotation = angle
        current.bgGrad.Color = rainbow(hue, BG_SATURATION, BG_BRIGHTNESS)
        current.strokeGrad.Color = rainbow(hue, 1, 1)
        current.iconGrad.Color = rainbow(hue, 1, 1)
    end)

    -- Restore everything when the UI is destroyed
    if win and win.Gui then
        win.Gui.Destroying:Connect(function()
            alive = false
            pcall(function() RunService:UnbindFromRenderStep(STEP_NAME) end)
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            for _, fn in ipairs(restoreFns) do pcall(fn) end
            for _, o in ipairs(created) do pcall(function() o:Destroy() end) end
        end)
    end
end)

