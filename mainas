-- ------------------------------------------------------------
-- LOCAL CHAR HELPERS
-- ------------------------------------------------------------
local function _K_lc() return LocalPlayer.Character end
local function _K_lh() local c = _K_lc() if not c then return end return c:FindFirstChildOfClass("Humanoid") end
local function _K_lr() local c = _K_lc() if not c then return end return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") end
local function _K_inv() return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys") end

-- ------------------------------------------------------------
-- BLOBMAN HELPERS (mirror xocu BlobmanBetaFeature)
-- ------------------------------------------------------------
local function _K_on_blob()
    local hum = _K_lh()
    return hum and hum.Sit and hum.SeatPart and hum.SeatPart.Parent and hum.SeatPart.Parent.Name == "CreatureBlobman"
end

local function _K_get_blob()
    local hum = _K_lh()
    if hum and hum.Sit and hum.SeatPart and hum.SeatPart.Parent and hum.SeatPart.Parent.Name == "CreatureBlobman" then
        return hum.SeatPart.Parent
    end
    local inv = _K_inv()
    if inv then
        local b = inv:FindFirstChild("CreatureBlobman")
        if b and b:IsA("Model") and b:FindFirstChild("VehicleSeat") then return b end
    end
    return nil
end

local function _K_find_any_blob()
    local root = _K_lr()
    if not root then return nil end
    local function scan(folder)
        if not folder then return nil end
        local best, bestDist = nil, math.huge
        for _, obj in ipairs(folder:GetChildren()) do
            if obj.Name == "CreatureBlobman" and obj:IsA("Model") and obj:FindFirstChild("VehicleSeat") then
                local d = (obj:GetPivot().Position - root.Position).Magnitude
                if d < bestDist and d < 100000 then bestDist = d best = obj end
            end
        end
        return best
    end
    local found = scan(_K_inv())
    if found then return found end
    local plotItems = Workspace:FindFirstChild("PlotItems")
    if plotItems then
        for _, p in ipairs(plotItems:GetChildren()) do
            local f = scan(p)
            if f then return f end
        end
    end
    return nil
end

local function _K_spawn_blob()
    local root = _K_lr()
    if not root then return nil end
    local existing = _K_get_blob() or _K_find_any_blob()
    if existing then return existing end
    local inv = _K_inv()
    if not inv then return nil end
    local spawned = nil
    local conn
    conn = inv.ChildAdded:Connect(function(t)
        if t.Name == "CreatureBlobman" and t:IsA("Model") then spawned = t conn:Disconnect() end
    end)
    task.spawn(function()
        pcall(function() spawnToyRemote:InvokeServer("CreatureBlobman", root.CFrame * CFrame.new(3, 0, 0), Vector3.zero) end)
    end)
    local t0 = tick()
    while not spawned do
        if tick() - t0 > 2 then conn:Disconnect() break end
        task.wait(0.01)
    end
    if spawned then
        if not spawned:FindFirstChild("VehicleSeat") then spawned:WaitForChild("VehicleSeat", 2) end
        return spawned
    end
    return _K_get_blob() or _K_find_any_blob()
end

local function _K_force_sit()
    local blob = _K_get_blob() or _K_find_any_blob() or _K_spawn_blob()
    if not blob then return false end
    local seat = blob:FindFirstChild("VehicleSeat") or blob:FindFirstChildWhichIsA("VehicleSeat", true)
    if not seat then return false end
    local hum = _K_lh()
    local root = _K_lr()
    if not hum or not root then
        local c = _K_lc()
        if c then hum = hum or c:FindFirstChildOfClass("Humanoid") root = root or c:FindFirstChild("HumanoidRootPart") end
    end
    if not hum or not root then return false end
    if hum.Sit and hum.SeatPart == seat then return true end
    if seat.Occupant and seat.Occupant ~= hum then
        pcall(function() seat.Occupant.Jump = true end)
        task.wait(0.15)
    end
    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero
    root.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
    pcall(function() seat:Sit(hum) end)
    task.wait(0.05)
    return hum.Sit and hum.SeatPart == seat
end

local function _K_ensure_sit()
    if _K_on_blob() then return true end
    return _K_force_sit()
end

local function _K_set_owner(part)
    pcall(function() setNetworkOwner:FireServer(part, _K_lr().CFrame) end)
end

local function _K_ungrab(part)
    pcall(function() destroyGrabLine:FireServer(part) end)
end

local function _K_blob_grab(blob, tgt, side)
    if not blob then return end
    local det = blob:FindFirstChild(side .. "Detector")
    if not det then return end
    local w = det:FindFirstChild(side .. "Weld")
    if not w then return end
    local s = blob:FindFirstChild("BlobmanSeatAndOwnerScript", true)
    if not s then return end
    local r = s:FindFirstChild("CreatureGrab")
    if r then pcall(function() r:FireServer(det, tgt, w) end) end
end

local function _K_blob_drop(blob, tgt, side)
    if not blob then return end
    local det = blob:FindFirstChild(side .. "Detector")
    if not det then return end
    local s = blob:FindFirstChild("BlobmanSeatAndOwnerScript", true)
    if not s then return end
    local r = s:FindFirstChild("CreatureDrop")
    if r then pcall(function() r:FireServer(det, tgt) end) end
end

local function _K_is_alive(plr)
    if not plr or not plr.Parent then return false end
    local c = plr.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    return h and r and h.Health > 0
end

local function _K_is_friend(plr)
    return pcall(function() return LocalPlayer:IsFriendsWith(plr.UserId) end) and LocalPlayer:IsFriendsWith(plr.UserId)
end

local function _K_is_in_plot(plr)
    return plr:FindFirstChild("InPlot") and plr.InPlot.Value
end

local function _K_valid(plr)
    if plr == LocalPlayer then return false end
    if not _K_is_alive(plr) then return false end
    if _K.settings.ignoreFriends and _K_is_friend(plr) then return false end
    if _K_is_in_plot(plr) then return false end
    local c = _K.state.recentKicks[plr.UserId]
    if c and os.clock() - c.time < 10 and c.char == plr.Character then return false end
    local r = plr.Character:FindFirstChild("HumanoidRootPart")
    if not r then return false end
    return true, r, plr.Character
end

local function _K_destroy_movers(c)
    if not c then return end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BodyForce") or d:IsA("BodyVelocity") or d:IsA("BodyAngularVelocity") or d:IsA("BodyGyro")
            or d:IsA("VectorForce") or d:IsA("LinearVelocity") or d:IsA("AngularVelocity")
            or d:IsA("AlignPosition") or d:IsA("AlignOrientation") then
            d:Destroy()
        end
    end
end

local function _K_noclip(c, enable)
    if not c then return end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") then d.CanCollide = not enable end
    end
end

local function _K_kick_action(blob, target, side)
    if not blob or not target then return end
    local hum = _K_lh()
    if not (hum and hum.Sit and blob.Parent and target) then return end
    for _ = 1, 3 do _K_blob_grab(blob, _K_lr(), side) end
    task.wait(0.12)
    local t0 = tick()
    while tick() - t0 < 2 do
        pcall(function() setNetworkOwner:FireServer(target, _K_lr().CFrame) end)
        task.wait()
    end
    if target and target.Parent then
        for _ = 1, 2 do target.CFrame = target.CFrame + Vector3.new(0, 20, 0) end
    end
    _K_ungrab(target)
    task.wait(0.02)
    _K_blob_grab(blob, target, side)
end

