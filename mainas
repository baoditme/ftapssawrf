            rootPart.CFrame = targetCF
            local phase = t * 10
            local armSide = 0.9599 * math.sin(phase)
            local crossAmp = 0.9
            local laZ = crossAmp * math.cos(phase)
            local raZ = -crossAmp * math.cos(phase)
            local hip = -0.349 * math.sin(phase)
            local twist = -0.244 * math.sin(phase)
            local bounce = 0.12 * math.abs(math.sin(phase * 2))
            local offsets = {
                Torso = CFrame.new(0, -bounce, 0) * CFrame.Angles(0, twist, 0),
                Head = CFrame.new(0, 1.5 - bounce, 0),
                ["Left Arm"] = CFrame.new(-1.5, 1 - bounce, laZ) * CFrame.Angles(0, 0, armSide) * CFrame.new(0, -1, 0),
