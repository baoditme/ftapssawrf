        task.wait(0.2)
        cframe = skyCF
    end
    local lockCF = useSkyMode and cframe or hrp.CFrame
    local flag = false
    local n = 0
    local n2 = 0
    while _loopKickBlobActive do
        local v4 = players:FindFirstChild(targetName)
        if not v4 then break end
        local myChar = localPlayer.Character
        local myHum = myChar and myChar:FindFirstChild("Humanoid")
        local seat2 = myHum and myHum.SeatPart
