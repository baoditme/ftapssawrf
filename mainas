    local function findSlots()
        local out = {}
        local slots = workspace_:FindFirstChild("Slots")
        if not slots then return out end
        for _, child in ipairs(slots:GetChildren()) do
            if child:IsA("Model") then
                local slotHandle = child:FindFirstChild("SlotHandle")
                local handle = (slotHandle and slotHandle:FindFirstChild("Handle"))
                    or child:FindFirstChild("Handle")
                local lightBall = (slotHandle and slotHandle:FindFirstChild("LightBall"))
                    or child:FindFirstChild("LightBall")
                if handle then
                    table.insert(out, {model = child, handle = handle, lightBall = lightBall})
                end
            end
        end
        table.sort(out, function(a, b) return a.model.Name < b.model.Name end)
        return out
    end

    local function getTimeText()
        local slots = workspace_:FindFirstChild("Slots")
        if not slots then return nil end
        for _, d in ipairs(slots:GetDescendants()) do
            if d:IsA("TextLabel") and d.Name == "TimeText" then
                return d.Text, d
            end
        end
        return nil
    end

    local function allNeon(slots)
        for _, s in ipairs(slots) do
            if s.lightBall and s.lightBall.Material ~= Enum.Material.Neon then
                return false
            end
        end
        return true
    end

    local function fireOwner(slot)
        if not slot.handle then return end
        pcall(function() setNetworkOwner:FireServer(slot.handle, slot.handle.CFrame) end)
    end

    task.spawn(function()
        while gui.Parent do
            task.wait(math.max(1 / state.spinCPS, 0.05))
            if state.spinRunning and not state.spinBusy then
                local list = findSlots()
                if #list == 0 then
                    task.wait(1)
                else
                    if not allNeon(list) then
                        task.wait(2)
                    else
                        local timeTxt = getTimeText()
                        -- Đang cooldown → chờ, không xoay
                        if timeTxt and timeTxt ~= "0:00" and timeTxt ~= "" then
                            task.wait(1)
                        else
                            state.spinBusy = true
                            task.spawn(function()
                                local slot = list[state.spinIdx] or list[1]
                                if not slot then
                                    state.spinBusy = false
                                    return
                                end
                                local char = localPlayer.Character
                                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                                if not hrp then
                                    state.spinBusy = false
                                    return
                                end
                                local orig = hrp.CFrame
                                pcall(function() hrp.CFrame = slot.handle.CFrame + Vector3.new(0, 3, 0) end)
                                task.wait(0.25)
                                fireOwner(slot)
                                task.wait(0.4)
                                pcall(function() hrp.CFrame = orig end)
                                hrp.AssemblyLinearVelocity = Vector3.zero

                                -- Chờ cooldown bắt đầu
                                local started = false
                                for _ = 1, 12 do
                                    task.wait(0.25)
                                    local t = getTimeText()
                                    if t and t ~= "0:00" and t ~= "" then
                                        started = true
                                        break
                                    end
                                end

                                if started then
                                    -- Chờ cooldown kết thúc
                                    while state.spinRunning do
                                        local t = getTimeText()
                                        if not t or t == "0:00" or t == "" then break end
                                        task.wait(0.5)
                                    end
                                    state.spinIdx = state.spinIdx + 1
                                    if state.spinIdx > #list then state.spinIdx = 1 end
                                    pcall(Notify, "Spin Slots", "Đã quay slot " .. slot.model.Name, "success", 1.5)
                                else
                                    -- Slot hỏng → sang slot khác
