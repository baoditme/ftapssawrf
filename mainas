function ExecuteNoBlobKick()
    if noBlobRunning then return end
    noBlobRunning = true
    -- [Đã bỏ đúng 1 dòng: sendChat("why u bylleh me😭")]

    task.spawn(function()
        state.lineLagRunning = false
        state.lineCount = state.lineLagIntensity or 520
        StartLineLag()

        -- [FIX 3] Lấy SẠCH mọi người ngoài Plot — KHÔNG whitelist, KHÔNG friends
