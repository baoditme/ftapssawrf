        flingAuraConn = RunService.Heartbeat:Connect(function()
            if not state.grab.flingAuraOn then return end
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end
            if state.grab.flingAuraMode == "Players" or state.grab.flingAuraMode == "Both" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and not isWhitelisted(p) then
                        local tHRP = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
