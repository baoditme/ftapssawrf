KickTab:CreateSection("Ragdoll")

KickTab:CreateToggle({
    Name = "Ragdoll Spam (Pallet Hammer)",
    Default = false,
    Callback = function(on)
        _K.settings.ragdollSpamOn = on
        if _K.state.ragdollSpamTask then
            pcall(task.cancel, _K.state.ragdollSpamTask)
            _K.state.ragdollSpamTask = nil
        end
        if not on then return end
        if not _K.target then
            Notify("Error", "Select target first", "warning")
            return
        end
        _K.state.ragdollSpamTask = task.spawn(function()
            local MenuToys = ReplicatedStorage:FindFirstChild("MenuToys")
            local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
            if not MenuToys or not GrabEvents then return end
            local rSpawn = MenuToys:FindFirstChild("SpawnToyRemoteFunction")
            local rDestroy = MenuToys:FindFirstChild("DestroyToy")
            local rOwner = GrabEvents:FindFirstChild("SetNetworkOwner")
            local char = _K_lc()
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp or not rSpawn then return end
            task.spawn(function()
                pcall(function() rSpawn:InvokeServer("PalletLightBrown", hrp.CFrame * CFrame.new(0, 5, 0), Vector3.zero) end)
            end)
            local toyFolder = Workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys", 5)
            if not toyFolder then return end
            local palletModel = toyFolder:WaitForChild("PalletLightBrown", 5)
            if not palletModel then return end
            local palletPart = palletModel:WaitForChild("SoundPart", 5)
            if not palletPart then return end
            if rOwner then rOwner:FireServer(palletPart, palletPart.CFrame) end
            local hammerGoingDown = true
            local segmentIndex = 0
            local lastOwnerTime = tick()
            local SEGMENTS = 8
            local IMPACT = 10
            while _K.settings.ragdollSpamOn and palletModel.Parent do
                RunService.Heartbeat:Wait()
                local target = _K.target and Players:FindFirstChild(_K.target)
                local targetChar = target and target.Character
                local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                if targetHrp and rOwner then
                    if tick() - lastOwnerTime > 1.0 then
                        rOwner:FireServer(palletPart, palletPart.CFrame)
                        lastOwnerTime = tick()
                    end
                    local startPos = targetHrp.Position + Vector3.new(0, 50000, 0)
                    local endPos = targetHrp.Position
                    if hammerGoingDown then
                        segmentIndex = segmentIndex + 1
                        local alpha = segmentIndex / SEGMENTS
                        local nextPos = startPos:Lerp(endPos, alpha)
                        palletPart.CFrame = CFrame.new(nextPos)
                        palletPart.AssemblyLinearVelocity = Vector3.new(0, -50000, 0)
                        palletPart.AssemblyAngularVelocity = Vector3.zero
                        if segmentIndex >= SEGMENTS then
                            palletPart.AssemblyLinearVelocity = Vector3.new(0, -IMPACT, 0)
                            hammerGoingDown = false
                        end
                    else
                        palletPart.CFrame = CFrame.new(startPos)
                        palletPart.AssemblyLinearVelocity = Vector3.zero
                        segmentIndex = 0
                        hammerGoingDown = true
                    end
                else
                    local c = _K_lc()
                    local r = c and c:FindFirstChild("HumanoidRootPart")
                    if r then
                        palletPart.CFrame = r.CFrame * CFrame.new(0, 10, 0)
                        palletPart.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
            if rDestroy and palletModel then pcall(function() rDestroy:FireServer(palletModel) end) end
        end)
    end,
})

KickTab:CreateToggle({
    Name = "Pallet Ragdoll (Invis)",
    Default = false,
    Callback = function(on)
        _K.settings.palletRagdollInvisOn = on

        local function clearAttack()
            if _K.state.palletRagdollInvisConn then
                _K.state.palletRagdollInvisConn:Disconnect()
                _K.state.palletRagdollInvisConn = nil
            end
        end

        if not on then
            clearAttack()
            if _K.state.palletRagdollInvisCacheConn then
                _K.state.palletRagdollInvisCacheConn:Disconnect()
                _K.state.palletRagdollInvisCacheConn = nil
            end
            local pallet = _K.state.palletRagdollInvisPallet
            if pallet and pallet.Parent then
                pcall(function() destroyToyRemote:FireServer(pallet) end)
            end
            _K.state.palletRagdollInvisPallet = nil
            local inv = _K_inv()
            if inv and inv:FindFirstChild("PalletForRagdoll") then
                pcall(function() destroyToyRemote:FireServer(inv.PalletForRagdoll) end)
            end
            return
        end

        if not _K.target then
            Notify("Error", "Select target first", "warning")
            _K.settings.palletRagdollInvisOn = false
            return
        end

        clearAttack()
        if _K.state.palletRagdollInvisCacheConn then
            _K.state.palletRagdollInvisCacheConn:Disconnect()
            _K.state.palletRagdollInvisCacheConn = nil
        end

        local inv = _K_inv()
        local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
        if not inv or not GrabEvents then return end
        local SetNetOwner = GrabEvents:WaitForChild("SetNetworkOwner")
        local DestroyLine = GrabEvents:WaitForChild("DestroyGrabLine")
        local lpName = LocalPlayer.Name

        _K.state.palletRagdollInvisCacheConn = inv.ChildAdded:Connect(function(child)
            if not _K.settings.palletRagdollInvisOn then return end
            if child.Name ~= "PalletLightBrown" and child.Name ~= "PalletForRagdoll" then return end
            local soundPart = child:WaitForChild("SoundPart", 3)
            if not soundPart then return end
            pcall(function()
                SetNetOwner:FireServer(soundPart, soundPart.CFrame)
                DestroyLine:FireServer(soundPart)
            end)
            local partOwner = soundPart:WaitForChild("PartOwner", 1)
            if not (partOwner and partOwner.Value == lpName) then
                pcall(function() destroyToyRemote:FireServer(child) end)
                return
            end
            for _, v in pairs(child:GetChildren()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                    v.CanQuery = false
                    v.Transparency = 1
                end
            end
            child.Name = "PalletForRagdoll"
            _K.state.palletRagdollInvisPallet = child

            local strikePhase = false
            _K.state.palletRagdollInvisConn = RunService.Stepped:Connect(function()
                if not _K.settings.palletRagdollInvisOn or not child.Parent then
                    clearAttack()
                    return
                end
                local target = _K.target and Players:FindFirstChild(_K.target)
                local tChar = target and target.Character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                if tRoot and tHum and soundPart.Parent and tHum.Health > 0 then
                    local ragdolledVal = tHum:FindFirstChild("Ragdolled")
                    local isRagdolled = ragdolledVal and ragdolledVal.Value or false
                    if not isRagdolled then
                        strikePhase = not strikePhase
                        if strikePhase then
                            soundPart.CFrame = tRoot.CFrame * CFrame.new(0, 2, 0)
