do
    local TB = {
        Enabled = false, Connection = nil, canGrab = true,
        maxDistance = 20, preGrabDelay = 0.00001, postGrabDelay = 0.05,
        lastTarget = nil, lastHitTime = 0, targetMemoryDuration = 0.1,
        checkThrottle = 0.008, lastCheck = 0,
    }
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    task.spawn(function()
        local ok, result = pcall(function()
            if replicatedStorage:FindFirstChild("GamepassEvents") then
                return replicatedStorage.GamepassEvents.CheckForGamepass:InvokeServer(20837132)
            end
        end)
        if ok and result then TB.maxDistance = 29.3 end
    end)
    local ge = replicatedStorage:FindFirstChild("GamepassEvents")
    if ge and ge:FindFirstChild("FurtherReachBoughtNotifier") then
        ge.FurtherReachBoughtNotifier.OnClientEvent:Connect(function() TB.maxDistance = 29.3 end)
    end

    local function getTarget()
        local c = localPlayer.Character
        if not c or not c:FindFirstChild("HumanoidRootPart") then return end
        if workspace_:FindFirstChild("GrabParts") then return end
        local cam = workspace.CurrentCamera
        local origin, dir = cam.CFrame.Position, cam.CFrame.LookVector
        rayParams.FilterDescendantsInstances = { c, workspace_:FindFirstChild("Terrain") }
        local result = workspace_:Raycast(origin, dir * 1000, rayParams)
        if not result then
            for _, d in ipairs({dir, (dir + Vector3.new(0,0.075,0)).Unit, (dir - Vector3.new(0,0.075,0)).Unit}) do
                result = workspace_:Raycast(origin, d * 1000, rayParams)
                if result then break end
            end
        end
        if not result then return end
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if not model or not model:FindFirstChildOfClass("Humanoid") or model == c then return end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum.Health <= 0 then return end
        local root = model:FindFirstChild("HumanoidRootPart")
        if not root then return end
        if (c.HumanoidRootPart.Position - root.Position).Magnitude > TB.maxDistance then return end
        return model
    end

    local function onHeartbeat()
        if not TB.Enabled or not TB.canGrab or userInputService:GetFocusedTextBox() then return end
        if tick() - TB.lastCheck < TB.checkThrottle then return end
        TB.lastCheck = tick()
        local t = getTarget()
        if t then TB.lastTarget = t TB.lastHitTime = tick()
        elseif TB.lastTarget and tick() - TB.lastHitTime > TB.targetMemoryDuration then TB.lastTarget = nil end
        local c = localPlayer.Character
        local root = TB.lastTarget and TB.lastTarget:FindFirstChild("HumanoidRootPart")
        if not (TB.lastTarget and c and c:FindFirstChild("HumanoidRootPart") and root) then return end
        if (c.HumanoidRootPart.Position - root.Position).Magnitude > TB.maxDistance then TB.lastTarget = nil return end
        TB.canGrab = false
        task.spawn(function()
            task.wait(TB.preGrabDelay)
            pcall(mouse1press)
            local t0 = tick()
            repeat task.wait(0.02) until not workspace_:FindFirstChild("GrabParts") or tick() - t0 > 1.6
            task.wait(TB.postGrabDelay)
            TB.canGrab = true TB.lastTarget = nil
        end)
    end

    makeToggle(aimTab, "Triggerbot V2 (Raycast)", false, function(on)
        TB.Enabled = on
        if on and not TB.Connection then TB.Connection = runService.Heartbeat:Connect(onHeartbeat)
        elseif not on and TB.Connection then TB.Connection:Disconnect() TB.Connection = nil end
    end)
    gui.Destroying:Connect(function() if TB.Connection then TB.Connection:Disconnect() end end)
end

