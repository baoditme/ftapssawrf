-- ============================================================
-- [LAG DETECTION] Line Lag + Packet Lag (FleetDisgrace port)
-- Detect khi người khác fire lag, tự bật Anti Lag + Anti Input Lag
-- Block self-notify: bỏ qua khi chính mình fire
-- ============================================================
do
    local _notifiedLine = false
    local _lastPacketTick = 0
    _G.RYZE_LastSelfLineFire = _G.RYZE_LastSelfLineFire or 0
    _G.RYZE_LastSelfPacketFire = _G.RYZE_LastSelfPacketFire or 0
    local SELF_GRACE = 0.5

    local function isSelfLine()   return (tick() - (_G.RYZE_LastSelfLineFire or 0)) < SELF_GRACE end
    local function isSelfPacket() return (tick() - (_G.RYZE_LastSelfPacketFire or 0)) < SELF_GRACE end

    local function autoEnableAntiLag()
        if _A and _A.toggles and _A.toggles.antiLag then
            pcall(function() _A.toggles.antiLag:Set(true) end)
            if _A.settings then _A.settings.AntiLag = true end
        end
        if _A and _A.toggles and _A.toggles.antiInputLag then
            pcall(function() _A.toggles.antiInputLag:Set(true) end)
            if _A.settings then _A.settings.AntiInputLag = true end
        end
    end

    task.spawn(function()
        local ge = ReplicatedStorage:WaitForChild("GrabEvents", 10)
        if not ge then return end

        -- ===== LINE LAG: notify 1 lần =====
        local cg = ge:WaitForChild("CreateGrabLine", 8)
        if cg then
            cg.OnClientEvent:Connect(function(arg, arg2, arg3)
                if typeof(arg) ~= "Instance" or not arg:IsA("Player") then return end
                if typeof(arg3) == "CFrame"
                    and (math.abs(arg3.X) > 30000 or math.abs(arg3.Y) > 30000 or math.abs(arg3.Z) > 30000) then
                    autoEnableAntiLag()
                    if arg == LocalPlayer then return end
                    if isSelfLine() then return end
                    if not _notifiedLine then
                        _notifiedLine = true
                        pcall(Notify, "Line Lag Detected!",
                            arg.DisplayName .. " (@" .. arg.Name .. ")", "warning", 4)
                    end
                end
            end)
        end

        -- ===== PACKET LAG: giữ logic gốc =====
        local eg = ge:WaitForChild("ExtendGrabLine", 8)
        if eg then
            eg.OnClientEvent:Connect(function(...)
                local player, maxLen = nil, 0
                for _, v in ipairs({...}) do
                    if typeof(v) == "Instance" and v:IsA("Player") then
                        player = v
                    elseif typeof(v) == "string" and #v > maxLen then
                        maxLen = #v
                    end
                end
                if maxLen <= 300 then return end
                if player == LocalPlayer then return end
                if isSelfPacket() then return end
                if not player then return end

                local now = tick()
                if now - _lastPacketTick < 0.1 then return end
                _lastPacketTick = now

                local mb = math.round(maxLen / 1048576 * 1000) / 1000
                local who = player.DisplayName .. " (@" .. player.Name .. ")"
                pcall(Notify, "Packet Lag Detected!", who .. " | " .. mb .. " MB", "warning", 4)

                autoEnableAntiLag()
            end)
        end
    end)
end



