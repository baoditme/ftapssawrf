        local tHum = tChar and tChar:FindFirstChild("Humanoid")
        if tHrp and tHum and tHum.Health > 0 and hrp then
            tHrp.Velocity = Vector3.zero
            if not flag then
                hrp.CFrame = tHrp.CFrame
                hrp.Velocity = Vector3.zero
                if tick() - n >= 0.002 then
                    n = tick()
                    pcall(function()
                        tHum.PlatformStand = true
                        tHum.Sit = true
                        grabEvents.SetNetworkOwner:FireServer(tHrp, hrp.CFrame)
                        grabEvents.DestroyGrabLine:FireServer(tHrp)
                    end)
                end
                if n2 == 0 then n2 = tick() end
                if tick() - n2 > 0.35 then
                    hrp.CFrame = cframe
                    hrp.Velocity = Vector3.zero
                    flag = true
                    n2 = 0
                end
            else
                hrp.CFrame = cframe
                hrp.Velocity = Vector3.zero
                local tcf = cframe * CFrame.new(0, 23, 0)
                tHrp.CFrame = tcf
                tHum.PlatformStand = true
                tHum.Sit = true
                if tick() - n >= 0.002 then
