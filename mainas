        makeSlider(funTab, "Stick" .. i .. " Left/Right", 0, -3, 3, function(v) sticks[i].x = v end)
        makeSlider(funTab, "Stick" .. i .. " Forward/Back", 0, -3, 3, function(v) sticks[i].z = v end)
    end
