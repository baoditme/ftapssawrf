    local function loopKickBlobFunction(arg)
        ensureBlobmanSit()
        local ge = replicatedStorage:WaitForChild("GrabEvents")
        local ch = localPlayer.Character or localPlayer.CharacterAdded:Wait()
        local hum = ch:WaitForChild("Humanoid")
        local seat = hum.SeatPart
        if not seat or seat.Parent.Name ~= "CreatureBlobman" then
            if hum.Sit then
                hum.Sit = false
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                task.wait(0.1)
            end
            local blob = spawnBlobmanIfNeeded()
            if not blob then
                Notify("Loop Kick", "Blob spawn fail.", "warning", 3)
                tbl2.loopKickBlobActive = false
                return
            end
            task.wait(0.1)
            sitOnBlobman(blob)
            task.wait(0.2)
            local tries = 0
            while tries < 20 and tbl2.loopKickBlobActive do
                ch = localPlayer.Character
                hum = ch and ch:FindFirstChildOfClass("Humanoid")
                seat = hum and hum.SeatPart
                if seat and seat.Parent.Name == "CreatureBlobman" then break end
                if blob and blob.Parent then sitOnBlobman(blob) end
                task.wait(0.1)
                tries += 1
            end
            if not (seat and seat.Parent.Name == "CreatureBlobman") then
                Notify("Loop Kick", "Cannot sit blob.", "warning", 3)
                tbl2.loopKickBlobActive = false
                return
            end
        end
        local parent = seat.Parent
        local hrp = parent:FindFirstChild("HumanoidRootPart") or parent.PrimaryPart
        local scr = parent:WaitForChild("BlobmanSeatAndOwnerScript")
        local CG = scr:WaitForChild("CreatureGrab")
        local CD = scr:WaitForChild("CreatureDrop")
        local R_Det = parent:WaitForChild("RightDetector")
        local skyCF = CFrame.new(20000, 20000, 20000)
        if tbl2.loopKickBlobMode == "TP to Sky" then
            ensureSkyKickFloor()
            local s2 = CFrame.new(20000, 20010.5, 20000)
            pcall(function() hrp.CFrame = s2 end)
            local h2 = ch:FindFirstChild("HumanoidRootPart")
            if h2 then pcall(function() h2.CFrame = s2 end) end
            task.wait(0.2)
            skyCF = s2
        end
        local useCF = tbl2.loopKickBlobMode == "TP to Sky" and skyCF or hrp.CFrame
        local flag = false
        local t1, t2 = 0, 0
        while tbl2.loopKickBlobActive do
            local p = Players:FindFirstChild(arg)
            if p then
                local c = localPlayer.Character
                local h = c and c:FindFirstChild("Humanoid")
                local s = h and h.SeatPart
                if s and s.Parent.Name == "CreatureBlobman" then
                    local blob = s.Parent
                    hrp = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
                    local tc = p.Character
                    local th = tc and tc:FindFirstChild("HumanoidRootPart")
                    local thum = tc and tc:FindFirstChild("Humanoid")
                    if th and thum and thum.Health > 0 and hrp then
                        th.Velocity = Vector3.zero
                        if not flag then
                            hrp.CFrame = th.CFrame
                            hrp.Velocity = Vector3.zero
                            if tick() - t1 >= 0.002 then
                                t1 = tick()
                                pcall(function()
                                    thum.PlatformStand = true
                                    thum.Sit = true
                                    ge.SetNetworkOwner:FireServer(th, hrp.CFrame)
                                    ge.DestroyGrabLine:FireServer(th)
                                end)
                            end
                            if t2 == 0 then t2 = tick() end
                            if tick() - t2 > 0.35 then
                                hrp.CFrame = useCF
                                hrp.Velocity = Vector3.zero
                                flag = true
                                t2 = 0
                            end
                        else
                            hrp.CFrame = useCF
                            hrp.Velocity = Vector3.zero
                            local lockCF = useCF * CFrame.new(0, 23, 0)
                            th.CFrame = lockCF
                            thum.PlatformStand = true
                            thum.Sit = true
                            if tick() - t1 >= 0.002 then
                                t1 = tick()
                                pcall(function()
                                    ge.SetNetworkOwner:FireServer(th, lockCF)
                                    ge.DestroyGrabLine:FireServer(th)
                                    local rw = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")
                                    if rw then
                                        CD:FireServer(rw)
                                        CG:FireServer(R_Det, th, rw)
                                    end
                                end)
                            end
                        end
                    else
                        flag = false t2 = 0
                    end
                    task.wait()
                    continue
                end
            end
            break
        end
        if hrp then hrp.CFrame = useCF hrp.Velocity = Vector3.zero end
        if tbl2.loopKickBlobMode == "TP to Sky" then removeSkyKickFloor() end
    end

