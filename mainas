-- ==========================================
if false then -- tắt: Module 13 đã có Silent Aim V2
    state.silent = {enabled = false, distance = 41, part = "Head", wallMode = "Wall"}
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local caller = checkcaller and checkcaller() or false
        if caller or not state.silent.enabled then
            return oldNamecall(self, ...)
        end
        if self ~= workspace_ then
            return oldNamecall(self, ...)
        end
        if getnamecallmethod() ~= "Raycast" then
            return oldNamecall(self, ...)
        end
        local args = {...}
        if not args[1] or not args[2] or typeof(args[3]) ~= "RaycastParams" then
            return oldNamecall(self, ...)
        end
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return oldNamecall(self, ...) end
        local cam = workspace.CurrentCamera
        local mouse = userInputService:GetMouseLocation()
        local best, bestD = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character then
                local th = p.Character:FindFirstChild(state.silent.part)
                    or p.Character:FindFirstChild("Head")
                local thum = p.Character:FindFirstChildOfClass("Humanoid")
                if th and thum and thum.Health > 0
                    and (hrp.Position - th.Position).Magnitude <= state.silent.distance then
                    local sp, vis = cam:WorldToViewportPoint(th.Position)
                    if vis then
                        local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
                        if state.silent.wallMode ~= "ThroughWall" then
                            local wc = RaycastParams.new()
                            wc.FilterType = Enum.RaycastFilterType.Exclude
                            wc.FilterDescendantsInstances = {char}
                            local wh = workspace:Raycast(cam.CFrame.Position,
                                th.Position - cam.CFrame.Position, wc)
                            if wh and not wh.Instance:IsDescendantOf(p.Character) then
                                d = math.huge
                            end
                        end
                        if d < bestD then bestD = d best = th end
                    end
                end
            end
        end
        if best then
            args[2] = (best.Position - args[1]).Unit * 1000
            args[3].FilterType = Enum.RaycastFilterType.Include
            args[3].FilterDescendantsInstances = {best.Parent}
        end
        return oldNamecall(self, table.unpack(args))
    end))

