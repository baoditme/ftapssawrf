-- MODULE 13: SILENT AIM V2
-- ==========================================
do
    local hasHook = (hookmetamethod ~= nil) and (newcclosure ~= nil) and (getnamecallmethod ~= nil)
    if not hasHook then
        makeSection(aimTab, "Silent Aim V2")
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 36)
        lbl.BackgroundColor3 = BG3
        lbl.TextColor3 = Color3.fromRGB(255, 130, 130)
        lbl.Font = Enum.Font.GothamSemibold
        lbl.TextSize = 12
        lbl.TextWrapped = true
        lbl.Text = "Executor không hỗ trợ hookmetamethod - Silent Aim V2 đã ẩn."
        lbl.Parent = aimTab
        Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 6)
    else
        state.silentAim = false
        state.silentDist = 41
        state.silentPart = "Head"
        state.silentWallMode = "Wall"

        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local caller = checkcaller and checkcaller() or false
            if caller or not state.silentAim then return oldNamecall(self, ...) end
            if self ~= workspace_ then return oldNamecall(self, ...) end
            if getnamecallmethod() ~= "Raycast" then return oldNamecall(self, ...) end
            local args = {...}
            if not args[1] or not args[2] or typeof(args[3]) ~= "RaycastParams" then return oldNamecall(self, ...) end
            local ch = localPlayer.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if not hrp then return oldNamecall(self, ...) end
            local cam = workspace.CurrentCamera
            local mouse = userInputService:GetMouseLocation()
            local best, bestD = nil, math.huge
            for _, p in ipairs(players:GetPlayers()) do
                if p ~= localPlayer and p.Character and not (state.isWL and state.isWL(p)) then
                    local t = p.Character:FindFirstChild(state.silentPart) or p.Character:FindFirstChild("Head")
                    local th = p.Character:FindFirstChildOfClass("Humanoid")
                    if t and th and th.Health > 0 and (hrp.Position - t.Position).Magnitude <= state.silentDist then
                        local sp, vis = cam:WorldToViewportPoint(t.Position)
                        if vis then
                            local d = (Vector2.new(sp.X, sp.Y) - mouse).Magnitude
                            if state.silentWallMode ~= "ThroughWall" then
                                local wp = RaycastParams.new()
                                wp.FilterType = Enum.RaycastFilterType.Exclude
                                wp.FilterDescendantsInstances = {ch}
                                local wh = workspace:Raycast(cam.CFrame.Position, t.Position - cam.CFrame.Position, wp)
                                if wh and not wh.Instance:IsDescendantOf(p.Character) then d = math.huge end
                            end
                            if d < bestD then bestD = d best = t end
                        end
                    end
                end
            end
            if best then
                args[2] = (best.Position - args[1]).Unit * 1000
                args[3].FilterType = Enum.RaycastFilterType.Include
                args[3].FilterDescendantsInstances = {best.Parent}
            end
            return oldNamecall(self, table.unpack(args))
        end))

        makeSection(aimTab, "Silent Aim V2")
        makeToggle(aimTab, "Silent Aim V2", false, function(on) state.silentAim = on end)
        makeSlider(aimTab, "Silent Distance", 41, 10, 300, function(v) state.silentDist = v end)
        makeDropdown(aimTab, "Silent Part", {"Head","HumanoidRootPart","Torso"}, "Head",
            function(v) state.silentPart = v end)
        makeDropdown(aimTab, "Silent Wall Mode", {"Wall","ThroughWall"}, "Wall",
            function(v) state.silentWallMode = v end)
    end
end

