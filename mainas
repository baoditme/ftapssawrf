                                gr(blob, d.hrp) task.wait() rr(blob, d.hrp) continue
                            end
                            break
                        end
                    end
                    if sno and d.hrp.Parent then for _ = 1, 4 do pcall(function() sno:FireServer(d.hrp, d.hrp.CFrame) end) end end
                    continue
                end
                break
            end
            local centerY = tbl2.gkaCenterY or 50
            local circleR = tbl2.gkaCircleRadius or 6
            local n = #tlist
            pcall(function()
                hrp.CFrame = CFrame.new(0, centerY, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end)
            task.wait(0.2)
            hrp.Anchored = true
            for i, d in ipairs(tlist) do
                local a = 6.2831853071795862 / n * (i - 1)
                local x, z = math.cos(a)*circleR, math.sin(a)*circleR
                pcall(function()
                    d.hrp.CFrame = CFrame.new(hrp.Position.X + x, centerY, hrp.Position.Z + z)
                    d.hrp.AssemblyLinearVelocity = Vector3.zero
                    d.hrp.AssemblyAngularVelocity = Vector3.zero
                end)
            end
            task.wait(0.2)
            if sno then
                for _, d in ipairs(tlist) do
                    if d.hrp.Parent then for _ = 1, 10 do pcall(function() sno:FireServer(d.hrp, d.hrp.CFrame) end) end end
                end
            end
            task.wait(0.1)
            for _, d in ipairs(tlist) do ug(d.hrp) end
            for _, d in ipairs(tlist) do dp(blob, d.hrp) end
            hrp.Anchored = false
            local t0 = os.clock()
            while os.clock() - t0 < 0.05 do
                for _, d in ipairs(tlist) do
                    task.spawn(function()
                        if d.hrp.Parent and blob.Parent then gr(blob, d.hrp) end
                    end)
                end
                task.wait()
            end
            for _, d in ipairs(ch:GetDescendants()) do
                if d:IsA("BasePart") and collide[d] ~= nil then d.CanCollide = collide[d] end
            end
            Notify("GatherKick", "Orbit start.", "info", 3)
            local orbitR = tbl2.gkaBlobRotateRadius or 18
            if not blob.Parent then
                pcall(function()
                    hrp.CFrame = CFrame.new(0, centerY + 3, orbitR)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end)
                task.wait(0.2)
                blob = ensureBlobmanSit()
                if not blob then gkaStop() return end
                task.wait(0.35)
            end
            local bpList = {}
            for i, d in ipairs(tlist) do
                if d.hrp.Parent then
                    local a = 6.2831853071795862 / n * (i - 1)
                    local x, z = math.cos(a)*circleR, math.sin(a)*circleR
                    pcall(function()
                        d.hrp.CFrame = CFrame.new(x, centerY, z)
                        d.hrp.AssemblyLinearVelocity = Vector3.zero
                    end)
                    local bp = Instance.new("BodyPosition")
                    bp.MaxForce = Vector3.new(4e9, 5e9, 4e9)
                    bp.P = 100000000 bp.D = 10000
                    bp.Position = Vector3.new(x, centerY, z)
                    bp.Parent = d.hrp
                    table.insert(bpList, bp)
                end
            end
            gka_list = tlist
            task.delay(8, function()
                for _, bp in ipairs(bpList) do pcall(function() bp:Destroy() end) end
            end)
            local t1, t2 = 0, 0
            local rotSpeed = tbl2.gkaBlobRotateSpeed or 4
            gka_conn = runService.RenderStepped:Connect(function(dt)
                if not gka_active then
                    pcall(function() gka_conn:Disconnect() end)
                    gka_conn = nil
                    return
                end
                if not blob or not blob.Parent then return end
                t1 -= dt
                if t1 <= 0 then
                    t1 = 0.5
                    local h = ch:FindFirstChildOfClass("Humanoid")
                    if not (h and h.SeatPart) then task.spawn(function() sitOnBlobman(blob) end) end
                end
                t2 -= dt
                if t2 <= 0 then
                    t2 = 3
                    local alive = false
                    for _, d in ipairs(gka_list) do
                        if d.player and d.player.Parent then alive = true break end
                    end
                    if not alive then
                        Notify("GatherKick", "All gone.", "info", 3)
                        task.spawn(gkaStop)
                        return
                    end
                    pcall(function() startLineLag() end)
                end
                gka_rot += rotSpeed * dt
                local x, z = math.cos(gka_rot)*orbitR, math.sin(gka_rot)*orbitR
                local bh = blob:FindFirstChild("HumanoidRootPart") or blob:FindFirstChildWhichIsA("BasePart", true)
                if bh then
                    pcall(function()
                        bh.AssemblyLinearVelocity = (Vector3.new(x, centerY + 2, z) - bh.Position) * 60
                        bh.CFrame = CFrame.new(bh.Position) * CFrame.Angles(0, -(gka_rot + 1.5707963267948966), 0)
                    end)
                end
                local cnt = #gka_list
                if cnt > 0 then
                    local d = gka_list[math.random(1, cnt)]
                    if d and d.hrp and d.hrp.Parent then
                        task.spawn(function() gr(blob, d.hrp) end)
                    end
                    for i, d2 in ipairs(gka_list) do
                        if d2.hrp and d2.hrp.Parent then
                            local a = 6.2831853071795862 / cnt * (i - 1)
                            pcall(function()
                                d2.hrp.CFrame = CFrame.new(math.cos(a)*circleR, centerY, math.sin(a)*circleR)
                                d2.hrp.AssemblyLinearVelocity = Vector3.zero
                            end)
                        end
                    end
                end
            end)
        end)
    end

