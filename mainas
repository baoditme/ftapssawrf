    local function silentAimFunc(p1, p2)
        if not SAH.enabled or not hookSupported or not raycastFromCam then return raycastFromCam(p1, p2) end
        local best, bestD = nil, math.huge
        for _, pl in pairs(players:GetPlayers()) do
