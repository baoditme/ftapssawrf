    function serializeValue(val)
        local t = typeof(val)
        if t == "number" or t == "string" or t == "boolean" then
            return val
        elseif t == "EnumItem" then
            -- FIX: Lấy đúng tên Enum (VD: KeyCode thay vì Enum.KeyCode)
