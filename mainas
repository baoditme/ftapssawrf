            uLighting.Brightness = p.Brightness or 2
            uLighting.ClockTime = p.ClockTime or 14
            uLighting.ExposureCompensation = p.ExposureCompensation or 0
            uLighting.Ambient = p.Ambient or Color3.fromRGB(120,120,120)
            uLighting.OutdoorAmbient = p.OutdoorAmbient or Color3.fromRGB(200,200,200)
