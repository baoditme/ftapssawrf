-- Dữ liệu lấy từ SAVITAR: tên hitbox + part để chiếm ownership
local EXP_HIT = {
    BombMissile = "PartHitDetector", BombDarkMatter = "PartHitDetector",
    FireworkMissile = "PartHitDetector", BombBalloon = "Balloon",
    PresentBig = "Box", PresentSmall = "Box", BallSnowball = "SoundPart",
}
local EXP_OWN = {
    BombMissile = "Body", BombDarkMatter = "Pyramid", FireworkMissile = "Hitbox",
    BombBalloon = "Balloon", PresentBig = "Box", PresentSmall = "Box", BallSnowball = "SoundPart",
}

function ExplodeAt(posPart, pos, typeName)
    local be = replicatedStorage:FindFirstChild("BombEvents")
    local remote = be and be:FindFirstChild("BombExplode")
    if not remote then return false end
    local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local toy = NewToy(typeName, hrp.CFrame * CFrame.new(0, 5, 10))
    if not toy then return false end
    local hit = toy:FindFirstChild(EXP_HIT[typeName], true)
    local own = toy:FindFirstChild(EXP_OWN[typeName], true) or toy.PrimaryPart or hit
    if not (hit and own) then DestroyT(toy) return false end

    local t0 = tick()
    while tick() - t0 < 1 do
        setNetworkOwner:FireServer(own, own.CFrame)
        local po = own:FindFirstChild("PartOwner")
        if po and po.Value == localPlayer.Name then break end
        runService.RenderStepped:Wait()
    end
    pcall(function()
        remote:FireServer({Hitbox = hit, Model = toy, PositionPart = posPart or own}, pos)
    end)
    task.delay(0.4, function() DestroyT(toy) end)
    return true
end

function RunExplosions()
    for _ = 1, state.expAmount do
        if state.expMode == "Mouse" then
            local p = localPlayer:GetMouse().Hit.Position
            ExplodeAt(nil, p, state.expType)
        else
            local list = {}
            if state.expMode == "All Server" then
                for _, p in ipairs(players:GetPlayers()) do
                    if p ~= localPlayer and not (state.isWL and state.isWL(p)) then table.insert(list, p) end
                end
            elseif state.expTarget and players:FindFirstChild(state.expTarget) then
                table.insert(list, players[state.expTarget])
            end
            for _, p in ipairs(list) do
                local th = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if th then ExplodeAt(th, th.Position, state.expType) end
            end
        end
        task.wait(0.1)
    end
end

