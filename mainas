            while _K.settings.loopGrabV2On do
                RunService.RenderStepped:Wait()
                local target = _K.target and Players:FindFirstChild(_K.target)
                if not target then continue end
                etc.TargetPLR = target
                etc.Head = target.Character and target.Character:FindFirstChild("Head")
                etc.Root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                etc.Hum = target.Character and target.Character:FindFirstChild("Humanoid")
                local myChar = _K_lc()
                local currentHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not currentHRP then continue end
                local BodyPos = etc.Root and etc.Root:FindFirstChild("BodyPosition")
                if (etc.Head and etc.Hum and etc.Root and etc.Hum.Health > 0) and (currentHRP.Position - etc.Root.Position).Magnitude <= 30 then
                    if not BodyPos then
                        BodyPos = Instance.new("BodyPosition")
                        BodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        BodyPos.Parent = etc.Root
                        BodyPos.P = 75000
                        BodyPos.D = 12000
                    end
                    BodyPos.Position = currentHRP.Position + Vector3.new(0, 15, 0)
                    local isHeld = target:FindFirstChild("IsHeld")
                    if (etc.Root.Position.Y <= currentHRP.Position.Y + 15) and (isHeld and isHeld.Value) then
                        for _, v in pairs(target.Character:GetChildren()) do
                            if v:IsA("Part") then
                                v.CFrame = currentHRP.CFrame * CFrame.new(0, 15, 0)
                            end
                        end
                    end
                    etc.Root.AssemblyAngularVelocity = Vector3.zero
                    etc.Root.AssemblyLinearVelocity = Vector3.zero
                    etc.Hum.PlatformStand = true
                    _K_sno(etc.Root)
                    RunService.RenderStepped:Wait()
                    _K_sno(etc.Root)
                    pcall(function() destroyGrabLine:FireServer(etc.Root) end)
                    RunService.RenderStepped:Wait()
                    _K_sno(etc.Root)
                    RunService.RenderStepped:Wait()
                    pcall(function() destroyGrabLine:FireServer(etc.Root) end)
                else
                    if not etc.Head or not etc.Hum or etc.Hum.Health <= 0 then
                        local newChar = target.CharacterAdded:Wait()
                        etc.Head = newChar:WaitForChild("Head", 5)
                        etc.Hum = newChar:WaitForChild("Humanoid", 5)
                        etc.Root = newChar:WaitForChild("HumanoidRootPart", 5)
                        if etc.Root then
                            BodyPos = Instance.new("BodyPosition")
                            BodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            BodyPos.Parent = etc.Root
                            BodyPos.P = 75000
                            BodyPos.D = 12000
                            BodyPos.Position = currentHRP.Position + Vector3.new(0, 15, 0)
                        end
                    end
                    local oldCF = currentHRP.CFrame
                    while (etc.Head and etc.Hum and etc.Hum.Health > 0) and task.wait(0.01) and _K.settings.loopGrabV2On do
                        local t2 = _K.target and Players:FindFirstChild(_K.target)
                        if not t2 then break end
                        local inPlot = t2:FindFirstChild("InPlot")
                        if inPlot and inPlot.Value then continue end
                        etc.Head = t2.Character and t2.Character:FindFirstChild("Head")
                        etc.Hum = t2.Character and t2.Character:FindFirstChild("Humanoid")
                        if not etc.Head or not etc.Hum then break end
                        myChar:PivotTo(etc.Head.CFrame * CFrame.new(0, 10, 0))
                        _K_sno(etc.Head)
                        local po = etc.Head:FindFirstChild("PartOwner")
                        if po and po.Value == LocalPlayer.Name then break end
                    end
                    currentHRP.CFrame = oldCF
                    local po2 = etc.Head and etc.Head:FindFirstChild("PartOwner")
                    if po2 and po2.Value == LocalPlayer.Name then
                        for _, v in pairs(target.Character:GetChildren()) do
                            if v:IsA("BasePart") then
                                v.CFrame = currentHRP.CFrame * CFrame.new(0, 15, 0)
                            end
                        end
                    end
                end
            end
            if etc.Root then
                for _, v in pairs(etc.Root:GetChildren()) do
                    if v:IsA("BodyPosition") then pcall(function() v:Destroy() end) end
                end
            end
        end)
    end,
})

