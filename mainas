-- Dropdown danh sách người chơi, tự làm mới mỗi lần mở
function makePlayerDropdown(parent, text, cb)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 34)
    frame.BackgroundColor3 = BG3
    frame.BorderSizePixel = 0
    frame.ZIndex = 5
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = text .. ":  ---"
    btn.TextColor3 = TEXT
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = 6
    btn.Parent = frame
    Instance.new("UIPadding", btn).PaddingLeft = UDim.new(0, 10)

    local list
    function close()
        if list then list:Destroy() list = nil end
        frame.ZIndex = 5
    end

    btn.MouseButton1Click:Connect(function()
        if list then close() return end
        frame.ZIndex = 100
        local names = {}
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= localPlayer then table.insert(names, p.Name) end
        end
        if #names == 0 then names = {"(no players)"} end

        list = Instance.new("ScrollingFrame")
        list.Size = UDim2.new(1, 0, 0, math.min(#names * 26, 200))
        list.Position = UDim2.new(0, 0, 1, 4)
        list.BackgroundColor3 = BG
        list.BorderSizePixel = 0
        list.ZIndex = 101
        list.ScrollBarThickness = 3
        list.CanvasSize = UDim2.new(0, 0, 0, #names * 26)
        list.Parent = frame
        Instance.new("UICorner", list).CornerRadius = UDim.new(0, 6)
        Instance.new("UIListLayout", list)

        for _, n in ipairs(names) do
            local ob = Instance.new("TextButton")
            ob.Size = UDim2.new(1, 0, 0, 26)
            ob.BackgroundColor3 = BG
            ob.Text = "  " .. n
            ob.TextColor3 = TEXT
            ob.Font = Enum.Font.Gotham
            ob.TextSize = 11
            ob.TextXAlignment = Enum.TextXAlignment.Left
            ob.ZIndex = 102
            ob.Parent = list
            ob.MouseEnter:Connect(function() ob.BackgroundColor3 = BG3 end)
            ob.MouseLeave:Connect(function() ob.BackgroundColor3 = BG end)
            ob.MouseButton1Click:Connect(function()
                if n ~= "(no players)" then
                    btn.Text = text .. ":  " .. n
                    pcall(cb, n)
                    if _G.QueueSave then _G.QueueSave() end
                end
                close()
            end)
        end
    end)
    return frame
end

