function _A_feature.startAntiGucciTrain()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")
    _A.state.antiGucci.safePositionTrain = rootPart.CFrame
    _A.state.antiGucci.hasSatThisLife = false
    _A.state.antiGucci.sitTimerTrain = nil

    local function returnToOriginal()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hrp and _A.state.antiGucci.safePositionTrain then
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                hum.Sit = false
            end
            task.wait(0.05)
            hrp.CFrame = _A.state.antiGucci.safePositionTrain
        end
    end

    local function onSitSuccess()
        if _A.state.antiGucci.hasSatThisLife then return end
        _A.state.antiGucci.hasSatThisLife = true
        if _A.state.antiGucci.sitTimerTrain then _A.state.antiGucci.sitTimerTrain:Cancel() end
        _A.state.antiGucci.sitTimerTrain = task.delay(0.1, function()
            _A.state.antiGucci.sitTimerTrain = nil
        end)
    end

    local function sitAndJumpWarp(seat)
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or not seat then return end

        _A.state.antiGucci.safePositionTrain = hrp.CFrame
        hrp.CFrame = seat.CFrame + Vector3.new(0, 0.5, 0)

        local success = pcall(function() seat:Sit(hum) end)
        if success then
            task.wait(0.1)
            returnToOriginal()
        else
            returnToOriginal()
        end
    end

    local function getTrainSeat()
        local success, seat = pcall(function()
            return Workspace.Map.AlwaysHereTweenedObjects.Train.Object.ObjectModel:FindFirstChildWhichIsA("Seat")
        end)
        if success then return seat end
        return nil
    end

    if _A.state.antiGucci.connectionTrain then _A.state.antiGucci.connectionTrain:Disconnect() end
    local lastRagdollFire = 0
    _A.state.antiGucci.connectionTrain = RunService.Heartbeat:Connect(function()
        if not _A.settings.AntiGucciTrain then return end
        local now = tick()
        if now - lastRagdollFire < 0.033 then return end
        lastRagdollFire = now
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then ragdollRemote:FireServer(hrp, 0) end
    end)

    if _A.state.antiGucci.trainCharConn then _A.state.antiGucci.trainCharConn:Disconnect() end
    _A.state.antiGucci.trainCharConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        _A.state.antiGucci.hasSatThisLife = false
        _A.state.antiGucci.sitTimerTrain = nil
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then _A.state.antiGucci.safePositionTrain = hrp.CFrame end
    end)

    _A.state.antiGucci.trainGucciLoop = true
    _A.state.antiGucci.trainGucciThread = task.spawn(function()
        while _A.state.antiGucci.trainGucciLoop do
            pcall(function()
                if _A.settings.AntiGucciTrain then
                    local shouldTry = (not _A.state.antiGucci.hasSatThisLife
                        or (_A.state.antiGucci.sitTimerTrain and _A.state.antiGucci.hasSatThisLife))
                    if shouldTry then
                        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                        if hum and not hum.Sit then
                            local seat = getTrainSeat()
                            if seat then
                                sitAndJumpWarp(seat)
                                onSitSuccess()
                            end
                        end
                    end
                end
            end)
            task.wait(0.016)
        end
    end)
end

function _A_feature.stopAntiGucciTrain()
    _A.settings.AntiGucciTrain = false
    _A.state.antiGucci.trainGucciLoop = false
    _A.state.antiGucci.hasSatThisLife = false
    if _A.state.antiGucci.sitTimerTrain then
        _A.state.antiGucci.sitTimerTrain:Cancel()
        _A.state.antiGucci.sitTimerTrain = nil
    end
    if _A.state.antiGucci.trainGucciThread then
        task.cancel(_A.state.antiGucci.trainGucciThread)
