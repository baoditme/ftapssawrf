    Fun.startHipDanceV2 = function(char)
        if not Fun.activeDanceDataV2 then return end
        Fun.stopHipDanceV2(char)
        local rootPart = char:WaitForChild("HumanoidRootPart")
        local humanoid = char:WaitForChild("Humanoid")
        if Fun.RagdollRemote then
            Fun.RagdollRemote:FireServer(rootPart, 9999999)
        else
            humanoid.PlatformStand = true
            humanoid.AutoRotate = false
        end
        local pos = rootPart.Position
        local walkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
        local n = #Fun.activeDanceDataV2.frames
        if n == 0 then return end
        Fun.frameIndexV2 = 1
        Fun.frameTimerV2 = 0
        local function parseCFrameData(arr)
            return CFrame.new(arr[1], arr[2], arr[3], arr[4], arr[5], arr[6], arr[7], arr[8], arr[9], arr[10], arr[11], arr[12])
        end
        Fun.poseConnectionV2 = Fun.RunService.Heartbeat:Connect(function(dt)
            if not char or not char.Parent or not rootPart or not rootPart.Parent then return end
            local look = Fun.camera.CFrame.LookVector
            local yaw = math.atan2(-look.X, -look.Z)
            local p2 = rootPart.Position
            if (p2 - pos).Magnitude > 8 then pos = p2 end
            local md = humanoid.MoveDirection
            if md.Magnitude > 0.01 then pos = pos + md * walkSpeed * dt end
            local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
            rootPart.CFrame = cf
            rootPart.AssemblyLinearVelocity = Vector3.zero
            Fun.frameTimerV2 = Fun.frameTimerV2 + dt
            local flag = false
            if Fun.activeDanceDataV2.interval <= Fun.frameTimerV2 then
                Fun.frameTimerV2 = Fun.frameTimerV2 - Fun.activeDanceDataV2.interval
                Fun.frameIndexV2 = Fun.frameIndexV2 + 1
                if n < Fun.frameIndexV2 then
                    Fun.frameIndexV2 = 1
                    flag = true
                end
            end
            local v5 = Fun.activeDanceDataV2.frames[Fun.frameIndexV2]
            local v6 = Fun.activeDanceDataV2.frames[Fun.frameIndexV2 < n and Fun.frameIndexV2 + 1 or 1]
            flag = flag and 1 or Fun.frameTimerV2 / Fun.activeDanceDataV2.interval
            for k, part in pairs(v5.parts) do
                if not skipParts[k] then
                    local partObj = char:FindFirstChild(k)
                    if partObj and partObj:IsA("BasePart") then
                        local v8 = v6.parts[k] or part
                        partObj.CFrame = cf * parseCFrameData(part):Lerp(parseCFrameData(v8), flag)
                        partObj.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        end)
    end

