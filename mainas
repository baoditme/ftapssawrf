function getOceanParts()
    local out = {}
    local map = workspace_:FindFirstChild("Map")
    if map then
        local ahto = map:FindFirstChild("AlwaysHereTweenedObjects")
        local ocean = ahto and ahto:FindFirstChild("Ocean")
        local obj = ocean and ocean:FindFirstChild("Object")
        local om = obj and obj:FindFirstChild("ObjectModel")
        if om then
            for _, p in ipairs(om:GetDescendants()) do
                if p:IsA("BasePart") then table.insert(out, p) end
            end
        end
    end
    return out
end

