-- PRESET HELPERS
-- ==========================================
function _getPresetByName(name)
    for _, p in ipairs(THEME_PRESETS) do
        if p.name == name then return p end
    end
    return nil
end

function applyThemePreset(presetName)
    local preset = _getPresetByName(presetName)
    if not preset then return false, "Theme not found" end

    -- Apply color scheme immediately
    _applyThemeColors(presetName)

    -- Default: no image (Roblox ID)
    if preset.link == "" then
        _G.RYZEBgUrl = nil
        _G.RYZEBgLink = ""
        _G.RYZEBgName = preset.cache
        state.bgLink = ""
        state.bgName = preset.cache
        state.themeName = presetName
        if bgImage and bgImage.Parent then
            bgImage.Image = "rbxassetid://132880483631327"
        end
        return true
    end

    -- Try cache first
    local cached = _loadBgFromCache(preset.cache)
    if cached then
        _G.RYZEBgUrl = cached
        _G.RYZEBgLink = preset.link
        _G.RYZEBgName = preset.cache
        state.bgLink = preset.link
        state.bgName = preset.cache
        state.themeName = presetName
        if bgImage and bgImage.Parent then
            bgImage.Image = cached
        end
        return true
    end

    -- Download fresh
    local url, path = _downloadDriveImage(preset.link, preset.cache)
    if not url then return false, path or "Download failed" end

    _G.RYZEBgUrl = url
    _G.RYZEBgLink = preset.link
    _G.RYZEBgName = preset.cache
    state.bgLink = preset.link
    state.bgName = preset.cache
    state.themeName = presetName
    if bgImage and bgImage.Parent then
        bgImage.Image = url
    end
    return true
end

