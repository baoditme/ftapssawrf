        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local folder = workspace_:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        if not folder then return end

        -- Destroy existing sparklers first
        for _, c in ipairs(folder:GetChildren()) do
            if c.Name == "FireworkSparkler" then
                pcall(function() destroyToyRemote:FireServer(c) end)
                task.wait(0.03)
            end
        end
        shape.toys = {}
        task.wait(0.2)

        local targetRoot = getTargetRoot() or hrp
        local spawnCF = targetRoot.CFrame * CFrame.new(0, 100, 0)

        for _ = 1, n do
            local canSpawn = localPlayer:FindFirstChild("CanSpawnToy")
            local inPlot = localPlayer:FindFirstChild("InPlot")
            if canSpawn and canSpawn.Value and not (inPlot and inPlot.Value) then
                pcall(function() spawnToyRemote:InvokeServer("FireworkSparkler", spawnCF, Vector3.zero) end)
                task.wait(0.1)
            else
                task.wait(0.2)
            end
        end
        task.wait(0.3)

        local count = 0
        for _, c in ipairs(folder:GetChildren()) do
            if c.Name == "FireworkSparkler" and count < n then
                count = count + 1
                table.insert(shape.toys, c)
            end
        end
    end

    local function computeWorldPos(targetRoot, t)
        local fn = shapeFunctions[shape.type] or shapeFunctions.Heart
        local localPt = fn(t) * shape.size
        local rotCF = CFrame.Angles(0, math.rad(shape.rotOffset + shape.phase), 0)
        local rotated = rotCF * localPt
        local base = targetRoot.CFrame * CFrame.new(0, shape.heightOffset, 0)
        return (base * CFrame.new(rotated.X, rotated.Y, rotated.Z)).Position
    end

    local function start()
        cleanup()
        local targetRoot = getTargetRoot()
        if not targetRoot then
            pcall(Notify, "Shape", "No character / target", "warning", 2)
            return
        end
        shape.enabled = true
        shape.phase = 0
        rebuildHandles(shape.amount)
        spawnToys(shape.amount)

        shape.conns[#shape.conns + 1] = runService.Heartbeat:Connect(function(dt)
            if not shape.enabled then return end
            shape.phase = shape.phase + dt * shape.rotSpeed

            local root = getTargetRoot()
            if not root then return end

            local n = #shape.handles
            if n == 0 then return end

            for i = 1, n do
                local t = (i - 1) / n * math.pi * 2
                local worldPos = computeWorldPos(root, t)
                local handle = shape.handles[i]
                handle.CFrame = CFrame.new(worldPos)

                local toy = shape.toys[i]
                if toy and toy.Parent then
                    local part = findToyPart(toy)
                    if part then
                        pcall(function() setNetworkOwner:FireServer(part, part.CFrame) end)

                        local bp = part:FindFirstChild("_RYZE_ShapeBP")
                        if not bp then
                            bp = Instance.new("BodyPosition")
                            bp.Name = "_RYZE_ShapeBP"
                            bp.MaxForce = Vector3.new(1e10, 1e10, 1e10)
                            bp.P = 50000
                            bp.D = 1000
                            bp.Parent = part
                        end
                        bp.Position = worldPos

                        local bg = part:FindFirstChild("_RYZE_ShapeBG")
                        if not bg then
                            bg = Instance.new("BodyGyro")
                            bg.Name = "_RYZE_ShapeBG"
                            bg.MaxTorque = Vector3.new(1e10, 1e10, 1e10)
                            bg.P = 50000
                            bg.D = 1000
                            bg.Parent = part
                        end
                        bg.CFrame = CFrame.new(worldPos)

                        part.CanCollide = false
                        part.CanTouch = false
                    end
                end
            end
        end)

        pcall(Notify, "Shape", "Sparkle Shape ON: " .. shape.type, "success", 2)
    end

    makeSection(funTab, "🎆 Sparkle Shape (Fun)")
    makeDropdown(funTab, "Shape Type", shapeNames, "Heart", function(v)
        shape.type = v
        if shape.enabled then start() end
    end)
    makeSlider(funTab, "Shape Amount", 10, 3, 20, function(v)
        shape.amount = v
        if shape.enabled then start() end
    end)
    makeSlider(funTab, "Shape Size", 1.5, 0.5, 5, function(v) shape.size = v end)
    makeSlider(funTab, "Height Above", 12, 0, 60, function(v) shape.heightOffset = v end)
    makeSlider(funTab, "Rotation Offset", 0, -180, 180, function(v) shape.rotOffset = v end)
    makeSlider(funTab, "Rotation Speed", 20, 0, 200, function(v) shape.rotSpeed = v end)

    if state.makePlayerDropdown then
        state.makePlayerDropdown(funTab, "Shape Target", function(n) shape.target = n end)
    end

    makeToggle(funTab, "Enable Sparkle Shape", false, function(on)
        if on then start() else cleanup() end
    end)
    makeButton(funTab, "Refresh Shape", function()
        if shape.enabled then start() end
    end)
    gui.Destroying:Connect(cleanup)
end

