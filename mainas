local autoSpinActive = false
local autoSpinTask = nil

-- Check if all slot light balls are in Neon state
local function areAllSlotsNeon()
    local slotsFolder = Workspace:FindFirstChild("Slots")
    if not slotsFolder then return false end
    for _, slot in pairs(slotsFolder:GetChildren()) do
        local slotHandle = slot:FindFirstChild("SlotHandle")
        local lightBall = slotHandle and slotHandle:FindFirstChild("LightBall")
        if not (lightBall and lightBall.Material == Enum.Material.Neon) then
            return false
        end
    end
    return true
end

-- Matrix lookAt calculation matching Bloody logic[cite: 3]
local function _slotLookAt(startPos, targetPos)
    local dir = (targetPos - startPos).Unit
    local right = dir:Cross(Vector3.new(0, 1, 0))
    local up = right:Cross(dir)
    return CFrame.fromMatrix(startPos, right, up)
end

-- Teleport and ownership claim helper[cite: 3]
local function _teleportCharacter(targetCF)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = targetCF
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function _claimSlotOwnership(part, hrp)
    if part and hrp and setNetOwner then
        pcall(function()
            setNetOwner:FireServer(part, _slotLookAt(hrp.Position, part.Position))
        end)
    end
end

ServerTab:CreateToggle({
    Name = "Enable Auto-Spin (Casino)",
    Default = false,
    Callback = function(on)
        autoSpinActive = on
        if autoSpinTask then
            pcall(task.cancel, autoSpinTask)
            autoSpinTask = nil
        end
        if not on then
            Notify("Slots", "Auto-Spin stopped", "info", 2)
            return
        end

        Notify("Slots", "Auto-Spin started (Bloody engine)", "success", 2)
        autoSpinTask = task.spawn(function()
            while autoSpinActive do
                local slotsFolder = Workspace:FindFirstChild("Slots")
                if slotsFolder and areAllSlotsNeon() then
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local savedPosition = hrp.CFrame
                        for _, slot in pairs(slotsFolder:GetChildren()) do
                            if not autoSpinActive then break end
                            local slotHandle = slot:FindFirstChild("SlotHandle")
                            local handle = slotHandle and slotHandle:FindFirstChild("Handle")
                            if handle and handle:IsA("BasePart") then
                                handle.CanCollide = false
                                for i = 1, 10 do
                                    if not autoSpinActive then break end
                                    _teleportCharacter(handle.CFrame + Vector3.new(0, 5, 0))
                                    _claimSlotOwnership(handle, hrp)
                                    task.wait(0.15)
                                end
                                handle.CanCollide = true
                                task.wait(0.4)
                                if not areAllSlotsNeon() then
                                    break
                                end
                            end
                        end
                        _teleportCharacter(savedPosition)
                    end
                end
                task.wait(3)
            end
        end)
    end,
})

