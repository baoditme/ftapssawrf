    local tentConns, tentSegs = {}, {}
    local sticks = {}
    for i = 1, 4 do
        sticks[i] = { x=0, y=0, z=0, trackingTarget=nil, trackingEnabled=false }
    end
    local stickCount, bendStrength, twistAngle = 1, 40, 0
    local spacing, SEG_PER = 4, 6
    local wiggle, wiggleSpeed, wiggleTime = false, 1, 0
    local searchMode = "My Toys"
    _G.TentacleActive = false
    local OFFS = { {0}, {-2.5, 2.5}, {-4, 0, 4}, {-5, -1.7, 1.7, 5} }

