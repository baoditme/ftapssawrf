local activeNotifs = {}
local NOTIF_HEIGHT, NOTIF_GAP = 68, 8

function Notify(title, desc, ntype, duration)
    ntype = ntype or "info"
    if state.muteNotif and state.muteNotif[ntype] then return end
    duration = duration or 3.5
    local color = NOTIF_COLORS[ntype] or NOTIF_COLORS.info

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 320, 0, NOTIF_HEIGHT)
    frame.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = notifyContainer

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Thickness = 1
    stroke.Transparency = 0.92
    stroke.Parent = frame

    -- Icon chữ cái đầu
    local iconBg = Instance.new("Frame")
    iconBg.Size = UDim2.new(0, 28, 0, 28)
    iconBg.Position = UDim2.new(0, 12, 0, 10)
    iconBg.BackgroundColor3 = color
    iconBg.BackgroundTransparency = 0.85
    iconBg.BorderSizePixel = 0
    iconBg.Parent = frame
    Instance.new("UICorner", iconBg).CornerRadius = UDim.new(0, 6)

    local iconText = Instance.new("TextLabel")
    iconText.Size = UDim2.new(1, 0, 1, 0)
    iconText.BackgroundTransparency = 1
    iconText.Text = string.sub(title, 1, 1):upper()
    iconText.TextColor3 = color
    iconText.Font = Enum.Font.GothamBold
    iconText.TextSize = 14
    iconText.Parent = iconBg

    -- Tiêu đề thông báo
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -54, 0, 18)
    titleLabel.Position = UDim2.new(0, 48, 0, 8)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(245, 245, 250)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 13
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = frame

    -- Nội dung thông báo
    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(1, -54, 0, 30)
    descLabel.Position = UDim2.new(0, 48, 0, 26)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = desc
    descLabel.TextColor3 = Color3.fromRGB(150, 150, 165)
    descLabel.Font = Enum.Font.GothamMedium
    descLabel.TextSize = 11
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.TextWrapped = true
    descLabel.TextYAlignment = Enum.TextYAlignment.Top
    descLabel.Parent = frame

    -- Thanh thời gian mỏng tinh tế ở đáy
    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(1, 0, 0, 2)
    barFill.Position = UDim2.new(0, 0, 1, -2)
    barFill.BackgroundColor3 = color
    barFill.BorderSizePixel = 0
    barFill.Parent = frame

    frame.Position = UDim2.new(1, 360, 0, 0)
    table.insert(activeNotifs, 1, frame)

    for i, f in ipairs(activeNotifs) do
        local targetY = (i - 1) * (NOTIF_HEIGHT + NOTIF_GAP)
        tweenService:Create(f, TweenInfo.new(f == frame and 0.35 or 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.new(0, 0, 0, targetY) }):Play()
    end

    tweenService:Create(barFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()

    task.delay(duration, function()
        for i, f in ipairs(activeNotifs) do
            if f == frame then table.remove(activeNotifs, i) break end
        end
        tweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Position = UDim2.new(1, 360, 0, frame.Position.Y.Offset) }):Play()
        for i, f in ipairs(activeNotifs) do
            tweenService:Create(f, TweenInfo.new(0.25, Enum.EasingStyle.Quart), { Position = UDim2.new(0, 0, 0, (i - 1) * (NOTIF_HEIGHT + NOTIF_GAP)) }):Play()
        end
        task.wait(0.35)
        frame:Destroy()
    end)
end

