-- Extract FILE_ID from any Drive link format
function _extractDriveId(link)
    if not link or link == "" then return nil end
    return link:match("/file/d/([%w_-]+)")
        or link:match("[?&]id=([%w_-]+)")
        or link:match("/d/([%w_-]+)")
end

-- Download image from Drive, returns (url, path) or (nil, errorMsg)
function _downloadDriveImage(link, name)
    name = name or "RYZE_bg"
    local fileId = _extractDriveId(link)
    if not fileId then return nil, "Invalid link" end
    local URL = "https://drive.usercontent.google.com/download?id=" .. fileId .. "&export=download&confirm=t"
    local http = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
    if not (http and writefile) then return nil, "Executor missing http/writefile" end
    local ok, res = pcall(function() return http({Url = URL, Method = "GET"}) end)
    if not (ok and res and res.Body and #res.Body > 100) then return nil, "Download failed" end
    if res.Body:sub(1,1) == "<" then return nil, "Drive file is private or warning page" end
    local ext = "jpg"
    if string.byte(res.Body,1) == 0x89 then ext = "png" end
    local path = name .. "." .. ext
    -- Delete old cache (both .png and .jpg)
    for _, e in ipairs({".png", ".jpg"}) do
        local old = name .. e
        if isfile and isfile(old) then pcall(function() delfile(old) end) end
    end
    writefile(path, res.Body)
    local url = nil
    if getcustomasset then
        local ok2, u = pcall(getcustomasset, path)
        if ok2 then url = u end
    end
    if not url and getsynasset then
        local ok3, u = pcall(getsynasset, path)
        if ok3 then url = u end
    end
    return url, path
end

-- Load image from cache (no re-download)
function _loadBgFromCache(name)
    name = name or "RYZE_bg"
    for _, ext in ipairs({".png", ".jpg"}) do
        local p = name .. ext
        if isfile and isfile(p) then
            if getcustomasset then
                local ok, u = pcall(getcustomasset, p)
                if ok and u then return u end
            end
            if getsynasset then
                local ok, u = pcall(getsynasset, p)
                if ok and u then return u end
            end
        end
    end
    return nil
end

-- ==========================================
-- THEME COLOR TRACKING
-- ==========================================
local _themeTracked = {}

function _captureOrigPalette()
    return {
        ACCENT = C_ACCENT, ACCENT2 = Color3.fromRGB(90, 200, 255),
        BG = C_BG, BG2 = C_PANEL, BG3 = C_ELEM,
        TEXT = C_TEXT, TEXT2 = C_MUTED,
    }
end

function _applyThemeColors(themeName)
    local orig = _captureOrigPalette()
    local t = THEME_COLORS[themeName] or THEME_COLORS["Default"]

    -- Restore previous tracked elements to orig
    for inst, props in pairs(_themeTracked) do
        for prop, origVal in pairs(props) do
            pcall(function() inst[prop] = origVal end)
        end
    end
    _themeTracked = {}

    function track(inst, prop, val)
        if not _themeTracked[inst] then _themeTracked[inst] = {} end
        if _themeTracked[inst][prop] == nil then
            _themeTracked[inst][prop] = inst[prop]
        end
        inst[prop] = val
    end

    for _, d in ipairs(gui:GetDescendants()) do
        if d.Name == "CustomBackground" or d.Name == "BackgroundTint" then
            -- skip: bgImage / bgTint giữ nguyên
        elseif d:IsA("UIStroke") then
            if d.Color == orig.ACCENT then track(d, "Color", t.ACCENT)
            elseif d.Color == orig.ACCENT2 then track(d, "Color", t.ACCENT2) end
        elseif d:IsA("Frame") or d:IsA("TextButton") or d:IsA("ScrollingFrame") then
            if d.BackgroundColor3 == orig.BG then track(d, "BackgroundColor3", t.BG)
            elseif d.BackgroundColor3 == orig.BG2 then track(d, "BackgroundColor3", t.BG2)
            elseif d.BackgroundColor3 == orig.BG3 then track(d, "BackgroundColor3", t.BG3)
            elseif d.BackgroundColor3 == orig.ACCENT then track(d, "BackgroundColor3", t.ACCENT)
            elseif d.BackgroundColor3 == orig.ACCENT2 then track(d, "BackgroundColor3", t.ACCENT2) end
        end
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            if d.TextColor3 == orig.TEXT then track(d, "TextColor3", t.TEXT)
            elseif d.TextColor3 == orig.TEXT2 then track(d, "TextColor3", t.TEXT2)
            elseif d.TextColor3 == orig.ACCENT then track(d, "TextColor3", t.ACCENT)
            elseif d.TextColor3 == orig.ACCENT2 then track(d, "TextColor3", t.ACCENT2) end
            if d.BackgroundColor3 == orig.BG3 then track(d, "BackgroundColor3", t.BG3)
            elseif d.BackgroundColor3 == orig.ACCENT then track(d, "BackgroundColor3", t.ACCENT) end
        end
    end
end

_G.RYZEApplyThemeColors = _applyThemeColors

