-- MODULE 8: PLAYER AURA + GRAB MODES (SAVITAR port)
-- ==========================================
do
    local Debris = game:GetService("Debris")
    local _voidTracked = {}   -- [userId] = tick() lần cuối track
local _killTracked = {}

    function _isWL(p)
        return state.isWL and state.isWL(p) or false
    end

    function _ownerIsMe(part)
        local po = part and part:FindFirstChild("PartOwner")
        return po ~= nil and po.Value == localPlayer.Name
    end

    function _lookAt(pos, target)
        local dir = target - pos
        if dir.Magnitude < 0.001 then return CFrame.new(pos) end
        local unit = dir.Unit
        local right = unit:Cross(Vector3.new(0, 1, 0))
        if right.Magnitude < 0.001 then right = unit:Cross(Vector3.new(0, 0, 1)) end
        return CFrame.fromMatrix(pos, right, right:Cross(unit))
    end

    function _snowship(part)
        if not part or not part.Parent or not part:IsA("BasePart") then return end
        if _ownerIsMe(part) then return end
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if localPlayer:DistanceFromCharacter(part.Position) > 30 then return end
        pcall(function()
            setNetworkOwner:FireServer(part, _lookAt(hrp.Position, part.Position))
        end)
    end

    function _skyVelocity(part)
        if not part or part:FindFirstChild("_RYZESkyVel") then return end
        local bv = Instance.new("BodyVelocity")
        bv.Name = "_RYZESkyVel"
        bv.Velocity = Vector3.new(0, 1e14, 0)
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Parent = part
        Debris:AddItem(bv, 0.25)
    end

    function _release(part)
        if not part then return end
        pcall(function() destroyGrabLine:FireServer(part) end)
    end

    function _grabIsActive(part)
        if not part or not part.Parent then return false end
        local gp = workspace_:FindFirstChild("GrabParts")
        if not gp then return false end
        local grabPart = gp:FindFirstChild("GrabPart")
        if not grabPart then return false end
        local weld = grabPart:FindFirstChild("WeldConstraint")
        return weld ~= nil and weld.Part1 == part
    end

    -- ==========================================
    -- PLAYER AURA
    -- ==========================================
    state.auraRadius = 30
    state.auraModes = {}
    state.auraLoop = false

    function _getAuraTargets()
        local out = {}
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return out end
        local pos = hrp.Position
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= localPlayer and not _isWL(p) and p.Character then
                local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                if tHrp and tHum and tHum.Health > 0
                    and (tHrp.Position - pos).Magnitude <= state.auraRadius then
                    table.insert(out, {player = p, hrp = tHrp, hum = tHum, char = p.Character})
                end
            end
        end
        return out
    end

    function _runAuraMode(mode, t)
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local tHrp = t.hrp

        if mode == "Kill" then
    if not _ownerIsMe(tHrp) then
        _snowship(tHrp)
    else
        local uid = t.player.UserId
        if not _killTracked[uid] or tick() - _killTracked[uid] > 5 then
            _killTracked[uid] = tick()
            state.session.track_kill()
        end
        task.spawn(function()
            pcall(function()
                t.hum.BreakJointsOnDeath = false
                t.hum:ChangeState(Enum.HumanoidStateType.Dead)
            end)
            task.wait(0.05)
            _release(tHrp)
            _skyVelocity(tHrp)
        end)
    end
        elseif mode == "Void" then
    if not _ownerIsMe(tHrp) then
        _snowship(tHrp)
    else
        _release(tHrp)
        _skyVelocity(tHrp)
        local uid = t.player.UserId
        if not _voidTracked[uid] or tick() - _voidTracked[uid] > 5 then
            _voidTracked[uid] = tick()
            state.session.track_void()
        end
    end
        elseif mode == "Fling" then
            if not _ownerIsMe(tHrp) then
                _snowship(tHrp)
            elseif not tHrp:FindFirstChild("_RYZEAuraBV") then
                local bv = Instance.new("BodyVelocity")
                bv.Name = "_RYZEAuraBV"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = Vector3.new(math.random(-150, 150), 500, math.random(-150, 150))
                bv.Parent = tHrp
                Debris:AddItem(bv, 0.4)
            end
        elseif mode == "Grab" then
            _snowship(tHrp)
        elseif mode == "TP to Spawn" then
            if not _ownerIsMe(tHrp) then
                _snowship(tHrp)
            else
                local spawn = workspace_:FindFirstChildOfClass("SpawnLocation")
                if spawn then
                    pcall(function()
                        tHrp.CFrame = spawn.CFrame + Vector3.new(0, 3, 0)
                        tHrp.AssemblyLinearVelocity = Vector3.zero
                        tHrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                    _release(tHrp)
                end
            end
        elseif mode == "Ragdoll" then
            _snowship(tHrp)
            if _ownerIsMe(tHrp) and ragdollRemote then
                pcall(function() ragdollRemote:FireServer(tHrp, 15) end)
            end
        elseif mode == "Struggle" then
            if not _ownerIsMe(tHrp) then
                _snowship(tHrp)
            elseif struggleRemote then
                pcall(function() struggleRemote:FireServer() end)
            end
        elseif mode == "Unstick" then
            local seen = {}
            for _, d in ipairs(t.char:GetDescendants()) do
                if d:IsA("BasePart") then
                    for _, cp in ipairs(d:GetConnectedParts()) do
                        if cp and not cp:IsDescendantOf(t.char) then
                            local sp = cp.Name == "StickyPart" and cp or cp:FindFirstChild("StickyPart", true)
                            if sp and sp:IsA("BasePart") and not seen[sp] then
                                seen[sp] = true
                                pcall(function() setNetworkOwner:FireServer(sp, sp.CFrame) end)
                            end
                        end
                    end
                end
            end
        elseif mode == "Magnet" then
            if not _ownerIsMe(tHrp) then
                _snowship(tHrp)
            else
                local dir = hrp.Position - tHrp.Position
                if dir.Magnitude > 0.001 then
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.Velocity = dir.Unit * 200
                    bv.Parent = tHrp
                    Debris:AddItem(bv, 0.2)
                end
            end
        end
    end

    local _auraHL = {}
    function _updateHL()
        local active = state.auraModes["Highlight"]
        local targets = active and _getAuraTargets() or {}
        local seen = {}
        for _, t in ipairs(targets) do
            seen[t.player] = true
            local hl = _auraHL[t.player]
            if not hl or not hl.Parent then
                hl = Instance.new("Highlight")
                hl.OutlineColor = Color3.new(1, 1, 1)
                hl.FillTransparency = 0.4
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee = t.char
                hl.Parent = t.char
                _auraHL[t.player] = hl
            end
            hl.FillColor = Color3.fromHSV((tick() * 0.2) % 1, 0.9, 1)
        end
        for p, hl in pairs(_auraHL) do
            if not seen[p] then
                pcall(function() hl:Destroy() end)
                _auraHL[p] = nil
            end
        end
    end

