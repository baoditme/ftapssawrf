state.antiLimp = false
state._antiLimpConns = {}
function ToggleAntiLimp(on)
    state.antiLimp = on
    for _, c in ipairs(state._antiLimpConns) do pcall(function() c:Disconnect() end) end
    state._antiLimpConns = {}
    if not on then return end
    local function protectHum(hum)
        if not hum or not state.antiLimp then return end
        pcall(function() hum.BreakJointsOnDeath = false; hum.AutoRotate = true; hum.PlatformStand = false end)
        table.insert(state._antiLimpConns, hum.HealthChanged:Connect(function(health)
            if state.antiLimp and health <= 0 and hum.Parent then pcall(function() hum.Health = 1 end) end
        end))
        table.insert(state._antiLimpConns, hum:GetPropertyChangedSignal("AutoRotate"):Connect(function()
            if state.antiLimp and hum.AutoRotate == false and hum.Parent then pcall(function() hum.AutoRotate = true end) end
        end))
        table.insert(state._antiLimpConns, hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
            if state.antiLimp and hum.PlatformStand == true and hum.Parent then pcall(function() hum.PlatformStand = false end) end
        end))
        table.insert(state._antiLimpConns, runService.RenderStepped:Connect(function()
            if state.antiLimp and hum and hum.Parent then
                if hum.Sit and hum.SeatPart == nil then pcall(function() hum.Sit = false end) end
            end
        end))
    end
    local function hookChar(char)
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
        if hum then protectHum(hum) end
    end
    if localPlayer.Character then hookChar(localPlayer.Character) end
    table.insert(state._antiLimpConns, localPlayer.CharacterAdded:Connect(hookChar))
end

state.antiLimpCreature = false
state._antiLimpCreatureConn = nil
state._antiLimpCreatureCharConn = nil
function ToggleAntiLimpCreature(on)
    state.antiLimpCreature = on
    if state._antiLimpCreatureConn then
        pcall(function() state._antiLimpCreatureConn:Disconnect() end)
        state._antiLimpCreatureConn = nil
    end
    if state._antiLimpCreatureCharConn then
        pcall(function() state._antiLimpCreatureCharConn:Disconnect() end)
        state._antiLimpCreatureCharConn = nil
    end
    if not on then return end
    local function setupChar(char)
        if not char or not state.antiLimpCreature then return end
        local hum = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not (hum and hrp and ragdollRemote) then return end
        if state._antiLimpCreatureConn then
            pcall(function() state._antiLimpCreatureConn:Disconnect() end)
        end
        state._antiLimpCreatureConn = hum:GetPropertyChangedSignal("SeatPart"):Connect(function()
            if not state.antiLimpCreature then return end
            local seat = hum.SeatPart
            if seat and seat.Parent and seat.Parent.Name == "CreatureBlobman" then
