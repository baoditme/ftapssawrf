do
    -- Gravity-shuriken watcher highlight (faithful port of outline watcher)
    local ANTI_KICK_NAMES = { AntiKick = true, NinjaKunai = true, NinjaShuriken = true }
    local outlined = {}
    local function applyWhiteOutline(model)
        if not model or outlined[model] then return end
        if not ANTI_KICK_NAMES[model.Name] then return end
        local hl = model:FindFirstChild("_RYZE_AntiKickOutline")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "_RYZE_AntiKickOutline"
            hl.Adornee = model
            hl.FillColor = Color3.fromRGB(255, 255, 255)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.85
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = model
        end
        outlined[model] = hl
    end
    local function watchFolder(folder)
        if not folder then return end
        for _, ch in ipairs(folder:GetChildren()) do applyWhiteOutline(ch) end
        folder.ChildAdded:Connect(function(ch) task.defer(function() applyWhiteOutline(ch) end) end)
    end
    local function setup()
        local fname = LocalPlayer.Name .. "SpawnedInToys"
        local folder = workspace:FindFirstChild(fname)
        if folder then watchFolder(folder) end
        workspace.ChildAdded:Connect(function(ch)
            if ch.Name == fname then task.defer(function() watchFolder(ch) end) end
        end)
    end
    task.defer(setup)
end

