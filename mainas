        on = true
        task_ = task.spawn(function()
            while on do
                task.wait(0.1)
                local blob = _RYZE_spawnBlobmanIfNeeded()
                if not blob then
                    task.wait(0.5)
                else
                    _RYZE_sitOnBlobman(blob)
                    task.wait(0.2)

