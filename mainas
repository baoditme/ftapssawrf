do
    local propParts, propConns = {}, {}
    local mode, searchMode, animSpeed = "Fly", "My Toys", 1
    local walkPhase, walkDir = 0, 1
    _G.PropsActive = false

    local LIST = {
        { name = "LadderLightBrown", count = 3 },
        { name = "PalletLightBrown", count = 6 },
        { name = "SpotlightRed",     count = 2 },
        { name = "YouDecoy",         count = 1 },
    }
    local OFFS = {
        { x=-0.7,y=8,z=5.1, rx=0,ry=0,rz=0 }, { x=6.5,y=8,z=0.2, rx=-180,ry=89,rz=0 },
        { x=-5.6,y=8,z=-0.7, rx=0,ry=89,rz=-180 }, { x=0.2,y=20,z=0, rx=0,ry=0,rz=0 },
        { x=0.2,y=30.2,z=0, rx=0,ry=0,rz=0 }, { x=0.2,y=24.9,z=-5.1, rx=89,ry=0,rz=0 },
        { x=6,y=24.9,z=0, rx=89,ry=-180,rz=89 }, { x=0.2,y=24.9,z=5.1, rx=89,ry=0,rz=0 },
        { x=-5.1,y=24.9,z=0, rx=89,ry=0,rz=89 }, { x=-2.2,y=26.3,z=-7, rx=0,ry=-87,rz=0 },
        { x=3.6,y=24.9,z=-7.5, rx=-180,ry=89,rz=0 }, { x=0,y=23,z=-3.1, rx=0,ry=0,rz=0 },
    }
    local ENTRIES = {}
    do
        local k = 0
        for _, item in ipairs(LIST) do
            for i = 1, item.count do
                k += 1
                local o = OFFS[k]
                ENTRIES[k] = { name = item.name, localIndex = i, x=o.x, y=o.y, z=o.z, rx=o.rx, ry=o.ry, rz=o.rz }
            end
        end
    end
    local function toCF(e)
        return CFrame.new(e.x, e.y, e.z) * CFrame.Angles(math.rad(e.rx), math.rad(e.ry), math.rad(e.rz))
    end
    local function getPart(n, m)
        if n == "SpotlightRed" then return m:FindFirstChild("LightPart") or m:FindFirstChildWhichIsA("BasePart") end
        if n == "YouDecoy" then return m:FindFirstChild("Torso") or m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart") end
        return m:FindFirstChild("PyramidOctagon") or m:FindFirstChild("SquareTaper")
            or m:FindFirstChild("SoundPart") or m:FindFirstChild("Handle")
            or m:FindFirstChildWhichIsA("BasePart")
    end
    local function stopProps()
        _G.PropsActive = false
        for _, c in ipairs(propConns) do pcall(function() c:Disconnect() end) end
        propConns, propParts = {}, {}
    end
    local function startProps()
        stopProps(); _G.PropsActive = true
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local isRemote = searchMode ~= "My Toys"
        local plotName = searchMode:gsub(" ", "")
        local folder = workspace_:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        if not folder then return end
        for _, c in ipairs(folder:GetChildren()) do
            for _, item in ipairs(LIST) do
                if c.Name == item.name then
                    pcall(function() destroyToyRemote:FireServer(c) end); task.wait(0.05)
                    break
                end
            end
        end
        task.wait(0.3)
        local spawnCF = hrp.CFrame * CFrame.new(0, 0, -3)
        for _, item in ipairs(LIST) do
            for _ = 1, item.count do
                pcall(function() spawnToyRemote:InvokeServer(item.name, spawnCF, Vector3.zero) end)
                task.wait(0.15)
            end
        end
        task.wait(0.4)
        if isRemote then
            local pi = workspace_:FindFirstChild("PlotItems")
            folder = pi and pi:FindFirstChild(plotName)
            if not folder then task.wait(1); folder = pi and pi:FindFirstChild(plotName) end
        end
        if not folder then return end

        local startT = tick()
        local found = {}
        for i = 1, #ENTRIES do
            for _, c in ipairs(folder:GetChildren()) do
                if c.Name == ENTRIES[i].name then
                    local used = false
                    for _, u in ipairs(found) do
                        if u.model == c then used = true; break end
                    end
                    if not used then
                        local mp = getPart(ENTRIES[i].name, c)
                        if mp then found[i] = { part = mp, model = c }; break end
                    end
                end
            end
        end
        for i = 1, #ENTRIES do
            local f = found[i]
            if f then
                pcall(function()
                    for _, d in ipairs(f.model:GetDescendants()) do
                        if d:IsA("BasePart") then d.CanCollide = false; d.CanTouch = false end
                    end
                end)
                local cf = hrp.CFrame * toCF(ENTRIES[i])
                pcall(function()
                    setNetworkOwner:FireServer(f.part, f.part.CFrame); task.wait(0.05)
                    f.part.CFrame = cf
                    f.part.AssemblyLinearVelocity = Vector3.zero
                    f.part.AssemblyAngularVelocity = Vector3.zero
                    setNetworkOwner:FireServer(f.part, cf)
                end)
                local bp = Instance.new("BodyPosition")
                bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bp.P, bp.D = 50000, 1000
                bp.Position = cf.Position; bp.Parent = f.part
                local bg = Instance.new("BodyGyro")
                bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bg.P, bg.D = 50000, 1000
                bg.CFrame = cf; bg.Parent = f.part
                table.insert(propParts, { part = f.part, model = f.model, gi = i, bp = bp, bg = bg })
            end
        end
        table.insert(propConns, runService.Heartbeat:Connect(function(dt)
            if not _G.PropsActive then return end
            local h = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not h then return end
            local canClaim = not isRemote or (tick() - startT) < 5
            if mode == "Walk" then
                local vel = h.CFrame:VectorToObjectSpace(h.AssemblyLinearVelocity)
                if math.abs(vel.X) > 1 or math.abs(vel.Z) > 1 then
                    walkPhase += walkDir * animSpeed * dt
                    if walkPhase >= 1 then walkPhase = 1; walkDir = -1
                    elseif walkPhase <= 0 then walkPhase = 0; walkDir = 1 end
                else
                    walkPhase = 0; walkDir = 1
                end
            end
            for _, p in ipairs(propParts) do
                if p.part and p.part.Parent then
                    local cf = h.CFrame * toCF(ENTRIES[p.gi])
                    if canClaim then pcall(function() setNetworkOwner:FireServer(p.part, cf) end) end
                    p.bp.Position = cf.Position
                    p.bg.CFrame = cf
                end
            end
        end))
        pcall(Notify, "Props", "ON", "success", 2)
    end

    makeSection(funTab, "Prop Controller")
    makeDropdown(funTab, "Props Search Mode", {"My Toys","Plot1","Plot2","Plot3","Plot4","Plot5"}, "My Toys", function(v) searchMode = v end)
    makeDropdown(funTab, "Props Mode", {"Fly","Walk"}, "Fly", function(v) mode = v end)
    makeSlider(funTab, "Props Walk Speed", 1, 0.1, 5, function(v) animSpeed = v end)
    makeToggle(funTab, "Props ON/OFF", false, function(on)
        if on then startProps() else stopProps() end
    end)
    makeButton(funTab, "Refresh Props", function()
        if _G.PropsActive then startProps() end
    end)
    gui.Destroying:Connect(function() pcall(stopProps) end)
end

-- 4) Physical Wings
do
    local wings = {}
    local wingItem, searchMode = "TetracubeI", "My Toys"
    local wingSpeed, wingAngle, wingLength = 2, 30, 5
    local wingTime, active = 0, false
    local WING_OFF = { CFrame.new(-4.125, 0, 1), CFrame.new(4.125, 0, 1) }

    local function getFolders()
        local out = {}
        if searchMode == "My Toys" or searchMode == "All Toys" then
            local f = workspace_:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
            if f then table.insert(out, f) end
        end
        if searchMode == "Plot Toys" or searchMode == "All Toys" then
            local plots = workspace_:FindFirstChild("Plots")
            if plots then
                for i = 1, 5 do
                    local plot = plots:FindFirstChild("Plot" .. i)
                    if plot then
                        local sign = plot:FindFirstChild("PlotSign")
                        local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
                        if owners then
                            for _, v in ipairs(owners:GetChildren()) do
                                if v:IsA("ValueBase") and v.Value == localPlayer.Name then
                                    local pi = workspace_:FindFirstChild("PlotItems")
                                    local f = pi and pi:FindFirstChild(plot.Name)
                                    if f then table.insert(out, f) end
                                end
                            end
                        end
                    end
                end
            end
        end
        return out
    end
    local function setupPhysics(parent)
        local bp = parent:FindFirstChildOfClass("BodyPosition") or Instance.new("BodyPosition")
        local bg = parent:FindFirstChildOfClass("BodyGyro") or Instance.new("BodyGyro")
        bp.P = 15000; bp.D = 200; bp.MaxForce = Vector3.one * 1e10; bp.Parent = parent
        bg.P = 15000; bg.D = 200; bg.MaxTorque = Vector3.one * 1e10; bg.Parent = parent
        return bg, bp
    end
    local function cleanup()
        for _, w in ipairs(wings) do
            if w.Handle then pcall(function() w.Handle:Destroy() end) end
            for _, s in ipairs(w.Segments) do
                if s.Part then pcall(function() s.Part:Destroy() end) end
            end
        end
        wings = {}
    end
    local function build()
        cleanup()
        local models = {}
        for _, f in ipairs(getFolders()) do
            for _, d in ipairs(f:GetDescendants()) do
                if d:IsA("Model") and d.Name == wingItem then
                    table.insert(models, d)
                end
            end
        end
        if #models == 0 then return false end
        for i = 1, 2 do
            local segs = {}
            for _ = 1, wingLength do
                local p = Instance.new("Part")
                p.CanCollide = false; p.Anchored = true; p.Transparency = 1
                p.Size = Vector3.new(4, 1, 4); p.Parent = workspace_
                segs[#segs+1] = { Part = p }
            end
            local h = Instance.new("Part")
            h.CanCollide = false; h.Anchored = true; h.Transparency = 1
            h.Size = Vector3.new(4, 1, 4); h.Parent = workspace_
            table.insert(wings, { Handle = h, Segments = segs, Sync = {}, Reserved = nil })
        end
        for i, m in ipairs(models) do
            local side = i <= #models/2 and 1 or 2
            local sp = m:FindFirstChild("SoundPart") or m:FindFirstChild("Handle") or m:FindFirstChildWhichIsA("BasePart")
            if sp then
                for _, c in ipairs(m:GetChildren()) do
                    if c:IsA("BasePart") then c.CanCollide = false end
                end
                local bg, bp = setupPhysics(sp)
                if not wings[side].Reserved then wings[side].Reserved = { BG = bg, BP = bp }
                else table.insert(wings[side].Sync, { BG = bg, BP = bp }) end
            end
        end
        return true
    end

    runService.RenderStepped:Connect(function(dt)
        if not active or #wings == 0 then return end
        local char = localPlayer.Character
        local torso = char and (char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not torso or not hrp then return end
        wingTime += dt * (wingSpeed + hrp.Velocity.Magnitude / 40)
        for i, w in ipairs(wings) do
            local dir = i == 1 and 1 or -1
            w.Handle.CFrame = torso.CFrame * WING_OFF[i] * CFrame.Angles(0, 0,
                math.sin(wingTime) * math.rad(wingAngle + hrp.Velocity.Magnitude / 4) * dir)
            if w.Reserved then
                w.Reserved.BP.Position = w.Handle.Position
                w.Reserved.BG.CFrame = w.Handle.CFrame * CFrame.Angles(math.pi/2, 0, math.pi/2)
            end
            for j, s in ipairs(w.Segments) do
                s.Part.CFrame = s.Part.CFrame:Lerp(
                    (j == 1 and w.Handle.CFrame or w.Segments[j-1].Part.CFrame) * WING_OFF[i], 0.5)
                if w.Sync[j] then
                    w.Sync[j].BP.Position = s.Part.Position
                    w.Sync[j].BG.CFrame = s.Part.CFrame * CFrame.Angles(math.pi/2, 0, math.pi/2)
                end
            end
        end
    end)

    makeSection(funTab, "Physical Wings")
    makeDropdown(funTab, "Wing Item", {"TetracubeI","FireworkSparkler","PoopPile"}, "TetracubeI", function(v)
        wingItem = v; if active then build() end
    end)
    makeDropdown(funTab, "Wing Search Range", {"My Toys","Plot Toys","All Toys"}, "My Toys", function(v)
        searchMode = v; if active then build() end
    end)
    makeToggle(funTab, "Enable Wings", false, function(on)
        if on then
            if build() then
                active = true
            else
                pcall(Notify, "Wings", "No matching toy found", "warning", 3)
                active = false
            end
        else
            active = false
            cleanup()
        end
    end)
    makeSlider(funTab, "Wing Speed", 2, 1, 10, function(v) wingSpeed = v end)
    makeSlider(funTab, "Wing Angle", 30, 10, 90, function(v) wingAngle = v end)
    makeSlider(funTab, "Wing Length", 5, 1, 10, function(v) wingLength = v; if active then build() end end)
    gui.Destroying:Connect(function()
        active = false
        pcall(cleanup)
    end)
end

