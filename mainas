-- MODULE 17: EXTRA TARGET METHODS
-- ==========================================
do
    state.extraMethods = {}
    state.extraLoopSel = false
    state.extraLoopServer = false

    function kickMethod(p)
        local ch = p.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end
        local origCF = hrp.CFrame
        task.spawn(function()
            local endT = tick() + 1.2
            while tick() < endT and hrp.Parent and hum.Health > 0 do
                pcall(function() setNetworkOwner:FireServer(hrp, hrp.CFrame) end)
                pcall(function() destroyGrabLine:FireServer(hrp) end)
                task.wait(0.05)
            end
            -- drag them off
            for i = 1, 8 do
                if not hrp.Parent then break end
                pcall(function()
                    hrp.CFrame = origCF + Vector3.new(0, -50 * i, 0)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, -50000, 0)
                end)
                task.wait(0.05)
            end
        end)
    end

    function removeGucci(p)
        local ch = p.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local seat = hum.SeatPart
        if not seat then return end
        local vehicle = seat.Parent
        if not vehicle then return end
        local script = vehicle:FindFirstChild("BlobmanSeatAndOwnerScript")
        if script then
            local cr = script:FindFirstChild("CreatureDrop") or script:FindFirstChild("CreatureRelease")
            local detector = vehicle:FindFirstChild("LeftDetector") or vehicle:FindFirstChild("RightDetector")
            local weld = detector and (detector:FindFirstChild("LeftWeld") or detector:FindFirstChild("RightWeld"))
            if cr and weld then
                pcall(function()
                    cr:FireServer(weld, ch:FindFirstChild("HumanoidRootPart"))
                end)
            end
        end
        pcall(function() hum.Sit = false end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end

    function removeHoldable(p)
        local folder = workspace_:FindFirstChild(p.Name .. "SpawnedInToys")
        local ch = p.Character
        if not folder or not ch then return end
        for _, toy in ipairs(folder:GetChildren()) do
            local hp = toy:FindFirstChild("HoldPart")
            if hp then
                local holdOwner = hp:FindFirstChild("HoldingPlayer")
                if holdOwner and holdOwner.Value == p then
                    local drop = hp:FindFirstChild("DropItemRemoteFunction")
                    if drop then pcall(function() drop:InvokeServer(toy) end) end
                end
            end
        end
    end

    function removeInvisibility(p)
        local ch = p.Character
        if not ch then return end
        local pcld = ch:FindFirstChild("PCLD") or ch:FindFirstChild("PCID")
        if pcld then pcall(function() pcld:Destroy() end) end
        local tp = ch:FindFirstChild("TruePositionPart")
        if tp then pcall(function() tp:Destroy() end) end
        local folder = workspace_:FindFirstChild(p.Name .. "SpawnedInToys")
        if folder then
            for _, toy in ipairs(folder:GetChildren()) do
                local sp = toy:FindFirstChild("StickyPart", true)
                if sp then
                    local po = sp:FindFirstChild("PartOwner")
                    if po and po.Value == p.Name then
                        pcall(function() setNetworkOwner:FireServer(sp, sp.CFrame) end)
                        pcall(function() destroyGrabLine:FireServer(sp) end)
                    end
                end
            end
        end
        for _, d in ipairs(ch:GetDescendants()) do
            if d:IsA("BasePart") and d.LocalTransparencyModifier > 0 then
                d.LocalTransparencyModifier = 0
            end
        end
    end

    function applyExtra(p, m)
        if not p or not p.Character or (state.isWL and state.isWL(p)) then return end
        if m.Kick then task.spawn(kickMethod, p) end
        if m["Remove Gucci"] then task.spawn(removeGucci, p) end
        if m["Remove Holdable"] then task.spawn(removeHoldable, p) end
        if m["Remove Invisibility"] then task.spawn(removeInvisibility, p) end
    end

    task.spawn(function()
        while gui.Parent do
            task.wait(0.1)
            if state.extraLoopSel and state.targetName then
                local p = players:FindFirstChild(state.targetName)
                if p then applyExtra(p, state.extraMethods) end
            end
            if state.extraLoopServer then
                for _, p in ipairs(players:GetPlayers()) do
                    if p ~= localPlayer then applyExtra(p, state.extraMethods) end
                end
            end
        end
    end)

    makeSection(targetTab, "Extra Target Methods (SAVITAR)")
    for _, m in ipairs({"Kick", "Remove Gucci", "Remove Holdable", "Remove Invisibility"}) do
        makeToggle(targetTab, m, false, function(on) state.extraMethods[m] = on or nil end)
    end
    makeButton(targetTab, "Apply Extra (Selected Target)", function()
        if state.targetName and players:FindFirstChild(state.targetName) then
            applyExtra(players[state.targetName], state.extraMethods)
        end
    end)
    makeButton(targetTab, "Apply Extra (Server)", function()
        for _, p in ipairs(players:GetPlayers()) do
            if p ~= localPlayer then applyExtra(p, state.extraMethods) end
        end
    end)
    makeToggle(targetTab, "Loop Extra (Selected)", false, function(on) state.extraLoopSel = on end)
    makeToggle(targetTab, "Loop Extra (Server)", false, function(on) state.extraLoopServer = on end)
end



