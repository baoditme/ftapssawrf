        pcall(function()
            tHrp.CFrame = bringPos
            tHrp.AssemblyLinearVelocity = Vector3.zero
            tHrp.AssemblyAngularVelocity = Vector3.zero
        end)

        if bringHold > 0 then
            local bp = Instance.new("BodyPosition")
            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bp.P = 50000
            bp.D = 1000
            bp.Position = bringPos.Position
            bp.Parent = tHrp
            local startT = tick()
            while tick() - startT < bringHold and on and bp.Parent and tHrp.Parent and myHrp.Parent do
                task.wait(0.1)
                bp.Position = myHrp.Position + (myHrp.CFrame.LookVector * 5) + Vector3.new(0, 3, 0)
            end
            if bp.Parent then bp:Destroy() end
        end
    end

