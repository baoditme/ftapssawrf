-- [BLOB HELPER] auto spawn + sit, fallback to find existing
local function ensureBlobmanSit(timeout)
    timeout = timeout or 5
    local function getHum()
        local c = LocalPlayer.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end
    local hum = getHum()
    if not hum or hum.Health <= 0 then return nil end
    if hum.SeatPart and hum.SeatPart.Parent and hum.SeatPart.Parent.Name == "CreatureBlobman" then
        return hum.SeatPart.Parent
    end
    local function trySit(blob)
        if not blob or not blob.Parent then return nil end
        local seat = blob:FindFirstChildWhichIsA("VehicleSeat", true)
        if not seat then return nil end
        local h = getHum()
        if not h then return nil end
        pcall(function() seat:Sit(h) end)
        local st = tick()
        while tick() - st < 1.5 do
            h = getHum()
            if not h then return nil end
            if h.SeatPart == seat then return blob end
            task.wait(0.05)
        end
        return blob
    end
    -- existing blob in inventory
    local inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    local blob = inv and inv:FindFirstChild("CreatureBlobman")
    if blob then
        local ok = trySit(blob)
        if ok then return ok end
    end
    -- try spawn
    local canSpawn = LocalPlayer:FindFirstChild("CanSpawnToy")
    if canSpawn and not canSpawn.Value then
        local sw = tick()
        while not canSpawn.Value and tick() - sw < 2 do task.wait(0.05) end
    end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if spawnToyRemote and hrp then
        pcall(function()
            spawnToyRemote:InvokeServer("CreatureBlobman", hrp.CFrame * CFrame.new(0, 0, -5), Vector3.new(0, -15, 0))
        end)
    end
    local t0 = tick()
    while tick() - t0 < timeout do
        inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        blob = inv and inv:FindFirstChild("CreatureBlobman")
        if blob then
            local ok = trySit(blob)
            if ok then return ok end
        end
        task.wait(0.1)
    end
    -- fallback: find existing blobman in workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "CreatureBlobman" then
            local seat = obj:FindFirstChildWhichIsA("VehicleSeat", true)
            if seat and not seat.Occupant then
                local ok = trySit(obj)
                if ok then return ok end
            end
        end
    end
    return nil
end

