function GetPlot()
    if not workspace_.PlotItems.PlayersInPlots:FindFirstChild(localPlayer.Name) then return false end
    for _, plot in workspace_.Plots:GetChildren() do
                local plotSign = plot:FindFirstChild("PlotSign")
        local thisPlotsOwners = plotSign and plotSign:FindFirstChild("ThisPlotsOwners")
        if thisPlotsOwners then
            for _, v in thisPlotsOwners:GetChildren() do
                if v.Value ~= localPlayer.Name then continue end
                local plotItems = workspace_.PlotItems:FindFirstChild(plot.Name)
                if plotItems then return true, plotItems end
            end
        end
    end
    return false
end

function NewToy(name, cf)
    if not name or not cf then return nil end
    if not waitSpawnable(5) then return nil end
    local startTick = tick()
    local spawned = nil
    task.spawn(function()
        while true do
            task.spawn(function() spawnToyRemote:InvokeServer(name, cf, Vector3.zero) end)
            task.wait(0.1)
            if spawned or tick() - startTick > 1.5 then break end
        end
    end)
    local ok, plotInv = GetPlot()
    if ok and plotInv then
        spawned = plotInv:WaitForChild(name, 1.5)
        return spawned
    end
    spawned = toysFolder:WaitForChild(name, 1.5)
    return spawned
end

function DestroyT(toy)
    if toy then pcall(function() destroyToyRemote:FireServer(toy) end) end
end

function Ownerboat(part)
    if not part then return nil end
    setNetworkOwner:FireServer(part, part.CFrame)
    local po = part:FindFirstChild("PartOwner")
    if po and po.Value == localPlayer.Name then return po end
    return nil
end

function UnGrab(part)
    if part then pcall(function() destroyGrabLine:FireServer(part) end) end
end

function Teleport(part, target, offset)
    if part and target and offset then
        part.CFrame = target * offset
        part.Velocity = Vector3.zero
        part.RotVelocity = Vector3.zero
    end
end

function GetHRH(char)
    if char then
        return char:FindFirstChild("Head"), char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Humanoid")
    end
end

function SpawnShuriken(name)
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    -- ✅ FIX: Check remote tồn tại
    if not spawnToyRemote or not setNetworkOwner or not toysFolder then
        return nil
    end

    -- ✅ FIX: Safe check CanSpawnToy / InPlot (nil trên non-FTAP)
    local canSpawn = localPlayer:FindFirstChild("CanSpawnToy")
    if not canSpawn then return nil end

    local inPlot = localPlayer:FindFirstChild("InPlot")
    while not (canSpawn.Value and not (inPlot and inPlot.Value)) do
        task.wait()
    end

    spawnToyRemote:InvokeServer("NinjaShuriken", hrp.CFrame * CFrame.new(0, 15, 20), Vector3.zero)
    local toy = toysFolder:WaitForChild("NinjaShuriken", 2)
    if not toy then return nil end
    local soundPart = toy:WaitForChild("SoundPart", 1)
    if not soundPart then DestroyT(toy) return nil end
    local startTick = tick()
    while true do
        runService.RenderStepped:Wait()
        setNetworkOwner:FireServer(soundPart, soundPart.CFrame)
        local po = soundPart:FindFirstChild("PartOwner")
        if po and po.Value == localPlayer.Name then break end
        if tick() - startTick > 1.5 then break end
    end
    local po = soundPart:FindFirstChild("PartOwner")
    if not (po and po.Value == localPlayer.Name) then DestroyT(toy) return nil end
    if not soundPart:FindFirstChild("BodyPosition") then
        local bp = Instance.new("BodyPosition")
        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bp.D = 100
        bp.Position = Vector3.new(math.random(-100000, 100000), 100000, math.random(-100000, 100000))
        bp.Parent = soundPart
    end
    toy.Name = name
    return toy
end

