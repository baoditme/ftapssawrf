local function _A_getAllPalletFolders()
    local folders = {}
    local findFirstChild = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if findFirstChild then table.insert(folders, findFirstChild) end
    local plotItems = workspace:FindFirstChild("PlotItems")
    if plotItems then
        local plots = workspace:FindFirstChild("Plots")
        if plots then
            for i = 1, 5 do
                local plot = plots:FindFirstChild("Plot" .. i)
                if plot then
                    local plotSign = plot:FindFirstChild("PlotSign")
                    local owners = plotSign and plotSign:FindFirstChild("ThisPlotsOwners")
