-- ==========================================
-- ANTI GET KICKED (Defense Tab)
-- Phát hiện bị kick → lưu vị trí → loop TP về + freeze
-- ==========================================
do
    local LP, RUN, Plrs, WS = localPlayer, runService, players, workspace_

    local R6 = {"HumanoidRootPart","Torso","Head","Left Arm","Right Arm","Left Leg","Right Leg"}
    local HISTORY_WINDOW = 1.5    -- giây lưu lịch sử vị trí
    local MAX_XZ   = 5000         -- X/Z vượt mức này = bị đẩy
    local MAX_Y    = 60000        -- Y cao vượt mức này (platform 50000 vẫn an toàn)
    local MIN_Y    = -250
    local MAX_VEL  = 6000         -- vận tốc vượt mức này = fling
    local MAX_FREEZE = 2.5        -- thời gian giữ tối đa mỗi lần kích hoạt
    local COOLDOWN = 1.0

    local agk = {
        enabled = false,
        strict = false,
        frozen = false,
        history = {},
        conns = {},
        lastNotify = 0,
        cooldownUntil = 0,
    }

    local function getHRP()
        local c = LP.Character
        return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid"), c
    end

    -- Trả về tên người đang giữ ownership nhân vật mình (bỏ qua whitelist)
    local function getForeignOwner(char)
        if not char then return nil end
        for _, name in ipairs(R6) do
            local part = char:FindFirstChild(name)
            local po = part and part:FindFirstChild("PartOwner")
            if po and po.Value ~= "" and po.Value ~= LP.Name then
                local p = Plrs:FindFirstChild(po.Value)
                if not (p and state.isWL and state.isWL(p)) then
                    return po.Value
                end
            end
        end
        return nil
    end

    local function isBadPos(hrp)
        local pos = hrp.Position
        if pos ~= pos then return true, "NaN" end
        if math.abs(pos.X) > MAX_XZ or math.abs(pos.Z) > MAX_XZ then
            return true, "Bi day xa (X/Z)"
        end
        if pos.Y > MAX_Y then return true, "Bi day len cao" end
        if pos.Y < MIN_Y and hrp.AssemblyLinearVelocity.Y < -50 then
            return true, "Roi bat thuong"
        end
        if hrp.AssemblyLinearVelocity.Magnitude > MAX_VEL then
            return true, "Fling"
        end
        return false
    end

    local function pushHistory(hrp)
        local now = tick()
        table.insert(agk.history, {t = now, cf = hrp.CFrame})
        while #agk.history > 0 and now - agk.history[1].t > HISTORY_WINDOW do
            table.remove(agk.history, 1)
        end
    end

    local function getSafeCF()
        local first = agk.history[1]
        return first and first.cf or nil
    end

    local function release(hrp)
        if hrp and hrp.Parent then
            hrp.Anchored = false
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end

    local function trigger(reason, kickerName)
        if not agk.enabled or agk.frozen or tick() < agk.cooldownUntil then return end
        local hrp, hum = getHRP()
        if not (hrp and hum and hum.Health > 0) then return end
        local safe = getSafeCF()
        if not safe then return end

        agk.frozen = true

        if tick() - agk.lastNotify > 3 then
            agk.lastNotify = tick()
            local who = "Khong ro"
            local p = kickerName and Plrs:FindFirstChild(kickerName)
            if p then who = p.DisplayName .. " (@" .. p.Name .. ")" end
            pcall(Notify, "Anti Get Kicked", reason .. " | Kicker: " .. who, "kick", 5)
        end

        task.spawn(function()
            local t0 = tick()
            local calmSince = nil
            while agk.enabled and tick() - t0 < MAX_FREEZE do
                local h, hu, ch = getHRP()
                if not (h and hu and hu.Health > 0) then break end

                h.Anchored = true
                h.CFrame = safe
                h.AssemblyLinearVelocity = Vector3.zero
                h.AssemblyAngularVelocity = Vector3.zero

                pcall(function() setNetworkOwner:FireServer(h, safe) end)
                if struggleRemote then pcall(function() struggleRemote:FireServer(LP) end) end
                if ragdollRemote then pcall(function() ragdollRemote:FireServer(h, 0) end) end

                -- Het nguy hiem: khong con ai chiem quyen + dung vi tri an toan
                local foreign = getForeignOwner(ch)
                local near = (h.Position - safe.Position).Magnitude < 6
                if not foreign and near then
                    calmSince = calmSince or tick()
                    if tick() - calmSince > 0.4 then break end
                else
                    calmSince = nil
                end
                RUN.Heartbeat:Wait()
            end

            local h = getHRP()
            release(h)
            table.clear(agk.history)
            agk.cooldownUntil = tick() + COOLDOWN
            agk.frozen = false
        end)
    end

    local function onHeartbeat()
        if not agk.enabled or agk.frozen then return end
        local hrp, hum, char = getHRP()
        if not (hrp and hum and hum.Health > 0) then return end

        local foreign = getForeignOwner(char)
        local bad, reason = isBadPos(hrp)

        if bad then
            -- tim kicker: uu tien PartOwner, khong co thi tim nguoi gan nhat vi tri cu
            if not foreign then
                local safe = getSafeCF()
                local bestD = 25
                if safe then
                    for _, p in ipairs(Plrs:GetPlayers()) do
                        if p ~= LP and p.Character then
                            local th = p.Character:FindFirstChild("HumanoidRootPart")
                            if th then
                                local d = (th.Position - safe.Position).Magnitude
                                if d < bestD then bestD = d foreign = p.Name end
                            end
                        end
                    end
                end
            end
            trigger(reason, foreign)
            return
        end

        if agk.strict and foreign then
            trigger("Co nguoi chiem quyen nhan vat", foreign)
            return
        end

        -- chi luu lich su khi an toan va khong bi ai chiem quyen
        if not foreign then pushHistory(hrp) end
    end

    local function enable()
        if agk.enabled then return end
        agk.enabled = true
        agk.frozen = false
        table.clear(agk.history)
        agk.conns.hb = RUN.Heartbeat:Connect(onHeartbeat)
        agk.conns.char = LP.CharacterAdded:Connect(function()
            table.clear(agk.history)
            agk.frozen = false
        end)
    end

    local function disable()
        agk.enabled = false
        agk.frozen = false
        for _, c in pairs(agk.conns) do
            if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
        end
        table.clear(agk.conns)
        table.clear(agk.history)
        release((getHRP()))
    end

    makeToggle(defenseTab, "Anti Get Kicked", false, function(on)
        if on then enable() else disable() end
    end)
    makeToggle(defenseTab, "Anti Get Kicked: Strict", false, function(on)
        agk.strict = on
    end)

    gui.Destroying:Connect(disable)
end

-- ==========================================
-- [EKONANS] OWNERSHIP KICK (Adaptive FPS)
-- ==========================================
do
    local LP = localPlayer
    local RS = replicatedStorage
    local RUN = runService
    local Plrs = players

    local ownershipKickActive = false
    local ownershipKickTask = nil

    function OwnershipKickFunction(targetName)
        local target = Plrs:FindFirstChild(targetName)
        if not target then
            Notify("Ownership Kick", "Target không tồn tại", "warning", 2)
            return
        end

        local GE = RS:WaitForChild("GrabEvents")

        local myChar = LP.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local savedPos = myRoot.CFrame
        local dragging = false
        local grabStartTime = 0
        local checkStartTime = 0

        -- Đo FPS realtime để chọn số fire
        local currentFPS = 60
        local fpsConnection = RUN.RenderStepped:Connect(function(dt)
            if dt > 0 then currentFPS = 1 / dt end
        end)

        local bodyPos = nil
        local bodyGyro = nil

        local function cleanupBodies()
            pcall(function()
                if bodyPos then bodyPos:Destroy() bodyPos = nil end
                if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
            end)
        end

        local function createBodies(targetRoot, pos)
            cleanupBodies()
            for _, v in pairs(targetRoot:GetChildren()) do
                if v:IsA("BodyPosition") or v:IsA("BodyGyro") then v:Destroy() end
            end
            bodyPos = Instance.new("BodyPosition")
            bodyPos.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bodyPos.D = 100
            bodyPos.Position = pos
            bodyPos.Parent = targetRoot
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyGyro.D = 100
            bodyGyro.CFrame = CFrame.new(pos)
            bodyGyro.Parent = targetRoot
        end

        while ownershipKickActive do
            local currentTarget = Plrs:FindFirstChild(target.Name)
            if not currentTarget or not currentTarget.Parent then
                cleanupBodies()
                break
            end

            myChar = LP.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local tChar = currentTarget.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChild("Humanoid")

            if tRoot and tHum and tHum.Health > 0 and myRoot then
                if not dragging then
                    -- Phase 1: áp sát mục tiêu, chiếm network owner
                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                    cleanupBodies()
                    checkStartTime = 0

                    pcall(function()
                        tHum.PlatformStand = true
                        tHum.Sit = true
                        GE.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                        GE.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                        GE.DestroyGrabLine:FireServer(tRoot)
                    end)

                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero

                    if grabStartTime == 0 then grabStartTime = tick() end
                    if tick() - grabStartTime > 0.35 then
                        dragging = true
                        grabStartTime = 0
                        checkStartTime = tick()
                        local lockPos = savedPos * CFrame.new(0, 17, 0)
                        createBodies(tRoot, lockPos.Position)
                    end
                else
                    -- Phase 2: lock mục tiêu trên đầu, spam fire theo FPS
                    myRoot.CFrame = savedPos
                    local lockPos = savedPos * CFrame.new(0, 17, 0)

                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero

                    if bodyPos and bodyPos.Parent then
                        bodyPos.Position = lockPos.Position
                        if bodyGyro then bodyGyro.CFrame = lockPos end
                    else
                        createBodies(tRoot, lockPos.Position)
                    end

                    tHum.PlatformStand = true

                    -- 🔥 ADAPTIVE FPS: fire nhiều lần hơn nếu FPS thấp
                    pcall(function()
                        if currentFPS > 200 then
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            GE.DestroyGrabLine:FireServer(tRoot)
                        elseif currentFPS >= 155 and currentFPS <= 200 then
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            GE.DestroyGrabLine:FireServer(tRoot)
                        else
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            GE.SetNetworkOwner:FireServer(tRoot, lockPos)
                            GE.DestroyGrabLine:FireServer(tRoot)
                        end
                    end)

                    -- Check nếu mục tiêu bay xa khỏi lockPos → reset phase
                    if checkStartTime > 0 and tick() - checkStartTime > 0.30 then
                        local currentDist = (tRoot.Position - lockPos.Position).Magnitude
                        if currentDist > 10 then
                            dragging = false
                            grabStartTime = 0
                            checkStartTime = 0
                            cleanupBodies()
                            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        else
                            checkStartTime = tick()
                        end
                    end
                end
            else
                dragging = false
                grabStartTime = 0
                checkStartTime = 0
                cleanupBodies()
            end
            RUN.Heartbeat:Wait()
        end

        fpsConnection:Disconnect()
        cleanupBodies()
        if myRoot then myRoot.CFrame = savedPos end
    end

    makeSection(targetTab, "═══ OWNERSHIP KICK ═══")
    makeToggle(targetTab, "Ownership Kick (Adaptive FPS)", false, function(Value)
        ownershipKickActive = Value
        if Value then
            local targetName = state.targetName
            if not targetName or targetName == "" then
                Notify("Ownership Kick", "Chọn Target trước (dropdown bên trên)", "warning", 2)
                ownershipKickActive = false
                return
            end
            ownershipKickTask = task.spawn(function()
                OwnershipKickFunction(targetName)
            end)
        else
            if ownershipKickTask then
                task.cancel(ownershipKickTask)
                ownershipKickTask = nil
            end
            -- Dọn BodyPosition/BodyGyro trên mục tiêu cũ
            local targetName = state.targetName
            local target = targetName and Plrs:FindFirstChild(targetName)
            if target and target.Character then
                local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
                if tRoot then
                    for _, v in pairs(tRoot:GetChildren()) do
                        if v:IsA("BodyPosition") or v:IsA("BodyGyro") then
                            pcall(function() v:Destroy() end)
                        end
                    end
                    pcall(function()
                        tRoot.AssemblyLinearVelocity = Vector3.zero
                        tRoot.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            end
        end
    end)

    
end

