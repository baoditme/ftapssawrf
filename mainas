                if dist > 30 then
                    pcall(function() myChar:PivotTo(tHrp.CFrame * CFrame.new(0, 2, 4)) end)
                    pcall(function() setNetworkOwner:FireServer(tHrp, tHrp.CFrame) end)
                    task.wait(0.05)
                end

