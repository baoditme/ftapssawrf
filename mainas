        local weld = det:WaitForChild("LeftWeld")
        local grab = blob.BlobmanSeatAndOwnerScript:WaitForChild("CreatureGrab")
        local drop = blob.BlobmanSeatAndOwnerScript:WaitForChild("CreatureDrop")
        local orig = hrp.CFrame
        hrp.CFrame = tHRP.CFrame * CFrame.new(0, 0, 3)
