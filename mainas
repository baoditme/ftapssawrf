            if FG.conn then FG.conn:Disconnect() FG.conn = nil end
            resetTarget()
            Notify("Figure Grab", "Released target", "info", 2)
            return
        end

        local target = playerUnderMouse()
        if not target then
            Notify("Figure Grab", "Aim at a player first", "warning", 2)
            return
        end
        if not target.Character or not target.Character:FindFirstChild("Torso") then
            Notify("Figure Grab", "Invalid target (need R6/Torso)", "warning", 2)
            return
        end

        resetTarget()
        FG.targetChar = target.Character
        FG.enabled = true

        for _, name in ipairs({"Head","Torso","HumanoidRootPart","Left Arm","Right Arm","Left Leg","Right Leg"}) do
            local part = FG.targetChar:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                part.CanCollide = false
                part.Massless = true
            end
        end

        FG.conn = runService.Heartbeat:Connect(function()
            if not FG.enabled then return end
            if not FG.targetChar or not FG.targetChar.Parent then
                FG.enabled = false
                if FG.conn then FG.conn:Disconnect() FG.conn = nil end
                resetTarget()
                Notify("Figure Grab", "Target lost", "warning", 2)
                return
            end
            applyPose()
        end)

        Notify("Figure Grab", "Grabbed " .. target.DisplayName, "success", 2)
    end

    local function applyPreset(name)
        local preset = PRESETS[name]
        if not preset then return end
        FG.preset = name
        for k, v in pairs(preset) do
            FG.pose[k] = {X=v.X, Y=v.Y, Z=v.Z}
        end
        if FG.enabled then
            Notify("Figure Grab", "Preset: " .. name, "info", 1.5)
        end
    end

    local function updatePose(key, axis, value)
        if FG.pose[key] then FG.pose[key][axis] = value end
    end

