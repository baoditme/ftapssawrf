                                if ok3 and content then Fun.currentDanceRawTableV2[m] = content end
                            end
                        end
                    end
                end
            end)
        end
        table.clear(Fun.danceListV2)
        for k in pairs(Fun.currentDanceRawTableV2) do table.insert(Fun.danceListV2, k) end
