do
    local hasHook = (hookmetamethod ~= nil) and (newcclosure ~= nil) and (getnamecallmethod ~= nil) and pcall(function() local o; o = hookmetamethod(game, "__namecall", newcclosure(function(s, ...) return o(s, ...) end)) end)
