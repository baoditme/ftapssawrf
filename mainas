-- Silent aim (conditional on hook)
if hookSupported then
    local ps = LocalPlayer:FindFirstChild("PlayerScripts")
    local rayMod = ps and ps:FindFirstChild("RaycastModule")
    if rayMod then
        local ok2, mod = pcall(require, rayMod)
        if ok2 and mod and mod.RaycastFromCam then
            local sa = { enabled = false, distance = 41, part = "Head" }
            local orig = mod.RaycastFromCam
            function mod.RaycastFromCam(p1, p2)
                if not sa.enabled then return orig(p1, p2) end
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return orig(p1, p2) end
                local best, bestD = nil, math.huge
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and not isWhitelisted(p) then
                        local tPart = p.Character:FindFirstChild(sa.part) or p.Character:FindFirstChild("Head")
                        local tHum  = p.Character:FindFirstChildOfClass("Humanoid")
                        if tPart and tHum and tHum.Health > 0 then
                            local d = (hrp.Position - tPart.Position).Magnitude
                            if d <= sa.distance and d < bestD then
                                bestD = d best = tPart
                            end
                        end
                    end
                end
                if best then
                    local obj = {
                        Instance = best, Position = best.Position,
                        Normal = Vector3.new(0, 1, 0), Material = Enum.Material.Plastic,
                    }
                    return obj, best.CFrame:ToObjectSpace(CFrame.new(best.Position))
                end
                return orig(p1, p2)
            end

            GrabTab:CreateSection("Silent Aim")
            GrabTab:CreateDropdown({
                Name = "Silent Part",
                Options = { "Head", "HumanoidRootPart", "Torso" },
                Default = "Head",
                Callback = function(v) sa.part = v end,
            })
            GrabTab:CreateToggle({
                Name = "Silent Aim",
                Default = false,
                Callback = function(on) sa.enabled = on end,
            })
            GrabTab:CreateSlider({
                Name = "Silent Distance",
                Default = 41, Min = 10, Max = 150,
                Callback = function(v) sa.distance = v end,
            })
        end
    end
else
    print("[RYZE FTAP] Silent aim hidden — no hook support")
end

-- Helpers
local function _grabIsActive(part)
    if not part or not part.Parent then return false end
    local gp = Workspace:FindFirstChild("GrabParts")
    if not gp then return false end
    local grabPart = gp:FindFirstChild("GrabPart")
    if not grabPart then return false end
    local weld = grabPart:FindFirstChild("WeldConstraint")
    return weld ~= nil and weld.Part1 == part
end

local function _getGrabbedPart()
    local gp = Workspace:FindFirstChild("GrabParts")
    if not gp then return nil end
    local grabPart = gp:FindFirstChild("GrabPart")
    if not grabPart then return nil end
    for _, c in ipairs(grabPart:GetChildren()) do
        if c:IsA("WeldConstraint") and c.Part1 and c.Part1:IsA("BasePart") then
            return c.Part1
        end
    end
    return nil
end

local function _getGrabModel(gp)
    local grabPart = gp and gp:FindFirstChild("GrabPart")
    local weld = grabPart and grabPart:FindFirstChild("WeldConstraint")
    return grabPart, weld, weld and weld.Part1
end

local function _release(part)
    if part and destroyGrabLine then
        pcall(function() destroyGrabLine:FireServer(part) end)
    end
end

local function _skyVelocity(part)
    if not part then return end
    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.new(0, 1e14, 0)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Parent = part
    Debris:AddItem(bv, 0.25)
end

