function BreakObject(objectName)
    task.spawn(function()
        local mapObjects = workspace_.Map.AlwaysHereTweenedObjects
        local sel = mapObjects:FindFirstChild(objectName)
        if not sel then Notify("Break Object", objectName .. " not found", "kick", 3) return end
        local object = sel:FindFirstChild("Object")
        if not object then Notify("Break Object", "Object empty", "kick", 3) return end
        if object:FindFirstChild("FollowThisPart") then object.FollowThisPart:Destroy() end
        local objectModel = object:FindFirstChild("ObjectModel")
        if not objectModel then Notify("Break Object", "ObjectModel missing", "kick", 3) return end
        local char = localPlayer.Character
        local _, hrp, hum = GetHRH(char)
        if not hrp or not hum then return end
        local targetPart = nil
        for _, p in objectModel:GetChildren() do
            if (p:IsA("Part") or p:IsA("MeshPart")) and p.CanQuery then targetPart = p break end
        end
        if not targetPart then Notify("Break Object", "No part", "kick", 3) return end
        local origCF = hrp.CFrame
        local startTick = tick()
        local owned = nil
        while true do
            task.wait()
            Teleport(hrp, targetPart.CFrame, CFrame.new(0, 0, 0))
            owned = Ownerboat(targetPart)
            if not hum or hum.Health <= 0 or not hrp or not targetPart or (hrp.Position - targetPart.Position).Magnitude > 20 or tick() - startTick > 3 or owned then break end
        end
        if not owned then Teleport(hrp, origCF, CFrame.new(0, 0, 0)) return end
        Teleport(hrp, origCF, CFrame.new(0, 0, 0))
        while true do
            local existing = 0
            for _, toy in toysFolder:GetChildren() do
                if toy.Name == "BreakObjectShurikens" then existing += 1 end
            end
            if existing >= 10 then break end
            SpawnShuriken("BreakObjectShurikens")
            task.wait(0.05)
        end
        for _, toy in toysFolder:GetChildren() do
            if toy.Name == "BreakObjectShurikens" then
                local sp = toy:FindFirstChild("StickyPart")
                if sp then
                    pcall(function() stickyPartEvent:FireServer(sp, targetPart, CFrame.new(0, 0, 0)) end)
                end
            end
        end
        state.session.track_break()
Notify("Break Object", "Broke " .. objectName, "success", 3)
    end)
