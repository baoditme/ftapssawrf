            or m:FindFirstChild("Handle") or m:FindFirstChildWhichIsA("BasePart")
    end
    local function claimMove(part, cf)
        pcall(function()
            setNetworkOwner:FireServer(part, part.CFrame); task.wait(0.05)
            part.CFrame = cf
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            setNetworkOwner:FireServer(part, cf)
        end)
    end

    local function stopShield()
        _G.ShieldActive = false
        for _, c in ipairs(shieldConns) do pcall(function() c:Disconnect() end) end
        shieldConns, shieldParts = {}, {}
    end

    local function startShield()
        stopShield(); _G.ShieldActive = true
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local folder = workspace_:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        if not folder then return end
        for _, c in ipairs(folder:GetChildren()) do
            if c.Name == "GlassBoxGray" or c.Name == "PalletLightBrown" or c.Name == "BombMissile" then
                pcall(function() destroyToyRemote:FireServer(c) end); task.wait(0.05)
            end
