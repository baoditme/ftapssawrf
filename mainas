-- ---------- DELETE LIMBS (R6: Torso / Left Arm / ...) ----------
state.limbWhich = "All"

local LIMB_SETS = {
    Arms = {"Left Arm", "Right Arm"},
    Legs = {"Left Leg", "Right Leg"},
    All  = {"Left Arm", "Right Arm", "Left Leg", "Right Leg"},
}

function DeleteLimbsOf(char, which)
    local torso = char and char:FindFirstChild("Torso")
    if not torso then
        Notify("Limbs", "target must be r6", "warning", 2) return
    end
    local cf = torso.CFrame
    workspace_.FallenPartsDestroyHeight = -100
    pcall(Ownerboat, torso)
    for _, n in ipairs(LIMB_SETS[which] or LIMB_SETS.All) do
        local l = char:FindFirstChild(n)
        if l then
            pcall(Ownerboat, l)
            l.CFrame = CFrame.new(0, -1000, 0)
        end
    end
    task.wait(0.1)
    torso.CFrame = CFrame.new(0, -1000, 0)
    task.wait()
    torso.CFrame = cf
    task.wait(0.1)
    if state.antiVoid then workspace_.FallenPartsDestroyHeight = (0 / 0) end
end

-- Xóa chi của người đang bị mình grab (logic gốc: phải đang ragdoll)
function DeleteGrabbedLimbs()
    local gp = workspace_:FindFirstChild("GrabParts")
    local weld = gp and gp:FindFirstChild("GrabPart") and gp.GrabPart:FindFirstChild("WeldConstraint")
    local part1 = weld and weld.Part1
    local char = part1 and part1.Parent
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum then
        Notify("Limbs", "grab one first", "warning", 2) return
    end
    local rag = hum:FindFirstChild("Ragdolled")
    if rag and not rag.Value then
        Notify("Limbs", "target not ragdoll yet", "warning", 2) return
    end
    DeleteLimbsOf(char, state.limbWhich)
end

-- Xóa chi của người dưới con trỏ chuột
function DeleteMouseLimbs()
    local t = localMouse.Target
    local model = t and t:FindFirstAncestorOfClass("Model")
    local p = model and players:GetPlayerFromCharacter(model)
    if not p or p == localPlayer then
        Notify("Limbs", "move cursor to 1 player", "warning", 2) return
    end
    if state.isWL and state.isWL(p) then
        Notify("Limbs", p.Name .. " in whitelist", "info", 2) return
    end
    DeleteLimbsOf(model, state.limbWhich)
end





