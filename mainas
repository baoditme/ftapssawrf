-- Ownership Kick (4 modes, faithful from xocu)
-- ============================================================
KickTab:CreateSection("Ownership Kick")

KickTab:CreateDropdown({ Name = "Ownership Mode", Options = {
    "Ownership Kick (80+ fps)", "Ownership Kick fast", "Ownership Kick For Exploiter", "UPGRADED Ownership Kick"
}, Default = "Ownership Kick (80+ fps)", Callback = function(v) _K.settings.ownershipMode = v end })

KickTab:CreateToggle({ Name = "Enable Ownership Kick", Default = false, Callback = function(v)
    if not v then
        _K.settings.ownershipActive = false
        if _K.state.ownershipTask then pcall(function() task.cancel(_K.state.ownershipTask) end) _K.state.ownershipTask = nil end
        for _, c in ipairs(_K.state.ownershipConns) do pcall(function() c:Disconnect() end) end
        _K.state.ownershipConns = {}
        local mr = _K_lr()
        if mr then mr.Anchored = false mr.AssemblyLinearVelocity = Vector3.zero mr.AssemblyAngularVelocity = Vector3.zero end
        return
    end
    if not _K.target then Notify("Kick", "Select target first", "warning") return end
    _K.settings.ownershipActive = true
    local mode = _K.settings.ownershipMode
    local targetName = _K.target
    _K.state.ownershipTask = task.spawn(function()
        local GE = ReplicatedStorage:WaitForChild("GrabEvents")
        local SetNetOwner = GE:WaitForChild("SetNetworkOwner")
        local DestroyGrabLine = GE:WaitForChild("DestroyGrabLine")
        local ZERO = Vector3.zero
        local function getT() return Players:FindFirstChild(targetName) end
        local function alive(p)
            if not p or not p.Parent then return false end
            local c = p.Character
            if not c then return false end
            local h = c:FindFirstChildOfClass("Humanoid")
            local r = c:FindFirstChild("HumanoidRootPart")
            return h and r and h.Health > 0
        end
        if mode == "Ownership Kick (80+ fps)" then
            local myRoot = _K_lr()
            if not myRoot then _K.settings.ownershipActive = false return end
            local savedPos = myRoot.CFrame
            local dragging = false grabStart = 0 checkStart = 0
            local fps = 60
            local fpsConn = RunService.RenderStepped:Connect(function(dt) if dt > 0 then fps = 1/dt end end)
            table.insert(_K.state.ownershipConns, fpsConn)
            local bp, bg = nil, nil
            local function cleanB()
                if bp then bp:Destroy() bp = nil end
                if bg then bg:Destroy() bg = nil end
            end
            local function makeB(tRoot, pos)
                cleanB()
                for _, v in pairs(tRoot:GetChildren()) do if v:IsA("BodyPosition") or v:IsA("BodyGyro") then v:Destroy() end end
                bp = Instance.new("BodyPosition") bp.MaxForce = Vector3.new(9e9, 9e9, 9e9) bp.D = 100 bp.Position = pos bp.Parent = tRoot
                bg = Instance.new("BodyGyro") bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9) bg.D = 100 bg.CFrame = CFrame.new(pos) bg.Parent = tRoot
            end
            while _K.settings.ownershipActive do
                local tgt = getT()
                myRoot = _K_lr()
                if not myRoot then RunService.Heartbeat:Wait() continue end
                if not alive(tgt) then dragging = false grabStart = 0 checkStart = 0 cleanB() myRoot.CFrame = savedPos RunService.Heartbeat:Wait() continue end
                local tChar = tgt.Character
                local tRoot = tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar:FindFirstChildOfClass("Humanoid")
                if not tRoot or not tHum then RunService.Heartbeat:Wait() continue end
                if not dragging then
                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                    myRoot.AssemblyLinearVelocity = ZERO myRoot.AssemblyAngularVelocity = ZERO
                    if grabStart == 0 then grabStart = tick() end
                    if tick() - grabStart > 0.08 then
                        dragging = true checkStart = tick()
                        local lockPos = savedPos * CFrame.new(5, 20, 4)
                        makeB(tRoot, lockPos.Position)
                    end
                else
                    myRoot.CFrame = savedPos
                    local lockPos = savedPos * CFrame.new(5, 20, 4)
                    myRoot.AssemblyLinearVelocity = ZERO myRoot.AssemblyAngularVelocity = ZERO
                    if bp and bp.Parent then bp.Position = lockPos.Position if bg then bg.CFrame = lockPos end else makeB(tRoot, lockPos.Position) end
                    tHum.PlatformStand = true
                    pcall(function()
                        local n = 2
                        if fps < 155 then n = 4 elseif fps <= 200 then n = 3 end
                        for _ = 1, n do SetNetOwner:FireServer(tRoot, lockPos) end
                        DestroyGrabLine:FireServer(tRoot)
                    end)
                    if checkStart > 0 and tick() - checkStart > 0.15 then
                        if (tRoot.Position - lockPos.Position).Magnitude > 10 then
                            dragging = false grabStart = 0 checkStart = 0 cleanB() myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        else checkStart = tick() end
                    end
                end
                RunService.Heartbeat:Wait()
            end
            cleanB()
            if myRoot then myRoot.CFrame = savedPos end
        elseif mode == "Ownership Kick fast" then
            while _K.settings.ownershipActive do
                local tgt = getT()
                local myRoot = _K_lr()
                if not myRoot or not alive(tgt) then RunService.Heartbeat:Wait() continue end
                local tRoot = tgt.Character:FindFirstChild("HumanoidRootPart")
                local tHum = tgt.Character:FindFirstChildOfClass("Humanoid")
                if tRoot and tHum then
                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, -5, -8)
                    tHum.PlatformStand = true
                    pcall(function()
                        for _ = 1, 3 do SetNetOwner:FireServer(tRoot, tRoot.CFrame * CFrame.new(0, 40, 0)) end
                        DestroyGrabLine:FireServer(tRoot)
                    end)
                    tRoot.AssemblyLinearVelocity = Vector3.new(0, 250, 0)
                end
                RunService.Heartbeat:Wait()
            end
        elseif mode == "Ownership Kick For Exploiter" then
            while _K.settings.ownershipActive do
                local tgt = getT()
                local myRoot = _K_lr()
                if not myRoot or not alive(tgt) then task.wait(0.05) continue end
                local tChar = tgt.Character
                local tRoot = tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar:FindFirstChildOfClass("Humanoid")
                if tRoot and tHum then
                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, -6, -10)
                    myRoot.AssemblyLinearVelocity = ZERO
                    tHum.PlatformStand = true tHum.Sit = false
                    for _, n in ipairs({ "Left Leg", "Right Leg", "Left Arm", "Right Arm", "Head", "Torso", "UpperTorso", "LowerTorso" }) do
                        local p = tChar:FindFirstChild(n)
                        if p then p.AssemblyLinearVelocity = ZERO p.CanCollide = false end
                    end
                    pcall(function()
                        for _ = 1, 5 do SetNetOwner:FireServer(tRoot, CFrame.new(0, 1e6, 0)) end
                        DestroyGrabLine:FireServer(tRoot)
                    end)
                end
                RunService.Heartbeat:Wait()
            end
        else
            local myRoot = _K_lr()
            local savedPos = myRoot and myRoot.CFrame or CFrame.new()
            local dragging = false grabStart = 0 checkStart = 0
            local bp, bg = nil, nil
            local function cleanB() if bp then bp:Destroy() bp = nil end if bg then bg:Destroy() bg = nil end end
            local function makeB(tRoot, pos)
                cleanB()
                bp = Instance.new("BodyPosition") bp.MaxForce = Vector3.new(9e9, 9e9, 9e9) bp.D = 80 bp.Position = pos bp.Parent = tRoot
                bg = Instance.new("BodyGyro") bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9) bg.CFrame = CFrame.new(pos) bg.Parent = tRoot
            end
            while _K.settings.ownershipActive do
                local tgt = getT()
                myRoot = _K_lr()
                if not myRoot or not alive(tgt) then dragging = false cleanB() RunService.Heartbeat:Wait() continue end
                local tRoot = tgt.Character:FindFirstChild("HumanoidRootPart")
                local tHum = tgt.Character:FindFirstChildOfClass("Humanoid")
                if not tRoot or not tHum then RunService.Heartbeat:Wait() continue end
                if not dragging then
                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                    if grabStart == 0 then grabStart = tick() end
                    if tick() - grabStart > 0.06 then
                        dragging = true checkStart = tick()
                        makeB(tRoot, (savedPos * CFrame.new(5, 25, 4)).Position)
                    end
                else
                    myRoot.CFrame = savedPos
                    local lockPos = savedPos * CFrame.new(5, 25, 4)
                    if bp and bp.Parent then bp.Position = lockPos.Position if bg then bg.CFrame = lockPos end else makeB(tRoot, lockPos.Position) end
                    tHum.PlatformStand = true
                    pcall(function()
                        for _ = 1, 4 do SetNetOwner:FireServer(tRoot, lockPos) end
                        DestroyGrabLine:FireServer(tRoot)
                    end)
                    if checkStart > 0 and tick() - checkStart > 0.2 then
                        if (tRoot.Position - lockPos.Position).Magnitude > 15 then
                            dragging = false grabStart = 0 checkStart = 0 cleanB() myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        else checkStart = tick() end
                    end
                end
                RunService.Heartbeat:Wait()
            end
            cleanB()
            if myRoot then myRoot.CFrame = savedPos end
        end
    end)
end })

