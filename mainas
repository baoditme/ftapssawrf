            end
        end
        _gkaTargets = targets
        _gkaBodyPositions = {}
        for i, t in ipairs(targets) do
            if t.hrp and t.hrp.Parent then
                local angle = 6.2831853071795862 / n * (i - 1)
                local x = math.cos(angle) * circleRadius
                local z = math.sin(angle) * circleRadius
                pcall(function()
                    t.hrp.CFrame = CFrame.new(x, centerY, z)
                    t.hrp.AssemblyLinearVelocity = Vector3.zero
                end)
                local bp = Instance.new("BodyPosition")
                bp.MaxForce = Vector3.new(4e9, 5e9, 4e9)
                bp.P = 100000000
                bp.D = 10000
                bp.Position = Vector3.new(x, centerY, z)
                bp.Parent = t.hrp
                table.insert(_gkaBodyPositions, bp)
            end
        end
        task.delay(8, function()
            for _, bp in ipairs(_gkaBodyPositions) do pcall(function() bp:Destroy() end) end
        end)
        _gkaBlobAngle = 0
        local lastSitCheck = 0
        local lastLineCheck = 0
        local blobOrbitSpeed = 4
        _gkaConn = runService.RenderStepped:Connect(function(dt)
            if not _gkaActive then
                pcall(function() _gkaConn:Disconnect() end)
                _gkaConn = nil return
            end
            if not blob or not blob.Parent then return end
            lastSitCheck -= dt
            if lastSitCheck <= 0 then
                lastSitCheck = 0.5
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not (hum and hum.SeatPart) then
                    task.spawn(function() _RYZE_sitOnBlobman(blob) end)
                end
            end
            lastLineCheck -= dt
            if lastLineCheck <= 0 then
                lastLineCheck = 3
                local anyAlive = false
                for _, t in ipairs(_gkaTargets) do
                    if t.player and t.player.Parent then anyAlive = true break end
                end
                if not anyAlive then
                    Notify("Gather Kick All", "All targets gone, stopping.", "info", 3)
                    task.spawn(StopGatherKickAll) return
                end
                state.lineLagRunning = false
                StartLineLag()
            end
            _gkaBlobAngle += blobOrbitSpeed * dt
            local bx = math.cos(_gkaBlobAngle) * blobOrbitRadius
            local bz = math.sin(_gkaBlobAngle) * blobOrbitRadius
            local bHrp = blob:FindFirstChild("HumanoidRootPart") or blob:FindFirstChildWhichIsA("BasePart", true)
            if bHrp then
                pcall(function()
                    bHrp.AssemblyLinearVelocity = (Vector3.new(bx, centerY + 2, bz) - bHrp.Position) * 60
                    bHrp.CFrame = CFrame.new(bHrp.Position) * CFrame.Angles(0, -(_gkaBlobAngle + 1.5707963267948966), 0)
                end)
            end
            local tn = #_gkaTargets
            if tn > 0 then
                local rt = _gkaTargets[math.random(1, tn)]
                if rt and rt.hrp and rt.hrp.Parent then
                    task.spawn(function() _gkaGrab(blob, rt.hrp) end)
