                end
                pcall(function()
                    if btn and btn.Parent then setNetworkOwner:FireServer(btn, targetPart.CFrame) end
                    setNetworkOwner:FireServer(slot.part, targetPart.CFrame)
                    slot.part.CFrame = targetPart.CFrame
                    slot.part.AssemblyLinearVelocity = Vector3.zero
                    slot.part.AssemblyAngularVelocity = Vector3.zero
                end)
            end)
        end)
    end

    local function getFreeBomb()
        local list = {}
        for _, s in ipairs(shieldParts) do
            if s.index >= 3 and not s.launched then table.insert(list, s) end
        end
        return #list > 0 and list[math.random(1, #list)] or nil
    end

    makeSection(funTab, "Shield & Missile")
    makeSlider(funTab, "Shield Height Offset", -4, -20, 20, function(v) shieldHeight = v end)
    makeToggle(funTab, "Shield ON/OFF", false, function(on)
