-- ---------- FLIPS ----------
local flipping = false
function Flip(dir) -- dir = -1: front flip, +1: back flip
    if flipping then return end
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum and hum.Health > 0) then return end
    flipping = true
    hum:ChangeState(Enum.HumanoidStateType.Jumping)
    task.wait(0.05)
    local t0, last, dur = tick(), 0, 0.55
    local conn
    conn = runService.RenderStepped:Connect(function()
        if not hrp.Parent then conn:Disconnect() flipping = false return end
        local a = math.min((tick() - t0) / dur, 1)
        local ang = a * math.pi * 2 * dir
        hrp.CFrame = hrp.CFrame * CFrame.Angles(ang - last, 0, 0)
        last = ang
        if a >= 1 then conn:Disconnect() flipping = false end
    end)
end

userInputService.InputBegan:Connect(function(input, gp)
    if gp or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == Enum.KeyCode.F then Flip(-1)
    elseif input.KeyCode == Enum.KeyCode.G then Flip(1) end
end)

