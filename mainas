        local LW = L and L:FindFirstChild("LeftWeld")
        local scr = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
        local cd = scr and scr:FindFirstChild("CreatureDrop")
        if not (LW and cd) then return end
        pcall(function() cd:FireServer(LW, tHrp) end)
    end

    local function bringOne(blob, player)
        local char = localPlayer.Character
        local myHrp = char and char:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        local tChar = player.Character
        local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not (tHrp and tHum and tHum.Health > 0) then return end

